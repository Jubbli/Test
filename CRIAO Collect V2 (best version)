--==================================================

local function restorePlayer()
	updateCharacter()

	if Root and OriginalCFrame then
		Root.CFrame = OriginalCFrame
	end

	OriginalCFrame = nil
end

--==================================================
-- COLLECT SELECTED ITEM
--==================================================

local function collectSelectedItem()
	if Collecting then
		return
	end

	if not SelectedItem then
		Status.Text = "SELECT AN ITEM FIRST"
		return
	end

	if not SelectedItem.Parent then
		Status.Text = "SELECTED ITEM NO LONGER EXISTS"
		rebuildObjects()
		rebuildItemList()
		return
	end

	updateCharacter()

	if not Root then
		Status.Text = "CHARACTER NOT READY"
		return
	end

	Collecting = true
	OriginalCFrame = Root.CFrame

	startNoclip()

	Status.Text = "COLLECTING  •  " .. SelectedItem.Name

	local success = collectObject(SelectedItem)

	stopNoclip()
	restorePlayer()

	if success then
		Status.Text = "COLLECTED  •  " .. SelectedItem.Name
	else
		Status.Text = "PICKUP FAILED  •  " .. SelectedItem.Name
	end

	Collecting = false

	rebuildObjects()
	rebuildItemList()
end

--==================================================
-- AUTO RARITY COLLECTOR
--==================================================

local function getAutoTargets()
	local targets = {}

	for object, info in pairs(LiveObjects) do
		if object
			and object.Parent
			and info
			and info.Rarity == SelectedRarity then

			table.insert(targets, object)
		end
	end

	table.sort(targets, function(a, b)
		local aPos = getPosition(a)
		local bPos = getPosition(b)

		if not aPos then
			return false
		end

		if not bPos then
			return true
		end

		if not Root then
			return a.Name < b.Name
		end

		return (aPos - Root.Position).Magnitude
			< (bPos - Root.Position).Magnitude
	end)

	return targets
end

local function autoCollectCycle()
	if Collecting then
		return
	end

	updateCharacter()

	if not Root then
		return
	end

	local targets = getAutoTargets()

	if #targets == 0 then
		Status.Text =
			"AUTO  •  NO "
			.. SelectedRarity
			.. " OBJECTS"
		return
	end

	Collecting = true

	if not OriginalCFrame then
		OriginalCFrame = Root.CFrame
	end

	startNoclip()

	local collected = 0

	for _, object in ipairs(targets) do
		if not AutoEnabled then
			break
		end

		if object and object.Parent then
			local success = collectObject(object)

			if success then
				collected += 1
			end
		end

		Status.Text =
			"AUTO  •  "
			.. SelectedRarity
			.. "  •  "
			.. tostring(collected)
			.. "/"
			.. tostring(#targets)

		RunService.Heartbeat:Wait()
	end

	Collecting = false

	-- AUTO stays at the current collection area while running.
	-- Position is restored only after AUTO is switched OFF.
	if not AutoEnabled then
		stopNoclip()
		restorePlayer()
	end
end

