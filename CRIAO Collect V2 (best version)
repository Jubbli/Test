--==================================================

local SpawnedObjects = workspace:FindFirstChild("SpawnedObjects")

local function registerObject(object)
	if not object or not object.Parent then
		return
	end

	local rarity = getRarity(object)

	if rarity then
		LiveObjects[object] = {
			Object = object,
			Rarity = rarity,
			LastAttempt = 0,
		}
	else
		LiveObjects[object] = nil
	end
end

local function rebuildObjects()
	table.clear(LiveObjects)

	SpawnedObjects = workspace:FindFirstChild("SpawnedObjects")

	if not SpawnedObjects then
		Status.Text = "SpawnedObjects NOT FOUND"
		return
	end

	for _, object in ipairs(SpawnedObjects:GetChildren()) do
		registerObject(object)
	end

	Status.Text = "READY  •  OBJECT CACHE REFRESHED"
end

rebuildObjects()

local AddedConnection
local RemovedConnection

local function connectObjectFolder()
	if AddedConnection then
		AddedConnection:Disconnect()
	end

	if RemovedConnection then
		RemovedConnection:Disconnect()
	end

	if not SpawnedObjects then
		return
	end

	AddedConnection = SpawnedObjects.ChildAdded:Connect(function(object)
		task.defer(function()
			registerObject(object)
		end)
	end)

	RemovedConnection = SpawnedObjects.ChildRemoved:Connect(function(object)
		LiveObjects[object] = nil

		if SelectedItem == object then
			SelectedItem = nil
		end
	end)
end

connectObjectFolder()

workspace.ChildAdded:Connect(function(child)
	if child.Name == "SpawnedObjects" then
		SpawnedObjects = child
		rebuildObjects()
		connectObjectFolder()
	end
end)

