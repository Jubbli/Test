--==================================================

local NoclipConnection

local function startNoclip()
	if NoclipConnection then
		NoclipConnection:Disconnect()
	end

	NoclipConnection = RunService.Stepped:Connect(function()
		if not Collecting then
			return
		end

		if not Character then
			return
		end

		for _, part in ipairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end)
end

local function stopNoclip()
	if NoclipConnection then
		NoclipConnection:Disconnect()
		NoclipConnection = nil
	end

	if Character then
		for _, part in ipairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
	end
end

--==================================================
-- TEMP HITBOX
--==================================================

local OriginalSizes = {}

local function expandHitbox(object)
	table.clear(OriginalSizes)

	if not object or not object.Parent then
		return
	end

	for _, part in ipairs(object:GetDescendants()) do
		if part:IsA("BasePart") then
			OriginalSizes[part] = part.Size

			part.Size = part.Size * CONFIG.HitboxMultiplier
		end
	end

	if object:IsA("BasePart") then
		OriginalSizes[object] = object.Size
		object.Size = object.Size * CONFIG.HitboxMultiplier
	end
end

local function restoreHitbox()
	for part, size in pairs(OriginalSizes) do
		if part and part.Parent then
			pcall(function()
				part.Size = size
			end)
		end
	end

	table.clear(OriginalSizes)
end

--==================================================
-- FAST MOVEMENT
--==================================================

local function moveTo(cframe)
	updateCharacter()

	if not Root then
		return false
	end

	local tween = TweenService:Create(
		Root,
		TweenInfo.new(
			CONFIG.MoveTime,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.Out
		),
		{
			CFrame = cframe
		}
	)

	tween:Play()
	tween.Completed:Wait()

	return Root and Root.Parent ~= nil
end

--==================================================
-- PICKUP
--==================================================

local function invokePickup(object)
	if not PickupRemote then
		return false
	end

	if not object or not object.Parent then
		return true
	end

	local success, result = pcall(function()
		return PickupRemote:InvokeServer(object)
	end)

	if not success then
		return false
	end

	return result ~= false
end

--==================================================
-- COLLECT ONE OBJECT
--==================================================

local function collectObject(object)
	if not object or not object.Parent then
		return true
	end

	updateCharacter()

	if not Root then
		return false
	end

	local objectPosition = getPosition(object)

	if not objectPosition then
		return false
	end

	expandHitbox(object)

	local underground =
		objectPosition
		- Vector3.new(0, CONFIG.UnderMapOffset, 0)

	local probes = {
		Vector3.new(0, 0, 0),
		Vector3.new(0, 3, 0),
		Vector3.new(0, -3, 0),
		Vector3.new(3, 0, 0),
		Vector3.new(-3, 0, 0),
	}

	local collected = false

	for _, offset in ipairs(probes) do
		if not object.Parent then
			collected = true
			break
		end

		local position = underground + offset

		local targetCFrame = CFrame.lookAt(
			position,
			objectPosition
		)

		if not moveTo(targetCFrame) then
			break
		end

		task.wait(CONFIG.PickupDelay)

		if invokePickup(object) then
			collected = true
			break
		end
	end

	restoreHitbox()

	return collected
end

--==================================================
