--==================================================
-- HELPERS
--==================================================

local function normalizeRarity(value)
	if typeof(value) ~= "string" then
		return nil
	end

	local cleaned = value
		:gsub("%s+", "")
		:gsub("_", "")
		:lower()

	if cleaned == "relics" then
		cleaned = "relic"
	end

	return RarityLookup[cleaned]
end

local function getPosition(object)
	if not object or not object.Parent then
		return nil
	end

	if object:IsA("BasePart") then
		return object.Position
	end

	if object:IsA("Model") then
		return object:GetPivot().Position
	end

	local part = object:FindFirstChildWhichIsA("BasePart", true)

	return part and part.Position
end

--==================================================
-- INDEX SCANNER
--==================================================

local function registerSection(section)
	if not section then
		return
	end

	local rarity = normalizeRarity(
		section.Name:gsub("^Section_", "")
	)

	if not rarity then
		return
	end

	for _, descendant in ipairs(section:GetDescendants()) do
		if descendant.Name:sub(1, 5) == "Slot_" then
			local itemName = descendant.Name:sub(6)

			if itemName ~= "" then
				IndexRarity[itemName] = rarity
			end

			for _, uiObject in ipairs(descendant:GetDescendants()) do
				if uiObject:IsA("TextLabel")
					or uiObject:IsA("TextButton") then

					local textValue = uiObject.Text

					if typeof(textValue) == "string"
						and textValue ~= ""
						and #textValue < 100 then

						IndexRarity[textValue] = rarity
					end
				end
			end
		end
	end
end

local function scanIndex(root)
	if not root then
		return
	end

	for _, descendant in ipairs(root:GetDescendants()) do
		if descendant.Name:match("^Section_") then
			registerSection(descendant)
		end
	end
end

local function rebuildIndex()
	table.clear(IndexRarity)

	scanIndex(PlayerGui)

	print("[C.R.I.A.O] Index rebuilt:", #IndexRarity)
end

rebuildIndex()

--==================================================
-- RARITY DETECTION
--==================================================

local function getAttributeRarity(object)
	local names = {
		"Rarity",
		"RarityName",
		"RarityType",
		"ObjectRarity",
		"IndexRarity",
		"Tier",
		"TierName",
		"ClaimTier",
	}

	for _, attributeName in ipairs(names) do
		local value = object:GetAttribute(attributeName)

		local rarity = normalizeRarity(value)

		if rarity then
			return rarity
		end
	end

	return nil
end

local function getValueRarity(object)
	local names = {
		"Rarity",
		"RarityName",
		"RarityType",
		"ObjectRarity",
		"Tier",
		"TierName",
	}

	for _, name in ipairs(names) do
		local valueObject = object:FindFirstChild(name, true)

		if valueObject then
			local value

			pcall(function()
				value = valueObject.Value
			end)

			local rarity = normalizeRarity(value)

			if rarity then
				return rarity
			end
		end
	end

	return nil
end

local function getRarity(object)
	if not object then
		return nil
	end

	local rarity = getAttributeRarity(object)

	if rarity then
		return rarity
	end

	rarity = getValueRarity(object)

	if rarity then
		return rarity
	end

	rarity = IndexRarity[object.Name]

	if rarity then
		return rarity
	end

	local stripped = object.Name
	stripped = stripped:gsub("^Object_", "")
	stripped = stripped:gsub("^Spawned_", "")
	stripped = stripped:gsub("^Item_", "")

	rarity = IndexRarity[stripped]

	if rarity then
		return rarity
	end

	return nil
end

