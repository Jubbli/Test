-- Localized bundle unpacking logic via InsertService configuration structures
unpackButton.MouseButton1Click:Connect(function()
	local targetBundleId = tonumber(bundleIdInput.Text)

	if not targetBundleId then
		bundleIdInput.Text = "Invalid!"
		task.wait(1)
		bundleIdInput.Text = ""
		return
	end

	unpackButton.Text = "Extracting..."
	unpackButton.Active = false

	-- Clear past rows from unpacking dashboard feed
	for _, child in ipairs(unpackScrollFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	-- Note: InsertService:LoadAsset requires ownership rights or specific Studio runtime settings.
	-- We pull configurations based on structural descendants found within asset descriptions.
	local success, assetModel = pcall(function()
		return InsertService:LoadAsset(targetBundleId)
	end)

	local foundAnims = false

	if success and assetModel then
		for _, descendant in ipairs(assetModel:GetDescendants()) do
			if descendant:IsA("Animation") then
				foundAnims = true
				buildCopyRow(
					descendant.Name,
					descendant.AnimationId,
					unpackScrollFrame
				)
			end
		end

		assetModel:Destroy()
	end

	-- Fallback structural search utilizing description lookups if direct model unpacking isn't cleared
	if not foundAnims then
		local s, desc = pcall(function()
			return Players:GetHumanoidDescriptionFromOutfitId(targetBundleId)
		end)

		if s and desc then
			local properties = {
				"ClimbAnimation",
				"FallAnimation",
				"IdleAnimation",
				"JumpAnimation",
				"RunAnimation",
				"SwimAnimation",
				"WalkAnimation"
			}

			for _, prop in ipairs(properties) do
				pcall(function()
					local val = desc[prop]

					if val and val ~= 0 then
						foundAnims = true
						buildCopyRow(
							prop,
							"rbxassetid://" .. tostring(val),
							unpackScrollFrame
						)
					end
				end)
			end
		end
	end

	if not foundAnims then
		bundleIdInput.Text = "No Anims Found!"
		task.wait(1.5)
		bundleIdInput.Text = ""
	end

	unpackButton.Text = "Extract IDs"
	unpackButton.Active = true
end)

