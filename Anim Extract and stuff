-- Generic copy element builder
local function buildCopyRow(name, assetId, targetFrame)
	local rowBtn = Instance.new("TextButton")
	rowBtn.Size = UDim2.new(1, -5, 0, 32)
	rowBtn.Text = "  " .. name .. " \n  ID: " .. assetId
	rowBtn.TextXAlignment = Enum.TextXAlignment.Left
	rowBtn.TextColor3 = Color3.fromRGB(210, 210, 220)
	rowBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
	rowBtn.BackgroundTransparency = 0.3
		rowBtn.Font = Enum.Font.SourceSans
	rowBtn.TextSize = 13
	rowBtn.Parent = targetFrame

	local rc = Instance.new("UICorner")
	rc.CornerRadius = UDim.new(0, 4)
	rc.Parent = rowBtn

	rowBtn.MouseButton1Click:Connect(function()
		local numOnly = string.match(assetId, "%d+") or assetId
		LogService:RequestSetClipboard(numOnly)
		rowBtn.Text = "  COPIED TO CLIPBOARD!"
		rowBtn.TextColor3 = Color3.fromRGB(50, 255, 130)
		task.wait(0.8)
		rowBtn.TextColor3 = Color3.fromRGB(210, 210, 220)
		rowBtn.Text = "  " .. name .. " \n  ID: " .. assetId
	end)
end

-- Track intercept script with active UI visual state checking cutoff rules
local loggedMap = {}

local function linkAnimator(targetAnimator)
	targetAnimator.AnimationPlayed:Connect(function(track)
		-- Safety check: Hard stops writing data if panel is hidden or active tab switched
		if not isPanelOpen or activeTab ~= "Logger" then
			return
		end

		local anim = track.Animation

		if anim and anim.AnimationId then
			local pathId = anim.AnimationId

			if not loggedMap[pathId] then
				loggedMap[pathId] = true
				buildCopyRow(track.Name or "Unnamed", pathId, logScrollFrame)
			end
		end
	end)
end

linkAnimator(animator)

player.CharacterAdded:Connect(function(char)
	linkAnimator(char:WaitForChild("Humanoid"):WaitForChild("Animator"))
end)

