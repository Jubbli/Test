        CanvasSize             = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize    = Enum.AutomaticSize.Y,
    }, tpCard)
    ListLayout(3, tpScroll)

    local tpFeedback = New("TextLabel", {
        Text                   = "",
        Size                   = UDim2.new(1, -10, 0, 16),
        Position               = UDim2.new(0, 8, 1, -18),
        BackgroundTransparency = 1,
        TextColor3             = C.AccentBrt,
        Font                   = Enum.Font.Code,
        TextSize               = 9,
        TextXAlignment         = Enum.TextXAlignment.Left,
    }, tpCard)

    local function buildTpList()
        -- Clear existing rows
        for _, ch in ipairs(tpScroll:GetChildren()) do
            if ch:IsA("TextButton") or ch:IsA("Frame") then ch:Destroy() end
        end

        local myHRP = getHRP(getChar())

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == Player then continue end

            local pChar = plr.Character
            local pHRP  = getHRP(pChar)
            local dist  = "?"
            if pHRP and myHRP then
                dist = tostring(math.floor((pHRP.Position - myHRP.Position).Magnitude))
            end

            local row = New("TextButton", {
                Text             = "",
                Size             = UDim2.new(1, -6, 0, 30),
                BackgroundColor3 = C.Btn,
                BorderSizePixel  = 0,
            }, tpScroll)
            Corner(4, row)
            Stroke(C.Border, 0.4, row)

            New("TextLabel", {
                Text                   = plr.Name,
                Size                   = UDim2.new(0.6, 0, 1, 0),
                Position               = UDim2.new(0, 8, 0, 0),
                BackgroundTransparency = 1,
                TextColor3             = C.Text,
                Font                   = Enum.Font.GothamBold,
                TextSize               = 11,
                TextXAlignment         = Enum.TextXAlignment.Left,
            }, row)

            local distLbl = New("TextLabel", {
                Text                   = dist .. " studs",
                Size                   = UDim2.new(0.38, 0, 1, 0),
                Position               = UDim2.new(0.62, 0, 0, 0),
                BackgroundTransparency = 1,
                TextColor3             = C.TextDim,
                Font                   = Enum.Font.Code,
                TextSize               = 9,
                TextXAlignment         = Enum.TextXAlignment.Right,
            }, row)

            hoverBtn(row, C.Btn, C.BtnHov)

            local pName = plr.Name
            row.MouseButton1Click:Connect(function()
                local target = Players:FindFirstChild(pName)
                if not target then
                    tpFeedback.Text = pName .. " has left the server."
                    return
                end
                local tChar = target.Character
                local tHRP  = getHRP(tChar)
                local myChar = getChar()
                local myHRP2 = getHRP(myChar)
                if tHRP and myHRP2 then
                    -- Offset slightly so you don't clip inside them
                    myHRP2.CFrame = tHRP.CFrame * CFrame.new(0, 0, -3)
                    tpFeedback.Text = "Teleported to " .. pName .. "!"
                    TweenService:Create(tpFeedback,
                        TweenInfo.new(2, Enum.EasingStyle.Linear),
                        {TextTransparency = 1}
                    ):Play()
                    task.delay(2.1, function() tpFeedback.TextTransparency = 0 end)
                else
                    tpFeedback.Text = pName .. " has no character loaded."
                end
            end)
        end

        if #Players:GetPlayers() <= 1 then
            New("TextLabel", {
                Text                   = "No other players in server.",
                Size                   = UDim2.new(1, 0, 0, 30),
                BackgroundTransparency = 1,
                TextColor3             = C.TextDim,
                Font                   = Enum.Font.Gotham,
                TextSize               = 11,
                TextXAlignment         = Enum.TextXAlignment.Center,
            }, tpScroll)
        end
    end

    -- Refresh button
    local refreshBtn = New("TextButton", {
        Text             = "Refresh Player List",
        Size             = UDim2.new(1, -10, 0, 16),
        Position         = UDim2.new(0, 5, 0, 162),
        BackgroundColor3 = C.Accent,
        TextColor3       = Color3.new(1,1,1),
        Font             = Enum.Font.GothamBold,
        TextSize         = 9,
        BorderSizePixel  = 0,
    }, tpCard)
    Corner(4, refreshBtn)
    refreshBtn.MouseButton1Click:Connect(buildTpList)

    -- Build list on first open, and auto-refresh when players join/leave
    buildTpList()
    Players.PlayerAdded:Connect(buildTpList)
    Players.PlayerRemoving:Connect(function()
        task.wait(0.5)  -- brief wait so the player is fully removed first
        buildTpList()
    end)
end

