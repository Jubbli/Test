            Size=UDim2.new(0.55,0,1,0),
            BackgroundTransparency=1,
            TextColor3=C.TextDim, Font=Enum.Font.Gotham, TextSize=10,
            TextXAlignment=Enum.TextXAlignment.Left,
        }, row)
        local valLbl = New("TextLabel",{
            Text="0",
            Size=UDim2.new(0.45,0,1,0), Position=UDim2.new(0.55,0,0,0),
            BackgroundTransparency=1,
            TextColor3=C.AccentBrt, Font=Enum.Font.GothamBold, TextSize=10,
            TextXAlignment=Enum.TextXAlignment.Left,
        }, row)
        statLabels[sl.key] = {lbl=valLbl, fmt=sl.fmt}
    end

    local sessionTimeLbl = New("TextLabel",{
        Text="Session: 0m 0s",
        Size=UDim2.new(1,0,0,16),
        Position=UDim2.new(0,0,0,200),
        BackgroundTransparency=1,
        TextColor3=C.TextDim, Font=Enum.Font.Code, TextSize=9,
        TextXAlignment=Enum.TextXAlignment.Left,
    }, statFrame)

    local function updateStatDisplay()
        for key, info in pairs(statLabels) do
            local val = STATS[key] or 0
            if info.fmt then
                info.lbl.Text = string.format(info.fmt, val)
            else
                info.lbl.Text = tostring(val)
            end
        end
        local elapsed = tick() - STATS.SessionTime
        local mins = math.floor(elapsed / 60)
        local secs = math.floor(elapsed % 60)
        sessionTimeLbl.Text = string.format("Session: %dm %ds", mins, secs)
    end

    local lastStatTime = tick()
    RunService.Heartbeat:Connect(function(dt)
        if tick() - lastStatTime < 0.5 then return end
        lastStatTime = tick()
        pcall(function()
            local player = game:GetService("Players").LocalPlayer
            local char   = player.Character; if not char then return end
            local hrp    = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
            local hum    = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
            if STATS.LastPos then
                local moved = (hrp.Position - STATS.LastPos).Magnitude
                if moved < 100 then  -- sanity check (not a teleport)
                    STATS.DistanceTrav = STATS.DistanceTrav + moved
                    local speed = moved / 0.5  -- studs per second
                    if speed > STATS.TopSpeed then STATS.TopSpeed = speed end
                end
            end
            STATS.LastPos = hrp.Position
            updateStatDisplay()
        end)
    end)

    local Player = game:GetService("Players").LocalPlayer
    local function hookCharStats(char)
        local hum = char:WaitForChild("Humanoid", 5); if not hum then return end
        hum.Jumping:Connect(function()
            STATS.JumpCount = STATS.JumpCount + 1
        end)
        hum.Died:Connect(function()
            STATS.Deaths = STATS.Deaths + 1
            STATS.RespawnCount = STATS.RespawnCount + 1
        end)
    end
    if Player.Character then pcall(function() hookCharStats(Player.Character) end) end
    Player.CharacterAdded:Connect(function(c) pcall(function() hookCharStats(c) end) end)

    makeButton(scroll, "🔄  Reset All Statistics", function()
        for k, _ in pairs(STATS) do
            if type(STATS[k]) == "number" then STATS[k] = 0 end
        end
        STATS.SessionTime = tick()
        STATS.LastPos     = nil
        NT_toast("Statistics", "All stats reset", C.TextDim)
    end, 2)

    makeButton(scroll, "📋  Print Stats to Console", function()
        print("═══ NTG SESSION STATISTICS ═══")
        for k, v in pairs(STATS) do
            if type(v) == "number" then
                print(string.format("  %-20s %s", k..":", tostring(v)))
            end
        end
        print("═══════════════════════════════")
        NT_toast("Statistics", "Stats printed to output", C.AccentBrt)
    end, 3)

end) -- end safeTab Statistics

