-- TAB 9: DOORS  (Roblox DOORS — visual tools from GaelHubs port)
-- ════════════════════════════════════════════════════════════════
safeTab("Doors", function()
    local scroll = makeScrollFrame(TabFrames["Doors"])

    -- ── Shared state ─────────────────────────────────────────────
    local D = {
        doorsVisual     = false,
        seeEnemies      = false,
        entityHUD       = false,
        notifiedEnemies = {},
        alertedSideroom = false,
    }

    -- ════════════════════════════════════════════════════════════
    -- FEATURE 1: DOORS VISUAL
    -- Highlights doors, keys, chests, levers, gold piles and
    -- sideroom dupes with rainbow Highlight + distance billboard.
    -- Sideroom dupes get a red warning + proximity sound alert.
    -- ════════════════════════════════════════════════════════════
    makeSectionLabel(scroll, "DOORS VISUAL", 1)

    makeToggle(scroll, "Doors Visual",
        "Rainbow highlights + distance labels on all interactables",
        function(on)
            D.doorsVisual = on
            D.alertedSideroom = false
            if not on then
                -- Strip all highlights and billboards when turned off
                for _, obj in pairs(workspace:GetDescendants()) do
                    pcall(function()
                        local h = obj:FindFirstChild("HighlightVisual")
                        local b = obj:FindFirstChild("InfoBillboard")
                        if h then h:Destroy() end
                        if b then b:Destroy() end
                    end)
                end
            end
        end, 2)

    -- DoorsVisual heartbeat
    RunService.RenderStepped:Connect(function()
        if not D.doorsVisual then return end
        local myChar = getChar()
        local myHRP  = getHRP(myChar)

        for _, obj in pairs(workspace:GetDescendants()) do
            pcall(function()
                local isDoor     = obj:IsA("BasePart") and obj.Name:find("Door")
                local isKey      = obj.Name == "KeyObtain"
                local isChest    = obj.Name == "ChestBox"
                local isLever    = obj.Name == "LeverForGate"
                local isGold     = obj.Name == "GoldPile"
                local isSideroom = obj.Name == "SideroomDupe"

                if not (isDoor or isKey or isChest or isLever or isGold or isSideroom) then
                    return
                end

                local basePart = obj:IsA("BasePart") and obj
                    or obj:FindFirstChildWhichIsA("BasePart")
                if not basePart then return end

                -- Highlight
                local h = basePart:FindFirstChild("HighlightVisual")
                if not h then
                    h = Instance.new("Highlight")
                    h.Name                = "HighlightVisual"
                    h.Adornee             = basePart
                    h.FillTransparency    = 0.5
                    h.OutlineTransparency = 1
                    h.Parent              = basePart
                end
                h.FillColor = isSideroom
                    and Color3.fromRGB(255, 0, 0)
                    or  Color3.fromHSV(tick() % 5 / 5, 1, 1)

                -- Distance billboard
                local bill = basePart:FindFirstChild("InfoBillboard")
                if not bill then
                    bill = Instance.new("BillboardGui")
                    bill.Name          = "InfoBillboard"
                    bill.Size          = UDim2.new(0, 130, 0, 40)
                    bill.StudsOffset   = Vector3.new(0, 4, 0)
                    bill.AlwaysOnTop   = true
                    bill.Parent        = basePart

                    local lbl = Instance.new("TextLabel")
                    lbl.Name                = "TextLabel"
                    lbl.Size                = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.TextColor3          = isSideroom
                        and Color3.fromRGB(255, 0, 0)
                        or  Color3.new(1, 1, 1)
                    lbl.Font                = Enum.Font.GothamBold
                    lbl.TextScaled          = true
                    lbl.Text                = isSideroom and "⚠ SIDEROOM" or obj.Name
                    lbl.Parent              = bill
                else
                    local lbl  = bill:FindFirstChild("TextLabel")
                    local dist = myHRP
                        and math.floor((basePart.Position - myHRP.Position).Magnitude)
                        or 0
                    if lbl then
                        if isSideroom then
                            lbl.Text = "⚠ SIDEROOM"
                            -- Proximity sound alert
                            if myHRP and (basePart.Position - myHRP.Position).Magnitude <= 20
                                and not D.alertedSideroom then
                                D.alertedSideroom = true
                                pcall(function()
                                    local snd = Instance.new("Sound")
                                    snd.SoundId = "rbxassetid://3165700530"
                                    snd.Volume  = 1
                                    snd.Parent  = basePart
                                    snd:Play()
                                    game:GetService("Debris"):AddItem(snd, 4)
                                end)
                                showToast("DOORS", "⚠ Sideroom Dupe nearby!", Color3.fromRGB(255,80,80))
                            end
                        else
                            lbl.Text = obj.Name .. " (" .. dist .. "m)"
                        end
                    end
                end
            end)
        end
    end)

    -- ════════════════════════════════════════════════════════════
    -- FEATURE 2: SEE ENEMIES
    -- Highlights Rush, Ambush, Eyes, Screech, Halt, Seek
    -- with a bright red Highlight and a warning billboard.
    -- ════════════════════════════════════════════════════════════
    makeSectionLabel(scroll, "SEE ENEMIES", 3)

    local ENEMIES = {
        "RushMoving", "Rush", "AmbushMoving", "Ambush",
        "Eyes", "Screech", "Halt", "Seek", "Figure",
    }

    makeToggle(scroll, "See Enemies",
        "Red highlight + billboard on Rush, Ambush, Eyes, Screech…",
        function(on)
            D.seeEnemies = on
            if not on then
                for _, name in ipairs(ENEMIES) do
                    pcall(function()
                        local e = workspace:FindFirstChild(name, true)
                        if e then
                            local h = e:FindFirstChild("EnemyHighlight")
                            local b = e:FindFirstChild("EnemyBillboard")
                            if h then h:Destroy() end
                            if b then b:Destroy() end
                        end
                    end)
                end
            end
        end, 4)

    -- SeeEnemies heartbeat
    RunService.Heartbeat:Connect(function()
        if not D.seeEnemies then return end
        for _, enemyName in ipairs(ENEMIES) do
            pcall(function()
                local enemy = workspace:FindFirstChild(enemyName, true)
                if not enemy then return end

                local root = enemy:IsA("BasePart") and enemy
                    or enemy:FindFirstChildWhichIsA("BasePart")
                if not root then return end

                -- Red highlight
                if not root:FindFirstChild("EnemyHighlight") then
                    local h = Instance.new("Highlight")
                    h.Name                = "EnemyHighlight"
                    h.Adornee             = enemy
                    h.FillColor           = Color3.fromRGB(255, 30, 30)
                    h.FillTransparency    = 0.25
                    h.OutlineColor        = Color3.fromRGB(255, 100, 100)
                    h.OutlineTransparency = 0
                    h.Parent              = root
                end

                -- Billboard
                if not root:FindFirstChild("EnemyBillboard") then
                    local bill = Instance.new("BillboardGui")
                    bill.Name        = "EnemyBillboard"
                    bill.Size        = UDim2.new(0, 120, 0, 40)
                    bill.StudsOffset = Vector3.new(0, 6, 0)
                    bill.AlwaysOnTop = true
                    bill.Parent      = root

                    local lbl = Instance.new("TextLabel")
                    lbl.Size                   = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.TextColor3             = Color3.fromRGB(255, 80, 80)
                    lbl.Font                   = Enum.Font.GothamBold
                    lbl.TextScaled             = true
                    lbl.Text                   = "⚠ " .. enemyName
                    lbl.Parent                 = bill
                end
            end)
        end
    end)

    -- ════════════════════════════════════════════════════════════
    -- FEATURE 3: ENTITY WARNING HUD  (custom feature)
    -- A persistent screen overlay that flashes a full-screen red
    -- vignette and displays the entity name the moment Rush,
    -- Ambush, Screech, Eyes or Seek appears in the workspace.
    -- Clears automatically after 3 seconds. Completely separate
    -- from SeeEnemies — works even without it enabled.
    -- ════════════════════════════════════════════════════════════
    makeSectionLabel(scroll, "ENTITY WARNING HUD", 5)

    local entityHUDGui = New("ScreenGui", {
        Name           = "EntityWarningHUD",
        ResetOnSpawn   = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Enabled        = false,
    }, PlayerGui)

    -- Full screen red vignette flash
    local entityFlash = New("ImageLabel", {
        Size                   = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Image                  = "rbxassetid://1393519701",
        ImageColor3            = Color3.fromRGB(220, 0, 0),
        ImageTransparency      = 1,
        ZIndex                 = 100,
    }, entityHUDGui)

    -- Central warning text
    local entityWarnFrame = New("Frame", {
        Size                   = UDim2.new(0, 320, 0, 70),
        Position               = UDim2.new(0.5, -160, 0.15, 0),
        BackgroundColor3       = Color3.fromRGB(5, 0, 0),
        BackgroundTransparency = 0.2,
        BorderSizePixel        = 0,
        ZIndex                 = 101,
    }, entityHUDGui)
    Corner(8, entityWarnFrame)
    Stroke(Color3.fromRGB(220, 30, 30), 2, entityWarnFrame)

    local entityWarnLbl = New("TextLabel", {
        Text                   = "",
        Size                   = UDim2.new(1, 0, 0.55, 0),
        Position               = UDim2.new(0, 0, 0.05, 0),
        BackgroundTransparency = 1,
        TextColor3             = Color3.fromRGB(255, 60, 60),
        Font                   = Enum.Font.GothamBold,
        TextSize               = 22,
        TextXAlignment         = Enum.TextXAlignment.Center,
        ZIndex                 = 102,
    }, entityWarnFrame)

    local entitySubLbl = New("TextLabel", {
        Text                   = "",
        Size                   = UDim2.new(1, 0, 0.4, 0),
        Position               = UDim2.new(0, 0, 0.57, 0),
        BackgroundTransparency = 1,
        TextColor3             = Color3.fromRGB(180, 100, 100),
        Font                   = Enum.Font.Code,
        TextSize               = 11,
        TextXAlignment         = Enum.TextXAlignment.Center,
        ZIndex                 = 102,
    }, entityWarnFrame)

    local warnActive    = false
    local warnCooldown  = {}

    local function triggerEntityWarn(name)
        if warnCooldown[name] then return end
        warnCooldown[name] = true
        warnActive         = true

        entityWarnLbl.Text = "⚠  " .. name:upper() .. "  ⚠"
        entitySubLbl.Text  = "Entity detected — hide immediately"

        -- Flash vignette in
        TweenService:Create(entityFlash,
            TweenInfo.new(0.15), {ImageTransparency = 0.3}):Play()
        -- Pulse text frame
        TweenService:Create(entityWarnFrame,
            TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 3, true),
            {BackgroundTransparency = 0.65}):Play()

        -- Auto-clear after 3 seconds
        task.delay(3, function()
            TweenService:Create(entityFlash,
                TweenInfo.new(0.4), {ImageTransparency = 1}):Play()
            task.wait(0.45)
            entityWarnLbl.Text = ""
            entitySubLbl.Text  = ""
            warnActive = false
            task.delay(4, function()
                warnCooldown[name] = nil
            end)
        end)
    end

    -- Poll workspace for entities
    local entityPollConn = nil
    makeToggle(scroll, "Entity Warning HUD",
        "Full-screen red flash + name label when any entity spawns",
        function(on)
            entityHUDGui.Enabled = on
            D.entityHUD = on
            if on then
                entityPollConn = RunService.Heartbeat:Connect(function()
                    if not D.entityHUD then return end
                    for _, name in ipairs(ENEMIES) do
                        pcall(function()
                            if workspace:FindFirstChild(name, true) then
                                triggerEntityWarn(name)
                            end
                        end)
                    end
                end)
            else
                if entityPollConn then entityPollConn:Disconnect(); entityPollConn = nil end
                TweenService:Create(entityFlash, TweenInfo.new(0.2), {ImageTransparency=1}):Play()
            end
        end, 6)

    -- Enemy notification log card (mirrors reference script's writeOutput logic)
    makeSectionLabel(scroll, "ENEMY LOG", 7)

    local logCard = New("Frame", {
        Size             = UDim2.new(1, 0, 0, 100),
        BackgroundColor3 = C.Secondary,
        BorderSizePixel  = 0,
        LayoutOrder      = 8,
    }, scroll)
    Corner(6, logCard)
    Stroke(C.Border, 0.5, logCard)

    local logLbl = New("TextLabel", {
        Text                   = "Enemy log will appear here when detected.",
        Size                   = UDim2.new(1, -12, 1, -8),
        Position               = UDim2.new(0, 6, 0, 4),
        BackgroundTransparency = 1,
        TextColor3             = C.TextDim,
        Font                   = Enum.Font.Code,
        TextSize               = 9,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextYAlignment         = Enum.TextYAlignment.Top,
        TextWrapped            = true,
    }, logCard)

    local logEntries = {}
    local function addLog(txt)
        table.insert(logEntries, 1, txt)
        if #logEntries > 6 then table.remove(logEntries) end
        logLbl.Text = table.concat(logEntries, "\n")
    end

    -- Hook entity detection into the log regardless of HUD toggle
    RunService.Heartbeat:Connect(function()
        for _, name in ipairs(ENEMIES) do
            pcall(function()
                if workspace:FindFirstChild(name, true) and not D.notifiedEnemies[name] then
                    D.notifiedEnemies[name] = true
                    addLog(string.format("[%s]  ⚠ %s detected!", os.date("%H:%M:%S"), name))
                    showToast("DOORS", "⚠ " .. name .. " is here!", Color3.fromRGB(255, 60, 60))
                    task.delay(30, function()   -- 30 s cooldown per entity so it can't spam
                        D.notifiedEnemies[name] = nil
                    end)
                end
            end)
        end
    end)

    makeButton(scroll, "Clear Enemy Log", function()
        logEntries = {}
        logLbl.Text = "Log cleared."
    end, 9)

    -- ─── NEW FEATURE: DOOR COUNTER HUD ──────────────────────────
    -- Tracks how many doors you've passed (finds the "CurrentDoor" value
    -- in the DOORS game) and displays a live HUD overlay.
    makeSectionLabel(scroll, "DOOR COUNTER HUD", 10)
    do
        local doorHudOn = false
        local doorGui = New("ScreenGui",{
            Name="NT_DoorCounter", ResetOnSpawn=false, IgnoreGuiInset=true,
            ZIndexBehavior=Enum.ZIndexBehavior.Sibling, Enabled=false,
        }, PlayerGui)
        local doorFrame = New("Frame",{
            Size=UDim2.new(0,140,0,30), Position=UDim2.new(0,10,0,55),
