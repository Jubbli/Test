    local recTimeLbl=New("TextLabel",{Text="Duration: 0.0s",Size=UDim2.new(1,0,0,12),Position=UDim2.new(0,0,0,36),BackgroundTransparency=1,TextColor3=C.TextDim,Font=Enum.Font.Code,TextSize=8,TextXAlignment=Enum.TextXAlignment.Left},recCard)

    makeSectionLabel(scroll, "🔴 RECORDING", 2)

    local _, macroNameInput=makeInput(scroll,"Macro Name","MyMacro",3)
    macroNameInput.FocusLost:Connect(function() MC.MacroName=macroNameInput.Text~="" and macroNameInput.Text or "MyMacro" end)

    makeButton(scroll,"🔴  Start Recording",function()
        if MC.Playing then NT_toast("Macros","Stop playback first",C.TextDim);return end
        MC.Recording=true;MC.RecordedMoves={};MC.RecordStart=tick()
        recStatusLbl.Text="🔴 RECORDING...";recStatusLbl.TextColor3=Color3.fromRGB(255,60,60)
        NT_toast("Macros","Recording — move your character!",Color3.fromRGB(255,60,60))
    end,4)

    makeButton(scroll,"⏹  Stop Recording",function()
        if not MC.Recording then NT_toast("Macros","Not recording",C.TextDim);return end
        MC.Recording=false
        recStatusLbl.Text="STOPPED — "..#MC.RecordedMoves.." moves"
        recStatusLbl.TextColor3=C.Text
        NT_toast("Macros","Recorded "..#MC.RecordedMoves.." moves",C.AccentBrt)
    end,5)

    makeButton(scroll,"💾  Save Macro",function()
        if #MC.RecordedMoves==0 then NT_toast("Macros","Nothing recorded",C.TextDim);return end
        table.insert(MC.SavedMacros,{name=MC.MacroName,moves=MC.RecordedMoves})
        recInfoLbl.Text="Moves: "..#MC.RecordedMoves.." | Saved: "..#MC.SavedMacros
        NT_toast("Macros","Saved: "..MC.MacroName,C.AccentBrt)
    end,6)

    local RECORD_INTERVAL=0.05; local lastRecT=tick()
    RunService.Heartbeat:Connect(function()
        if not MC.Recording then return end
        if tick()-lastRecT<RECORD_INTERVAL then return end
        lastRecT=tick()
        pcall(function()
            local p=game:GetService("Players").LocalPlayer
            local c=p.Character; if not c then return end
            local h=c:FindFirstChild("HumanoidRootPart"); if not h then return end
            table.insert(MC.RecordedMoves,{cframe=h.CFrame,t=tick()-MC.RecordStart})
            if #MC.RecordedMoves%20==0 then
                recInfoLbl.Text="Moves: "..#MC.RecordedMoves.." | Saved: "..#MC.SavedMacros
                recTimeLbl.Text="Duration: "..string.format("%.1f",tick()-MC.RecordStart).."s"
            end
        end)
    end)

    makeSectionLabel(scroll, "▶ PLAYBACK", 10)

    makeToggle(scroll,"Loop Playback","Loops the macro indefinitely",function(on) MC.PlayLoop=on end,11)
    makeSlider(scroll,"Playback Speed (x0.1s)",1,30,1,10,function(v) MC.PlaySpeed=v/10 end,12)

    makeButton(scroll,"▶  Play Last Recorded",function()
        if #MC.RecordedMoves==0 then NT_toast("Macros","Nothing to play",C.TextDim);return end
        if MC.Playing then NT_toast("Macros","Already playing",C.TextDim);return end
        MC.Playing=true
        recStatusLbl.Text="▶ PLAYING...";recStatusLbl.TextColor3=Color3.fromRGB(100,255,100)
        task.spawn(function()
            repeat
                for _,move in ipairs(MC.RecordedMoves) do
                    if not MC.Playing then break end
                    pcall(function()
                        local p=game:GetService("Players").LocalPlayer
                        local c=p.Character; if not c then return end
                        local h=c:FindFirstChild("HumanoidRootPart"); if not h then return end
                        h.CFrame=move.cframe
                    end)
                    task.wait(RECORD_INTERVAL/MC.PlaySpeed)
                end
            until not MC.PlayLoop or not MC.Playing
            MC.Playing=false
            recStatusLbl.Text="⏹ Playback done";recStatusLbl.TextColor3=C.Text
            NT_toast("Macros","Playback finished",C.AccentBrt)
        end)
        NT_toast("Macros","Playing macro...",Color3.fromRGB(100,255,100))
    end,13)

    makeButton(scroll,"⏹  Stop Playback",function()
        MC.Playing=false
        recStatusLbl.Text="⏹ Stopped";recStatusLbl.TextColor3=C.Text
        NT_toast("Macros","Playback stopped",C.TextDim)
    end,14)

    makeSectionLabel(scroll, "🎯 PRESET MACROS", 20)

    makeButton(scroll,"🎯 Circle Walk — Walks in a circle using sine/c",function()
        MC.RecordedMoves={}
