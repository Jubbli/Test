        "Elkman","Slugfish","Heed","Relib","Shame","PIHSROW",
        "Litany","Kookoo","Doppel","Doombringer",
    }

    -- ═══════════════════════════════════════════════════════
    -- SHARED POLL LOOP  (single Heartbeat, throttled per task)
    -- All entity checks go through here — no per-feature loops
    -- ═══════════════════════════════════════════════════════
    local GR_State = {
        -- Entity cache updated every 0.5 s
        entityCache   = {},   -- { name → {obj, hrp, dist} }
        cacheAge      = 0,
        -- Feature flags
        sprintOn      = false, sprintSpeed = 28,
        noclipOn      = false,
        antiVoidOn    = false, voidThreshold = -50,
        godOn         = false,
        goatWarnOn    = false, goatWarned = false,
