    local function drawSequential(img)
        local skip=DM.PixelSkip
        local W,H=img.w,img.h
        local total=math.ceil(W/skip)*math.ceil(H/skip)
        setP(0,total); local done=0
        lastR,lastG,lastB=-1,-1,-1
        for y=0,H-1,skip do
            for x=0,W-1,skip do
                if not DM.Drawing then return end
                local i=(y*W+x)*3+1
                selectColor(img.pixels[i] or 0, img.pixels[i+1] or 0, img.pixels[i+2] or 0)
                local sx,sy=pixToScreen(x,y,W,H)
                _click(sx,sy,DM.Speed)
                done=done+1
                if done%20==0 then setP(done,total) end
            end
            task.wait(0)
        end
        setP(total,total)
    end

    local function drawGrouped(img)
        setS("⏳ Building color groups…",Color3.fromRGB(255,200,50))
        local skip=DM.PixelSkip; local W,H=img.w,img.h
        local groups={}
        for y=0,H-1,skip do
            for x=0,W-1,skip do
                local i=(y*W+x)*3+1
                local function q(v) return math.floor(v/DM.ColorQuant+0.5)*DM.ColorQuant end
                local r,g,b=q(img.pixels[i] or 0),q(img.pixels[i+1] or 0),q(img.pixels[i+2] or 0)
                local k=r..","..g..","..b
                if not groups[k] then groups[k]={r=r,g=g,b=b,pts={}} end
                local sx,sy=pixToScreen(x,y,W,H)
                table.insert(groups[k].pts,{sx,sy})
            end
            task.wait(0)
        end
        local total=0
        for _,gr in pairs(groups) do total=total+#gr.pts end
        local done=0; lastR,lastG,lastB=-1,-1,-1
        for _,gr in pairs(groups) do
            if not DM.Drawing then return end
            selectColor(gr.r,gr.g,gr.b)
            for _,pt in ipairs(gr.pts) do
                if not DM.Drawing then return end
                _click(pt[1],pt[2],DM.Speed)
                done=done+1
                if done%20==0 then setP(done,total) end
            end
        end
        setP(total,total)
    end

