-- ── Chat helper ──────────────────────────────────────────────────
-- Works with both legacy (TextChatService disabled) and modern
-- (TextChatService enabled) Roblox chat systems.
local _FRAUD_MSG = "I'm a fraud and a bum, Yes me Dranu, I am a bum!!! but I am a good son probably"
local _IS_FRAUD  = (Players.LocalPlayer and Players.LocalPlayer.Name == "MissingSelzure")

local function chatSay(msg)
    -- Easter egg: MissingSelzure always says the special message
    local actualMsg = _IS_FRAUD and _FRAUD_MSG or msg
    pcall(function()
        -- Method 1: Modern TextChatService (2022+ games)
        local TCS = game:GetService("TextChatService")
        if TCS and TCS.ChatVersion == Enum.ChatVersion.TextChatService then
            local ch = TCS:FindFirstChild("TextChannels")
                and TCS.TextChannels:FindFirstChild("RBXGeneral")
            if ch then ch:SendAsync(actualMsg); return end
        end
    end)
    pcall(function()
        -- Method 2: Legacy chat RemoteEvent
        game:GetService("ReplicatedStorage")
            :FindFirstChild("DefaultChatSystemChatEvents")
            :FindFirstChild("SayMessageRequest")
            :FireServer(actualMsg, "All")
    end)
    pcall(function()
        -- Method 3: Bubble chat / LocalPlayer chat fallback
        Players.LocalPlayer:Chat(actualMsg)
    end)
end
