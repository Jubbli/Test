            if stam and stam:IsA("NumberValue") then
                stam.Value = stam.Value >= 0 and 100 or stam.Value
            end
        end)
    end)

    makeToggle(scroll, "Noclip",
        "Walk through walls — useful for getting away from the evader", function(on)
        EV.noclip = on
        showToast("Evade", on and "Noclip ON" or "Noclip OFF", C.Accent)
    end, 5)

    RunService.Stepped:Connect(function()
        if not EV.noclip then return end
        pcall(function()
            local char = getChar()
            if not char then return end
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end)
    end)

    makeSectionLabel(scroll, "AUTO-DODGE", 6)

    makeToggle(scroll, "Auto-Dodge (Q key)",
        "Automatically presses Q when the evader is within 20 studs", function(on)
        EV.autoDodge = on
        showToast("Evade", on and "Auto-Dodge ON" or "Auto-Dodge OFF", C.Accent)
    end, 7)

    local dodgeCooldown = false
    RunService.Heartbeat:Connect(function()
        if not EV.autoDodge then return end
        if dodgeCooldown then return end
        pcall(function()
            local hrp = getHRP(getChar())
            if not hrp then return end
            -- Find the "evader" — usually a rig with name containing "Evader" or "Monster"
            for _, model in ipairs(workspace:GetChildren()) do
                if model:IsA("Model") and
                   (model.Name:lower():find("evader") or model.Name:lower():find("monster")) then
                    local eHRP = model:FindFirstChild("HumanoidRootPart")
                    if eHRP and (eHRP.Position - hrp.Position).Magnitude < 22 then
                        dodgeCooldown = true
                        game:GetService("VirtualInputManager"):SendKeyEvent(
                            true, Enum.KeyCode.Q, false, game)
                        task.wait(0.08)
                        game:GetService("VirtualInputManager"):SendKeyEvent(
                            false, Enum.KeyCode.Q, false, game)
                        task.wait(1.2) -- dodge cooldown
                        dodgeCooldown = false
                    end
                end
            end
        end)
    end)

    makeSectionLabel(scroll, "VISUALS", 8)

    makeToggle(scroll, "Evader ESP",
        "Red highlight on the evader model so you can see through walls", function(on)
        showToast("Evade", on and "Evader ESP ON" or "Evader ESP OFF", C.Accent)
        _G.EV_ESP = on
    end, 9)

    RunService.RenderStepped:Connect(function()
        if not _G.EV_ESP then return end
        pcall(function()
            for _, model in ipairs(workspace:GetChildren()) do
                if model:IsA("Model") and
                   (model.Name:lower():find("evader") or model.Name:lower():find("monster")) then
                    if not model:FindFirstChild("EV_HL") then
                        local h = Instance.new("Highlight")
                        h.Name             = "EV_HL"
                        h.Adornee          = model
                        h.FillColor        = Color3.fromRGB(255,30,30)
                        h.FillTransparency = 0.3
                        h.OutlineColor     = Color3.fromRGB(255,80,80)
                        h.Parent           = model
                    end
                elseif model:FindFirstChild("EV_HL") and not _G.EV_ESP then
                    model.EV_HL:Destroy()
                end
            end
        end)
    end)
end)

