-- KILL-SWITCH MONITOR — Devs can broadcast _G.NTG_KILL=true to
-- destroy all running GUI instances across executor sessions.
-- Also attempts MessagingService broadcast for cross-client kills.
-- ════════════════════════════════════════════════════════════════
do
    local lastKillCheck = 0
    RunService.Heartbeat:Connect(function()
        local now = tick()
        if now - lastKillCheck < 2 then return end
        lastKillCheck = now
        if _G.NTG_KILL == true and not IS_DEV then
            pcall(function()
                -- Destroy all NTG GUIs (devs are immune)
                local pg = Player:FindFirstChild("PlayerGui")
                if pg then
                    for _, name in ipairs({"NothingThereGUI","KeySystem","NTG_Toasts",
                        "NT_Radar","NT_Flashbang","QliphothVision","CustomIY_Gui",
                        "NT_OrdealTimer","BB_TrackerHUD","NT_DoorCounter","NT_TimerFlash",
                        "NT_KillAuraGui","NT_DevPanel"}) do
                        local g = pg:FindFirstChild(name)
                        if g then g:Destroy() end
                    end
                end
            end)
        end
    end)
end

