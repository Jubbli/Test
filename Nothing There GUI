    makeSectionLabel(scroll, "BUILT-IN BACKUP PARRY", 5)

    -- Backup parry logic using the exact same algorithm as the user's script
    -- (PreSimulation, distance/speed ratio <= 0.55, fires mouse click)
    local backupOn    = false
    local backupParried = false

    local function getBall()
        local ballsFolder = workspace:FindFirstChild("Balls")
        if not ballsFolder then return nil end
        for _, b in ipairs(ballsFolder:GetChildren()) do
            if b:GetAttribute("realBall") then return b end
        end
        return nil
    end

    -- Watch for new balls and reset parried state
    local ballsFolder = workspace:FindFirstChild("Balls")
    if ballsFolder then
        ballsFolder.ChildAdded:Connect(function()
            task.wait(0.1)
            local ball = getBall()
            if not ball then return end
            ball:GetAttributeChangedSignal("target"):Connect(function()
                backupParried = false
            end)
        end)
    end

    -- Counter label
    local cCard = New("Frame",{
        Size=UDim2.new(1,0,0,28), BackgroundColor3=C.Secondary,
        BorderSizePixel=0, LayoutOrder=7,
    }, scroll); Corner(4, cCard)
    local cLbl = New("TextLabel",{
        Text="Backup parries: 0",
        Size=UDim2.new(1,-10,1,0), Position=UDim2.new(0,5,0,0),
        BackgroundTransparency=1, TextColor3=C.Text,
        Font=Enum.Font.Code, TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left,
    }, cCard)
    local bCount = 0

    makeToggle(scroll, "Backup Auto-Parry",
        "Uses PreSimulation + distance/speed ratio for frame-perfect parry", function(on)
        backupOn = on
        showToast("Blade Ball", on and "Backup Parry ON" or "Backup Parry OFF",
            on and Color3.fromRGB(60,220,80) or C.AccentBrt)
    end, 6)

    local VIM = game:GetService("VirtualInputManager")
    RunService.PreSimulation:Connect(function()
        if not backupOn then return end
        pcall(function()
            local ball = getBall()
            local hrp  = getHRP(getChar())
            if not ball or not hrp then return end

            local speed    = ball:FindFirstChild("zoomies") and
                             ball.zoomies:FindFirstChild("VectorVelocity") and
                             ball.zoomies.VectorVelocity.Magnitude or 0
            local distance = (hrp.Position - ball.Position).Magnitude

            if ball:GetAttribute("target") == Player.Name
                and not backupParried
                and speed > 0
                and (distance / speed) <= 0.55 then
                VIM:SendMouseButtonEvent(0, 0, 0, true,  game, 0)
                VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                backupParried = true
                bCount = bCount + 1
                cLbl.Text = "Backup parries: "..bCount
            end
        end)
    end)

    makeButton(scroll, "Reset Counter", function()
        bCount = 0; cLbl.Text = "Backup parries: 0"
    end, 8)

    makeSectionLabel(scroll, "MOVEMENT", 9)

    local bbSpeed = false
    makeToggle(scroll, "Speed Boost (40 WS)", "Sets WalkSpeed to 40", function(on)
        bbSpeed = on
        showToast("Blade Ball", on and "Speed ON" or "Speed OFF", C.Accent)
    end, 10)
    RunService.Heartbeat:Connect(function()
        if not bbSpeed then return end
        pcall(function() local h=getHum(getChar()); if h then h.WalkSpeed=40 end end)
    end)

    -- ─── NEW FEATURE: BALL DISTANCE TRACKER HUD ──────────────────
    -- Shows a live on-screen overlay with the distance between you
    -- and the active ball, plus a color indicator (green=safe, red=danger).
    makeSectionLabel(scroll, "BALL TRACKER HUD", 11)
    do
        local trackerOn = false
        local bbTrackerGui = New("ScreenGui",{
            Name="BB_TrackerHUD", ResetOnSpawn=false, IgnoreGuiInset=true,
            ZIndexBehavior=Enum.ZIndexBehavior.Sibling, Enabled=false,
        }, PlayerGui)
        local trackerFrame = New("Frame",{
            Size=UDim2.new(0,160,0,36), Position=UDim2.new(0.5,-80,0,10),
            BackgroundColor3=Color3.fromRGB(10,5,5),
            BackgroundTransparency=0.2, BorderSizePixel=0, ZIndex=60,
        }, bbTrackerGui); Corner(8, trackerFrame); Stroke(C.Accent,1,trackerFrame)
        local distLbl = New("TextLabel",{
            Text="BALL: --", Size=UDim2.new(1,0,1,0),
            BackgroundTransparency=1, TextColor3=Color3.new(1,1,1),
            Font=Enum.Font.GothamBold, TextSize=13, ZIndex=61,
        }, trackerFrame)

        makeToggle(scroll, "Ball Distance HUD",
            "On-screen label showing ball distance — green=safe, red=incoming", function(on)
            trackerOn = on
            bbTrackerGui.Enabled = on
        end, 12)

        RunService.RenderStepped:Connect(function()
            if not trackerOn then return end
            pcall(function()
                local ballsF = workspace:FindFirstChild("Balls")
                local ball   = ballsF and (function()
                    for _, b in ipairs(ballsF:GetChildren()) do
                        if b:GetAttribute("realBall") then return b end
                    end
                end)()
                local hrp = getHRP(getChar())
                if not ball or not hrp then distLbl.Text = "BALL: ---"; return end
                local dist = math.floor((ball.Position - hrp.Position).Magnitude)
                local danger = dist < 30
                distLbl.Text = "BALL: "..dist.." studs"
                distLbl.TextColor3 = danger
                    and Color3.fromRGB(255, 40, 40)
                    or  Color3.fromRGB(40,  220, 80)
            end)
        end)
    end
end)

