local function spawnAfterimages(sourceFrame, direction)
    local ap  = sourceFrame.AbsolutePosition
    local sz  = sourceFrame.AbsoluteSize
    local NUM = 5      -- number of ghost layers each side
    local ghosts = {}

    local OverlayGui = Instance.new("ScreenGui")
    OverlayGui.Name           = "NTG_AfterimageOverlay"
    OverlayGui.ResetOnSpawn   = false
    OverlayGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    OverlayGui.DisplayOrder   = 10000
    OverlayGui.IgnoreGuiInset = true
    OverlayGui.Parent         = PlayerGui

    for side = -1, 1, 2 do        -- -1 = left, +1 = right
        for i = 1, NUM do
            local offsetX = side * i * (sz.X * 0.18)
            local alpha   = 1 - (i / (NUM + 1))   -- opacity decreases with distance

            local g = Instance.new("Frame", OverlayGui)
            g.Size                   = UDim2.new(0, sz.X, 0, sz.Y)
            g.BackgroundColor3       = C.BG
            g.BorderSizePixel        = 0
            g.ZIndex                 = 9999 - i
            g.BackgroundTransparency = 1 - alpha * 0.6

            if direction == "out" then
                g.Position = UDim2.new(0, ap.X, 0, ap.Y)
            else
                g.Position = UDim2.new(0, ap.X + offsetX, 0, ap.Y)
            end

            Instance.new("UICorner", g).CornerRadius = UDim.new(0, 8)

            local edge = Instance.new("Frame", g)
            edge.Size             = UDim2.new(0, 2, 1, 0)
            edge.Position         = side == -1 and UDim2.new(0,0,0,0) or UDim2.new(1,-2,0,0)
            edge.BackgroundColor3 = C.AccentBrt
            edge.BorderSizePixel  = 0
            edge.ZIndex           = g.ZIndex + 1

            table.insert(ghosts, {frame=g, targetOffX=offsetX, alpha=alpha, side=side, idx=i})
        end
    end

    local delay = direction == "out" and 0 or 0.05
    for _, gh in ipairs(ghosts) do
        local g  = gh.frame
        local tx, ty = ap.X + (direction == "out" and gh.targetOffX or 0), ap.Y
        local dur = 0.22 - gh.idx * 0.025

        task.delay(delay * gh.idx, function()
            TweenService:Create(g,
                TweenInfo.new(dur, Enum.EasingStyle.Quint,
                    direction == "out" and Enum.EasingDirection.Out
                                      or  Enum.EasingDirection.In),
                {
                    Position = UDim2.new(0, tx, 0, ty),
                    BackgroundTransparency = 1,
                }
            ):Play()
            task.delay(dur + 0.05, function() pcall(function() g:Destroy() end) end)
        end)
    end

    local totalTime = 0.28
    task.delay(totalTime, function()
        pcall(function() OverlayGui:Destroy() end)
    end)
    return totalTime
end

