    local function updateTracker()
        if not trackerGui.Enabled then return end

        local myHRP = getHRP(getChar())

        for _, plr in ipairs(Players:GetPlayers()) do
            local pname = plr.Name
            if not trackerRows[pname] then
                local row = New("Frame", {
                    Name             = pname,
                    Size             = UDim2.new(1, -6, 0, 44),
                    BackgroundColor3 = C.Secondary,
                    BorderSizePixel  = 0,
                }, trackerScroll)
                Corner(4, row)
                Stroke(C.Border, 0.5, row)

                New("TextLabel", {
                    Name                   = "NameLbl",
                    Text                   = pname,
                    Size                   = UDim2.new(1, -10, 0, 18),
                    Position               = UDim2.new(0, 8, 0, 3),
                    BackgroundTransparency = 1,
                    TextColor3             = plr == Player and C.AccentBrt or C.Text,
                    Font                   = Enum.Font.GothamBold,
                    TextSize               = 11,
                    TextXAlignment         = Enum.TextXAlignment.Left,
                }, row)

                New("TextLabel", {
                    Name                   = "StatsLbl",
                    Text                   = "HP: -- / --   |   DIST: --",
                    Size                   = UDim2.new(1, -10, 0, 16),
                    Position               = UDim2.new(0, 8, 0, 22),
                    BackgroundTransparency = 1,
                    TextColor3             = C.TextDim,
                    Font                   = Enum.Font.Code,
                    TextSize               = 9,
                    TextXAlignment         = Enum.TextXAlignment.Left,
                }, row)

                trackerRows[pname] = row
            end

            local row = trackerRows[pname]
            if row and row.Parent then
                local statsLbl = row:FindFirstChild("StatsLbl")
                if statsLbl then
                    local pChar = plr.Character
                    local pHum  = getHum(pChar)
                    local pHRP  = getHRP(pChar)
                    local hp    = pHum and math.floor(pHum.Health)    or 0
                    local maxHp = pHum and math.floor(pHum.MaxHealth) or 0
                    local dist  = "??"
                    if pHRP and myHRP then
                        dist = tostring(math.floor((pHRP.Position - myHRP.Position).Magnitude))
                    end
                    local status = hp <= 0 and "DEAD" or (hp < maxHp * 0.3 and "CRITICAL" or "STABLE")
                    statsLbl.Text      = string.format("HP: %d/%d  DIST: %su  [%s]", hp, maxHp, dist, status)
                    statsLbl.TextColor3 = hp <= 0
                        and Color3.fromRGB(255, 50, 50)
                        or  (hp < maxHp * 0.3 and Color3.fromRGB(230, 160, 0) or C.TextDim)
                end
            end
        end

        for pname, row in pairs(trackerRows) do
            if not Players:FindFirstChild(pname) then
                row:Destroy()
                trackerRows[pname] = nil
            end
        end
    end

