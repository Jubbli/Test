local function buildResults(query)
    clearCards()
    query = query:lower():gsub("^%s*(.-)%s*$","%1")
    if query=="" then
        soCountLbl.Text="  Type to search across all tabs"
        return
    end
    local hits={}
    for _,e in ipairs(SEARCH_INDEX) do
        local ll=e.label:lower(); local dl=e.desc:lower(); local tl=e.tab:lower()
        local score=0
        if ll==query then score=200
        elseif ll:sub(1,#query)==query then score=150
        elseif ll:find(query,1,true) then score=100
        elseif dl:find(query,1,true) then score=50
        elseif tl:find(query,1,true) then score=20
        end
        if score>0 then hits[#hits+1]={e=e,s=score} end
    end
    table.sort(hits,function(a,b) return a.s>b.s end)
    soCountLbl.Text=#hits>0
        and ("  %d result%s for "%s""):format(#hits,#hits==1 and "" or "s",query)
        or  ("  No results for ""..query..""")

    for idx,hit in ipairs(hits) do
        local e=hit.e
        local col=KIND_COL[e.kind] or Color3.fromRGB(150,150,150)
        local card=New("Frame",{
            Size=UDim2.new(1,-4,0,54),BackgroundColor3=Color3.fromRGB(13,5,20),
            BorderSizePixel=0,LayoutOrder=idx,ZIndex=502,
        },soScroll); Corner(5,card)
        local cs=Instance.new("UIStroke",card)
        cs.Color=Color3.fromRGB(45,18,70); cs.Thickness=0.8
        Pad(8,10,8,8,card)

        local tabPill=New("TextLabel",{
            Text=e.tab,Size=UDim2.new(0,0,0,13),AutomaticSize=Enum.AutomaticSize.X,
            BackgroundColor3=Color3.fromRGB(28,8,45),TextColor3=Color3.fromRGB(160,120,255),
            Font=Enum.Font.GothamBold,TextSize=7,BorderSizePixel=0,ZIndex=503,
        },card); Corner(3,tabPill)
        local tp=Instance.new("UIPadding",tabPill)
        tp.PaddingLeft=UDim.new(0,3); tp.PaddingRight=UDim.new(0,3)

        local kindPill=New("TextLabel",{
            Text=e.kind:upper(),Size=UDim2.new(0,0,0,13),Position=UDim2.new(0,0,0,0),
            AutomaticSize=Enum.AutomaticSize.X,
            BackgroundColor3=Color3.fromRGB(8,4,4),TextColor3=col,
            Font=Enum.Font.GothamBold,TextSize=7,BorderSizePixel=0,ZIndex=503,
        },card); Corner(3,kindPill)
        Instance.new("UIStroke",kindPill).Color=col
        local kp=Instance.new("UIPadding",kindPill)
        kp.PaddingLeft=UDim.new(0,3); kp.PaddingRight=UDim.new(0,3)

        local pillRow=New("Frame",{
            Size=UDim2.new(1,-42,0,13),BackgroundTransparency=1,BorderSizePixel=0,ZIndex=503,
        },card)
        tabPill.Parent=pillRow; kindPill.Parent=pillRow
        local pl=Instance.new("UIListLayout",pillRow)
        pl.FillDirection=Enum.FillDirection.Horizontal; pl.Padding=UDim.new(0,3)

        New("TextLabel",{
            Text=e.label,Size=UDim2.new(1,-42,0,15),Position=UDim2.new(0,0,0,16),
            BackgroundTransparency=1,TextColor3=Color3.fromRGB(235,215,255),
            Font=Enum.Font.GothamBold,TextSize=10,TextXAlignment=Enum.TextXAlignment.Left,
            ZIndex=503,
        },card)
        New("TextLabel",{
            Text=e.desc,Size=UDim2.new(1,-42,0,12),Position=UDim2.new(0,0,0,34),
            BackgroundTransparency=1,TextColor3=Color3.fromRGB(95,75,135),
            Font=Enum.Font.Code,TextSize=7,TextXAlignment=Enum.TextXAlignment.Left,
            TextTruncate=Enum.TextTruncate.AtEnd,ZIndex=503,
        },card)

        local goBtn=New("TextButton",{
            Text="→",Size=UDim2.new(0,28,0,28),Position=UDim2.new(1,-30,0,12),
            BackgroundColor3=Color3.fromRGB(28,10,48),TextColor3=Color3.fromRGB(180,140,255),
            Font=Enum.Font.GothamBold,TextSize=11,BorderSizePixel=0,ZIndex=504,
        },card); Corner(4,goBtn)
        goBtn.MouseButton1Click:Connect(function()
            SearchOverlay.Visible=false
            SearchBtn.TextColor3=Color3.fromRGB(180,160,255)
            pcall(function() showTab(e.tab) end)
        end)
        card.MouseEnter:Connect(function()
            TweenService:Create(card,TweenInfo.new(0.08),{BackgroundColor3=Color3.fromRGB(20,8,32)}):Play()
            TweenService:Create(cs,TweenInfo.new(0.08),{Color=Color3.fromRGB(80,35,120)}):Play()
        end)
        card.MouseLeave:Connect(function()
            TweenService:Create(card,TweenInfo.new(0.08),{BackgroundColor3=Color3.fromRGB(13,5,20)}):Play()
            TweenService:Create(cs,TweenInfo.new(0.08),{Color=Color3.fromRGB(45,18,70)}):Play()
        end)
        table.insert(activeCards,card)
    end
end

