-- ════════════════════════════════════════════════════════════════
safeTab("Abnormality", function()
    local scroll = makeScrollFrame(TabFrames["Abnormality"])

    makeSectionLabel(scroll, "ALEPH-CLASS ABILITIES", 1)

    -- 1. INVISIBILITY — Real body floated up above map, full-avatar hologram on ground,
    -- camera locked to hologram, others only see hologram, real body invisible.
    do
        local maskOn         = false
        local ceilingPlatform = nil   -- anchor platform ABOVE real body
        local hologram       = nil    -- full avatar clone at ground level
        local holoConns      = {}
        local FLOAT_Y        = 1200   -- height ABOVE current position
        local prevCamType    = Enum.CameraType.Custom
        local holoHRP        = nil    -- hologram HumanoidRootPart ref

        local function destroyMask()
            for _, c in ipairs(holoConns) do pcall(function() c:Disconnect() end) end
            holoConns = {}
            if hologram       then pcall(function() hologram:Destroy()        end); hologram        = nil end
            if ceilingPlatform then pcall(function() ceilingPlatform:Destroy() end); ceilingPlatform = nil end
            holoHRP = nil
        end

        local function buildMask()
            local char = getChar()
            local hrp  = getHRP(char)
            if not char or not hrp then return end

            -- ── 1. Clone hologram BEFORE moving real body ───────────────
            hologram      = char:Clone()
            hologram.Name = "NT_Hologram"

            -- Strip scripts/animator so hologram stays still (we move it manually)
            for _, obj in ipairs(hologram:GetDescendants()) do
                if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("Animator") then
                    obj:Destroy()
                end
            end

            -- Keep Humanoid alive so clothing/accessories render properly,
            -- but disable state transitions so it doesn't collapse
            local holoHum = hologram:FindFirstChildOfClass("Humanoid")
            if holoHum then
                holoHum.PlatformStand = true
                holoHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                holoHum.HealthDisplayType   = Enum.HumanoidHealthDisplayType.AlwaysOff
            end

            -- Make all holo parts fully opaque + have collision (looks real to others)
            for _, v in ipairs(hologram:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.Transparency = 0.0   -- fully visible
                    v.CanCollide   = true  -- physical presence
                    v.Anchored     = true  -- we control position manually
                    v.CastShadow   = true
                end
            end

            -- Place hologram at current world position
            hologram.Parent = workspace
            holoHRP = hologram:FindFirstChild("HumanoidRootPart")

            -- ── 2. Float real character ABOVE map ────────────────────────
            local savedCFrame = hrp.CFrame
            hrp.CFrame = hrp.CFrame + Vector3.new(0, FLOAT_Y, 0)

            -- Invisible ceiling platform so real body doesn't fall back down
            ceilingPlatform = Instance.new("Part")
            ceilingPlatform.Size         = Vector3.new(10, 1, 10)
            ceilingPlatform.Anchored     = true
            ceilingPlatform.CanCollide   = true
            ceilingPlatform.Transparency = 1
            ceilingPlatform.CastShadow   = false
            ceilingPlatform.CFrame       = hrp.CFrame + Vector3.new(0, -2, 0)
            ceilingPlatform.Parent       = workspace

            -- Make real character completely invisible to everyone
            for _, v in ipairs(char:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.LocalTransparencyModifier = 1
                    v.CanCollide = false
                    v.CastShadow = false
                end
            end
            -- Hide name / health bar
            local realHum = getHum(char)
            if realHum then
                realHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                realHum.HealthDisplayType   = Enum.HumanoidHealthDisplayType.AlwaysOff
            end

            -- ── 3. Build part map: real → holo ───────────────────────────
            local function buildPartMap()
                local map = {}
                local holoByName = {}
                for _, hp in ipairs(hologram:GetDescendants()) do
                    if hp:IsA("BasePart") then
                        if not holoByName[hp.Name] then holoByName[hp.Name] = {} end
                        table.insert(holoByName[hp.Name], hp)
                    end
                end
                local nameCounters = {}
                for _, realPart in ipairs(char:GetDescendants()) do
                    if realPart:IsA("BasePart") then
                        local n = realPart.Name
                        nameCounters[n] = (nameCounters[n] or 0) + 1
                        local candidates = holoByName[n]
                        if candidates then
                            local holoPart = candidates[nameCounters[n]]
                            if holoPart then map[realPart] = holoPart end
                        end
                    end
                end
                return map
            end
            local partMap = buildPartMap()

            -- ── 4. RenderStepped: mirror real parts → hologram (offset -FLOAT_Y) ──
            -- Real body is FLOAT_Y above original position; hologram stays at original.
            local mirrorConn = RunService.RenderStepped:Connect(function()
                if not maskOn then return end
                pcall(function()
                    for realPart, holoPart in pairs(partMap) do
                        if realPart.Parent and holoPart.Parent then
                            holoPart.CFrame = realPart.CFrame - Vector3.new(0, FLOAT_Y, 0)
                        end
                    end
                end)
            end)
            table.insert(holoConns, mirrorConn)

            -- ── 5. Camera: lock to hologram HRP instead of real HRP ─────
            prevCamType = workspace.CurrentCamera.CameraType
            workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
            if holoHRP then
                -- Point camera subject at hologram so Roblox default cam follows it
                workspace.CurrentCamera.CameraSubject = holoHRP
            end
        end

        makeToggle(scroll, "[1] INVISIBILITY",
            "Float body above map, spawn full-avatar hologram below, camera follows hologram", function(on)
            maskOn = on
            S.Invisible = on
            if on then
                buildMask()
                showToast("Invisibility", "Hologram spawned. You are invisible.", C.Accent)
            else
                destroyMask()
                local char = getChar()
                local hrp  = getHRP(char)
                if char and hrp then
                    -- Return real body back down to ground
                    hrp.CFrame = hrp.CFrame - Vector3.new(0, FLOAT_Y, 0)
                    for _, v in ipairs(char:GetDescendants()) do
