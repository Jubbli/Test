safeTab("Keybinds", function()
    local f = TabFrames["Keybinds"]
    local scroll = makeScrollFrame(f)

    local KB = {
        Binds = {},
        Listening = false,
        ListeningFor = nil,
    }

    local DEFAULT_BINDS = {
        {id="SpeedToggle",   label="Toggle Speed Hack",    key=nil, action=function() S.SpeedOn=not S.SpeedOn end},
        {id="FlyToggle",     label="Toggle Fly",           key=nil, action=function() S.Fly=not S.Fly end},
        {id="NoClipToggle",  label="Toggle NoClip",        key=nil, action=function() S.NoClip=not S.NoClip end},
        {id="GodToggle",     label="Toggle God Mode",      key=nil, action=function() S.GodMode=not S.GodMode end},
        {id="FullBrightToggle",label="Toggle FullBright",  key=nil, action=function() S.FullBright=not S.FullBright end},
        {id="ESPToggle",     label="Toggle ESP",           key=nil, action=function() S.ESP=not S.ESP end},
        {id="GUIToggle",     label="Show/Hide NTG GUI",    key=nil, action=function()
            local pg = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
            local sg = pg and pg:FindFirstChild("NothingThereGUI")
            if sg then sg.Enabled = not sg.Enabled end
        end},
        {id="SpawnPart",     label="Spawn Part at Cursor", key=nil, action=function() end},
        {id="TeleportUp",    label="Teleport Up 20 studs", key=nil, action=function()
            pcall(function()
                local c=game:GetService("Players").LocalPlayer.Character
                local h=c and c:FindFirstChild("HumanoidRootPart")
                if h then h.CFrame=h.CFrame+Vector3.new(0,20,0) end
            end)
        end},
        {id="KillSelf",      label="Kill Self",            key=nil, action=function()
            pcall(function()
                local c=game:GetService("Players").LocalPlayer.Character
                local h=c and c:FindFirstChildOfClass("Humanoid")
                if h then h.Health=0 end
            end)
        end},
        {id="RejoinServer",  label="Rejoin Server",        key=nil, action=function()
            pcall(function()
                game:GetService("TeleportService"):Teleport(game.PlaceId,
                    game:GetService("Players").LocalPlayer)
            end)
        end},
    }

    KB.Binds = DEFAULT_BINDS

    makeSectionLabel(scroll, "⌨ KEYBIND ASSIGNMENTS", 1)

    local bindRows = {}
    local function buildBindList()
        for _, c in ipairs(scroll:GetChildren()) do
            if c:IsA("Frame") and c.Name:sub(1,8)=="BindRow_" then c:Destroy() end
        end
        bindRows = {}
        for i, bind in ipairs(KB.Binds) do
            local b = bind
            local row = New("Frame",{
                Name="BindRow_"..b.id,
                Size=UDim2.new(1,0,0,34), BackgroundColor3=C.Secondary,
                BorderSizePixel=0, LayoutOrder=2+i,
            }, scroll)
            Corner(5,row); Stroke(C.Border,0.5,row); Pad(0,4,6,6,row)
            New("TextLabel",{
                Text=b.label,
                Size=UDim2.new(0.55,0,1,0),
                BackgroundTransparency=1,TextColor3=C.Text,
                Font=Enum.Font.Gotham,TextSize=9,
                TextXAlignment=Enum.TextXAlignment.Left,
                TextTruncate=Enum.TextTruncate.AtEnd,
            }, row)
            local keyBtn = New("TextButton",{
                Text=b.key and tostring(b.key) or "[ Click to bind ]",
                Size=UDim2.new(0.3,0,0.8,0), Position=UDim2.new(0.57,0,0.1,0),
                BackgroundColor3=b.key and C.Accent or C.Btn,
                TextColor3=Color3.new(1,1,1),Font=Enum.Font.Code,
                TextSize=8,BorderSizePixel=0,
                TextTruncate=Enum.TextTruncate.AtEnd,
            }, row)
            Corner(3,keyBtn)
            local clrBtn = New("TextButton",{
                Text="✕",
                Size=UDim2.new(0.1,0,0.8,0), Position=UDim2.new(0.89,0,0.1,0),
                BackgroundColor3=Color3.fromRGB(60,15,15),
                TextColor3=C.AccentBrt,Font=Enum.Font.GothamBold,
                TextSize=10,BorderSizePixel=0,
            }, row)
            Corner(3,clrBtn)
            bindRows[b.id] = {keyBtn=keyBtn, clrBtn=clrBtn, bind=b}
            keyBtn.MouseButton1Click:Connect(function()
                if KB.Listening then return end
                KB.Listening = true
                KB.ListeningFor = b.id
                keyBtn.Text = "[ Press a key... ]"
                keyBtn.BackgroundColor3 = Color3.fromRGB(50,50,0)
                NT_toast("Keybinds", "Press any key to bind to: "..b.label, C.AccentBrt)
            end)
            clrBtn.MouseButton1Click:Connect(function()
                b.key = nil
                keyBtn.Text = "[ Click to bind ]"
                keyBtn.BackgroundColor3 = C.Btn
                NT_toast("Keybinds", "Cleared: "..b.label, C.TextDim)
            end)
        end
    end
    buildBindList()

    UserInputService.InputBegan:Connect(function(input, gp)
        if not KB.Listening then
            for _, bind in ipairs(KB.Binds) do
                if bind.key and input.KeyCode == bind.key then
                    pcall(bind.action)
                end
            end
            return
        end
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            local id = KB.ListeningFor
            for _, bind in ipairs(KB.Binds) do
                if bind.id == id then
                    bind.key = input.KeyCode
                    local info = bindRows[id]
                    if info then
                        info.keyBtn.Text = tostring(input.KeyCode):gsub("Enum.KeyCode.","K:")
                        info.keyBtn.BackgroundColor3 = C.Accent
                    end
                    NT_toast("Keybinds", input.KeyCode.Name.." → "..bind.label, C.AccentBrt)
                    break
                end
            end
            KB.Listening = false
            KB.ListeningFor = nil
        end
    end)

    makeButton(scroll, "🔄  Reset All Keybinds", function()
        for _, bind in ipairs(KB.Binds) do bind.key = nil end
        buildBindList()
        NT_toast("Keybinds", "All binds cleared", C.TextDim)
    end, 20)

end) -- end safeTab Keybinds

