                end
            end) ciyLog("Invisible") end },
        { cat="VISIBILITY", name="Visible Again",desc="Restore transparency",
          run=function()
            pcall(function()
                for _,p in ipairs(getChar():GetDescendants()) do
                    if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then p.Transparency=0 end
                end
            end) ciyLog("Visible") end },
        -- Player
        { cat="PLAYER",   name="God Mode ON",   desc="Lock HP to max",
          run=function() S.GodMode=true; ciyLog("God Mode ON") end },
        { cat="PLAYER",   name="God Mode OFF",  desc="Disable HP lock",
          run=function() S.GodMode=false; ciyLog("God Mode OFF") end },
        { cat="PLAYER",   name="Fullbright",    desc="Max ambient lighting",
          run=function() S.FullBright=true; ciyLog("Fullbright ON") end },
        { cat="PLAYER",   name="Fullbright OFF",desc="Restore lighting",
          run=function() S.FullBright=false; ciyLog("Fullbright OFF") end },
        { cat="PLAYER",   name="Print Players", desc="List all players in console",
          run=function()
            local names={}
            for _,p in ipairs(Players:GetPlayers()) do table.insert(names, p.Name) end
            ciyLog(table.concat(names,", ")) end },
        { cat="PLAYER",   name="Rejoin",        desc="Leave and rejoin — GUI auto-loads if Auto-Exec ON",
          run=function()
            if ciyAutoExec then
                -- Store the script source in _G so the executor can re-run it after teleport.
                -- Most executors (Synapse, KRNL, Fluxus) expose getscriptbytecode / getscriptfunction
                -- or allow you to use their auto-exec folder. This sets a flag they can check:
                _G.NTG_AutoExec      = true
                _G.NTG_AutoExecPlace = game.PlaceId
                ciyLog("Auto-Exec ON — GUI will reload after rejoin.")
            else
                ciyLog("Rejoining...")
            end
            task.wait(0.8)
            game:GetService("TeleportService"):Teleport(game.PlaceId, Player)
          end },
        -- NT Exclusives
        { cat="NT EXCLUSIVE", name="NT Breach Alarm",desc="Trigger containment breach screen",
          run=function() showToast("NT","CONTAINMENT BREACH TRIGGERED",C.AccentBrt); ciyLog("Breach alarm") end },
        { cat="NT EXCLUSIVE", name="Rainbow Mode ON",desc="Cycle character colours",
          run=function() S.Rainbow=true; ciyLog("Rainbow ON") end },
        { cat="NT EXCLUSIVE", name="Rainbow Mode OFF",desc="Stop rainbow",
          run=function() S.Rainbow=false; ciyLog("Rainbow OFF") end },
        { cat="NT EXCLUSIVE", name="Spin ON",    desc="Rotate character continuously",
          run=function() S.Spin=true; ciyLog("Spin ON") end },
        { cat="NT EXCLUSIVE", name="Spin OFF",   desc="Stop spinning",
          run=function() S.Spin=false; ciyLog("Spin OFF") end },
        { cat="NT EXCLUSIVE", name="Work Log",   desc="Send a work log message to chat",
          run=function()
            pcall(function()
                chatSay("[LOG] Nothing There Qliphoth counter: 0. All clear.")
            end) ciyLog("Log sent") end },
        -- Teleport
        { cat="TELEPORT", name="Tp to Spawn",   desc="Teleport to spawn point",
          run=function()
            pcall(function()
                local sp = workspace:FindFirstChild("SpawnLocation")
                local hrp = getHRP(getChar())
                if sp and hrp then hrp.CFrame = CFrame.new(sp.Position + Vector3.new(0,5,0)) end
            end) ciyLog("Tp Spawn") end },
    }

    -- Build command rows
    local cmdButtons = {}

    local function buildCmdList(filter)
        -- Clear existing
        for _, c in ipairs(ciyScroll:GetChildren()) do
            if c:IsA("Frame") or c:IsA("TextButton") then c:Destroy() end
        end
        local lastCat = ""
        for _, cmd in ipairs(CIY_COMMANDS) do
            local show = filter == "" or
                cmd.name:lower():find(filter:lower()) or
                cmd.cat:lower():find(filter:lower())
            if not show then continue end

            -- Category separator
            if cmd.cat ~= lastCat then
                lastCat = cmd.cat
                local catLbl = New("TextLabel",{
                    Text="  -- "..cmd.cat.." --",
                    Size=UDim2.new(1,0,0,18),
                    BackgroundColor3=Color3.fromRGB(28,10,10),
                    TextColor3=C.Accent, Font=Enum.Font.GothamBold,
                    TextSize=9, TextXAlignment=Enum.TextXAlignment.Left,
                    BorderSizePixel=0,
                }, ciyScroll)
            end

            local row = New("Frame",{
                Size=UDim2.new(1,0,0,34), BackgroundColor3=C.Secondary, BorderSizePixel=0,
            }, ciyScroll); Corner(4, row)

            New("TextLabel",{
                Text=cmd.name, Size=UDim2.new(1,-70,0,18),
                Position=UDim2.new(0,8,0,2), BackgroundTransparency=1,
                TextColor3=C.Text, Font=Enum.Font.GothamBold,
                TextSize=11, TextXAlignment=Enum.TextXAlignment.Left,
            }, row)
            New("TextLabel",{
                Text=cmd.desc, Size=UDim2.new(1,-70,0,13),
                Position=UDim2.new(0,8,0,20), BackgroundTransparency=1,
                TextColor3=C.TextDim, Font=Enum.Font.Code,
                TextSize=8, TextXAlignment=Enum.TextXAlignment.Left,
            }, row)

            local execBtn = New("TextButton",{
                Text="RUN", Size=UDim2.new(0,52,0,22),
                Position=UDim2.new(1,-58,0,6),
                BackgroundColor3=C.Accent, TextColor3=Color3.new(1,1,1),
                Font=Enum.Font.GothamBold, TextSize=10, BorderSizePixel=0,
            }, row); Corner(4, execBtn)

            local capturedCmd = cmd
            execBtn.MouseButton1Click:Connect(function()
                local ok, err = pcall(capturedCmd.run)
                if not ok then ciyLog("Error: "..tostring(err):sub(1,50)) end
            end)
        end
    end

    buildCmdList("")

    ciySearchBox:GetPropertyChangedSignal("Text"):Connect(function()
        buildCmdList(ciySearchBox.Text)
    end)

    -- ── Toggle Logic ──────────────────────────────────────────
    local function toggleConsole(open)
        consoleOpen = open
        ciyWin.Visible = open
        miniLbl.TextColor3 = open and Color3.fromRGB(255,220,80) or C.Accent
        miniBar.BackgroundColor3 = open
            and Color3.fromRGB(30,20,5)
            or  Color3.fromRGB(14,7,7)
    end

    miniBar.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            toggleConsole(not consoleOpen)
        end
    end)
    ciyCloseBtn.MouseButton1Click:Connect(function()
        toggleConsole(false)
    end)

    -- Make window draggable
    local ciyDrag, ciyDS, ciyStartPos = false, nil, nil
    ciyTitle.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            ciyDrag=true; ciyDS=inp.Position; ciyStartPos=ciyWin.Position
        end
    end)
    ciyTitle.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then ciyDrag=false end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if not ciyDrag then return end
        if inp.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local d = inp.Position - ciyDS
        ciyWin.Position = UDim2.new(
            ciyStartPos.X.Scale, ciyStartPos.X.Offset + d.X,
            ciyStartPos.Y.Scale, ciyStartPos.Y.Offset + d.Y)
    end)
end

