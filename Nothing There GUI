-- TAB 7: TLB  (The Longest Battle — game-specific tools)
-- ════════════════════════════════════════════════════════════════
safeTab("TLB", function()
    local RepStorage = game:GetService("ReplicatedStorage")
    local scroll = makeScrollFrame(TabFrames["TLB"])

    -- ─── shared state ──────────────────────────────────────────
    local TLB = {
        dmgMax             = 1500,
        dmgMin             = 1500,
        attackSpeedValue   = 5,
        infiniteSpeed      = false,
        hitboxSize         = 10,
        selectedWork       = "Instinct",
        selectedAbnos      = {},
    }
    local workOptions = { "Instinct", "Insight", "Attachment", "Repression" }

    -- ─── helpers ───────────────────────────────────────────────
    local function tlbSetAttackSpeed(val)
        local units = workspace:FindFirstChild("Units")
        local unit  = units and units:FindFirstChild(Player.Name)
        local stats = unit and unit:FindFirstChild("CharStats")
        local atk   = stats and stats:FindFirstChild("AttackSpeed")
        if atk then atk.Value = val end
    end

    local function tlbApplyDamage(tool)
        local sv = tool:FindFirstChild("SettingValues")
        if sv then
            local mx = sv:FindFirstChild("MaxDamageValue")
            local mn = sv:FindFirstChild("MinDamageValue")
            if mx then mx.Value = TLB.dmgMax end
            if mn then mn.Value = TLB.dmgMin end
        end
    end

    local function tlbApplyAllDamage()
        for _, container in ipairs({ Player.Backpack, Player.Character }) do
            if container then
                for _, tool in ipairs(container:GetChildren()) do
                    if tool:IsA("Tool") then tlbApplyDamage(tool) end
                end
            end
        end
    end

    local function tlbApplyHitbox(tool)
        if not tool:IsA("Tool") then return end
        local anims = tool:FindFirstChild("Animations")
        local aa    = anims and anims:FindFirstChild("AttackAnimations")
        if not aa then return end
        for _, af in ipairs(aa:GetChildren()) do
            local hbv = af:FindFirstChild("HitboxSize")
            if hbv and hbv:IsA("Vector3Value") then
                hbv.Value = Vector3.new(TLB.hitboxSize, TLB.hitboxSize, TLB.hitboxSize)
            end
        end
    end

    local function tlbApplyAllHitboxes()
        for _, container in ipairs({ Player.Backpack, Player.Character }) do
            if container then
                for _, tool in ipairs(container:GetChildren()) do
                    tlbApplyHitbox(tool)
                end
            end
        end
    end

    local function tlbDoWork()
        local abnoRoot = workspace:FindFirstChild("Abnormalities")
        local assets   = RepStorage:FindFirstChild("Assets")
        local remotes  = assets and assets:FindFirstChild("RemoteEvents")
        local remote   = remotes and remotes:FindFirstChild("WorkEvent")
        if not abnoRoot or not remote then
            warn("[TLB] WorkEvent or Abnormalities folder not found")
            return
        end
        for _, name in ipairs(TLB.selectedAbnos) do
            local abno   = abnoRoot:FindFirstChild(name)
            local tablet = abno and abno:FindFirstChild("WorkTablet")
            if tablet then
                remote:FireServer(tablet, TLB.selectedWork)
            end
        end
    end

    -- ─── SECTION: Combat ───────────────────────────────────────
    makeSectionLabel(scroll, "COMBAT TWEAKS", 1)

    -- Damage inputs live in a sub-card
    local dmgCard = New("Frame", {
        Size             = UDim2.new(1, 0, 0, 130),
        BackgroundColor3 = C.Secondary,
        BorderSizePixel  = 0,
        LayoutOrder      = 2,
    }, scroll)
    Corner(6, dmgCard)
    Stroke(C.Border, 0.5, dmgCard)

    local function tlbInputRow(parent, label, yPos, default, callback)
        New("TextLabel", {
            Text                   = label,
            Size                   = UDim2.new(0, 110, 0, 22),
            Position               = UDim2.new(0, 10, 0, yPos),
            BackgroundTransparency = 1,
            TextColor3             = C.TextDim,
            Font                   = Enum.Font.Gotham,
            TextSize               = 11,
            TextXAlignment         = Enum.TextXAlignment.Left,
        }, parent)
        local box = New("TextBox", {
            Text              = tostring(default),
            PlaceholderText   = label,
            Size              = UDim2.new(0, 110, 0, 22),
            Position          = UDim2.new(0, 120, 0, yPos),
            BackgroundColor3  = C.InputBG,
            TextColor3        = C.Text,
            PlaceholderColor3 = C.TextDim,
            Font              = Enum.Font.Gotham,
            TextSize          = 11,
            BorderSizePixel   = 0,
            ClearTextOnFocus  = false,
        }, parent)
        Corner(4, box)
        Stroke(C.Border, 0.5, box)
        box.FocusLost:Connect(function()
            local v = tonumber(box.Text)
            if v then callback(v) end
        end)
        return box
    end

    tlbInputRow(dmgCard, "Max Damage",    8,  TLB.dmgMax,   function(v) TLB.dmgMax = v; tlbApplyAllDamage() end)
    tlbInputRow(dmgCard, "Min Damage",    38, TLB.dmgMin,   function(v) TLB.dmgMin = v; tlbApplyAllDamage() end)
    tlbInputRow(dmgCard, "Attack Speed",  68, TLB.attackSpeedValue, function(v)
        TLB.attackSpeedValue = v
        if not TLB.infiniteSpeed then tlbSetAttackSpeed(v) end
    end)

    -- Infinite speed toggle inside the card
    local infBtn = New("TextButton", {
        Text             = "Infinite Speed: OFF",
        Size             = UDim2.new(1, -20, 0, 26),
        Position         = UDim2.new(0, 10, 0, 96),
        BackgroundColor3 = Color3.fromRGB(50, 50, 50),
        TextColor3       = C.TextDim,
        Font             = Enum.Font.GothamBold,
        TextSize         = 11,
        BorderSizePixel  = 0,
    }, dmgCard)
    Corner(4, infBtn)
    infBtn.MouseButton1Click:Connect(function()
        TLB.infiniteSpeed = not TLB.infiniteSpeed
        tlbSetAttackSpeed(TLB.infiniteSpeed and math.huge or TLB.attackSpeedValue)
        infBtn.Text             = "Infinite Speed: " .. (TLB.infiniteSpeed and "ON" or "OFF")
        infBtn.BackgroundColor3 = TLB.infiniteSpeed and C.Accent or Color3.fromRGB(50, 50, 50)
        infBtn.TextColor3       = TLB.infiniteSpeed and Color3.fromRGB(255, 200, 200) or C.TextDim
    end)

    makeButton(scroll, "Apply Damage to All Tools", tlbApplyAllDamage, 3)

    -- ─── SECTION: Hitbox ───────────────────────────────────────
    makeSectionLabel(scroll, "HITBOX TWEAKS", 4)

    local hbCard = New("Frame", {
        Size             = UDim2.new(1, 0, 0, 60),
        BackgroundColor3 = C.Secondary,
        BorderSizePixel  = 0,
        LayoutOrder      = 5,
    }, scroll)
    Corner(6, hbCard)
    Stroke(C.Border, 0.5, hbCard)

    tlbInputRow(hbCard, "Hitbox Size", 8, TLB.hitboxSize, function(v)
        if v > 0 then TLB.hitboxSize = v end
    end)

    makeButton(scroll, "Apply Hitbox to All Tools", tlbApplyAllHitboxes, 6)

    -- ─── SECTION: Abnormality Worker ───────────────────────────
    makeSectionLabel(scroll, "ABNORMALITY WORKER", 7)

    -- Work type selector
    local workCard = New("Frame", {
        Size             = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = C.Secondary,
        BorderSizePixel  = 0,
        LayoutOrder      = 8,
    }, scroll)
    Corner(6, workCard)
    Stroke(C.Border, 0.5, workCard)

    New("TextLabel", {
        Text                   = "Work Type:",
        Size                   = UDim2.new(0, 90, 1, 0),
        Position               = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        TextColor3             = C.TextDim,
        Font                   = Enum.Font.Gotham,
        TextSize               = 11,
        TextXAlignment         = Enum.TextXAlignment.Left,
    }, workCard)

    -- Four work-type toggle buttons side by side
    local workBtns = {}
    local bW = (1 / #workOptions)
    for i, opt in ipairs(workOptions) do
        local wb = New("TextButton", {
            Text             = opt,
            Size             = UDim2.new(bW, -4, 0, 22),
            Position         = UDim2.new((i-1)*bW, (i==1 and 100 or 2), 0, 7),
            BackgroundColor3 = opt == TLB.selectedWork and C.Accent or C.Btn,
            TextColor3       = opt == TLB.selectedWork and Color3.fromRGB(255,200,200) or C.TextDim,
            Font             = Enum.Font.GothamBold,
            TextSize         = 9,
            BorderSizePixel  = 0,
        }, workCard)
        Corner(4, wb)
        workBtns[opt] = wb

        local o = opt
        wb.MouseButton1Click:Connect(function()
            TLB.selectedWork = o
            for optName, b in pairs(workBtns) do
                b.BackgroundColor3 = optName == o and C.Accent or C.Btn
                b.TextColor3       = optName == o and Color3.fromRGB(255,200,200) or C.TextDim
            end
        end)
    end

    -- Abno list (scrollable)
    local abnoListCard = New("Frame", {
        Size             = UDim2.new(1, 0, 0, 160),
        BackgroundColor3 = C.Secondary,
        BorderSizePixel  = 0,
        LayoutOrder      = 9,
    }, scroll)
    Corner(6, abnoListCard)
    Stroke(C.Border, 0.5, abnoListCard)

    New("TextLabel", {
        Text                   = "Select Abnormalities:",
        Size                   = UDim2.new(1, -10, 0, 18),
        Position               = UDim2.new(0, 8, 0, 4),
        BackgroundTransparency = 1,
        TextColor3             = C.TextDim,
        Font                   = Enum.Font.GothamBold,
        TextSize               = 10,
        TextXAlignment         = Enum.TextXAlignment.Left,
    }, abnoListCard)

    local abnoScroll = New("ScrollingFrame", {
        Size                   = UDim2.new(1, -10, 1, -24),
        Position               = UDim2.new(0, 5, 0, 22),
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        ScrollBarThickness     = 3,
        ScrollBarImageColor3   = C.Accent,
        CanvasSize             = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize    = Enum.AutomaticSize.Y,
    }, abnoListCard)
    ListLayout(3, abnoScroll)

    local abnosFolder = workspace:FindFirstChild("Abnormalities")
    if abnosFolder then
        for _, abno in ipairs(abnosFolder:GetChildren()) do
            local aName = abno.Name
            local aBtn  = New("TextButton", {
                Text             = aName,
                Size             = UDim2.new(1, -6, 0, 22),
                BackgroundColor3 = C.Btn,
                TextColor3       = C.TextDim,
                Font             = Enum.Font.Gotham,
                TextSize         = 10,
                BorderSizePixel  = 0,
            }, abnoScroll)
            Corner(4, aBtn)
            aBtn.MouseButton1Click:Connect(function()
                local idx = table.find(TLB.selectedAbnos, aName)
                if idx then
                    table.remove(TLB.selectedAbnos, idx)
                    aBtn.BackgroundColor3 = C.Btn
                    aBtn.TextColor3       = C.TextDim
                else
                    table.insert(TLB.selectedAbnos, aName)
                    aBtn.BackgroundColor3 = C.Accent
                    aBtn.TextColor3       = Color3.fromRGB(255, 200, 200)
                end
            end)
        end
    else
        New("TextLabel", {
            Text                   = "No Abnormalities folder found in Workspace.",
            Size                   = UDim2.new(1, -10, 0, 40),
            BackgroundTransparency = 1,
            TextColor3             = C.TextDim,
            Font                   = Enum.Font.Gotham,
            TextSize               = 10,
            TextXAlignment         = Enum.TextXAlignment.Center,
        }, abnoScroll)
    end

    makeButton(scroll, "Work Selected Abnormalities", tlbDoWork, 10)

    -- ─── AUTO-WORK LOOP ────────────────────────────────────────
    -- Repeatedly fires tlbDoWork on a configurable interval.
    -- Shows a live countdown so you know exactly when the next
    -- work cycle fires.
    -- ──────────────────────────────────────────────────────────
    makeSectionLabel(scroll, "AUTO-WORK LOOP", 11)

    local autoWorkInterval = 5   -- seconds between each cycle
    local autoWorkRunning  = false
    local autoWorkThread   = nil

    -- Interval slider
    makeSlider(scroll, "Work Interval (seconds)", 1, 60, 1, 5, function(v)
        autoWorkInterval = v
    end, 12)

    -- Status label that shows countdown
    local autoStatusCard = New("Frame", {
        Size             = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = C.Secondary,
        BorderSizePixel  = 0,
        LayoutOrder      = 13,
    }, scroll)
    Corner(6, autoStatusCard)
    Stroke(C.Border, 0.5, autoStatusCard)

    local autoStatusLbl = New("TextLabel", {
        Text                   = "Status: IDLE",
        Size                   = UDim2.new(1, -10, 1, 0),
        Position               = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        TextColor3             = C.TextDim,
        Font                   = Enum.Font.Code,
        TextSize               = 11,
        TextXAlignment         = Enum.TextXAlignment.Left,
    }, autoStatusCard)

    -- Cycle counter
    local cycleCount = 0

    local autoToggleCard, autoToggleBtn = makeToggle(scroll, "Auto-Work Loop", "Auto-fires work on all selected abnormalities", function(on)
        autoWorkRunning = on
        cycleCount = 0

        if on then
            if #TLB.selectedAbnos == 0 then
                autoStatusLbl.Text      = "Status: No abnormalities selected!"
                autoStatusLbl.TextColor3 = Color3.fromRGB(230, 160, 0)
                autoWorkRunning = false
                -- Force toggle back off visually on next frame
                task.defer(function()
                    autoToggleBtn.Text             = "OFF"
                    autoToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
                    autoToggleBtn.TextColor3       = C.TextDim
                    autoWorkRunning = false
                end)
                return
            end

            autoStatusLbl.TextColor3 = C.AccentBrt
            autoWorkThread = task.spawn(function()
                while autoWorkRunning do
                    -- Countdown display
                    local remaining = autoWorkInterval
                    while remaining > 0 and autoWorkRunning do
                        autoStatusLbl.Text = string.format(
                            "Status: RUNNING  |  Next: %ds  |  Cycles: %d",
                            remaining, cycleCount
                        )
                        task.wait(1)
                        remaining -= 1
                    end
                    if not autoWorkRunning then break end
                    -- Fire work
                    tlbDoWork()
                    cycleCount += 1
                    autoStatusLbl.Text = string.format(
                        "Status: FIRED  |  Cycle #%d complete",
                        cycleCount
                    )
                    task.wait(0.1)
                end
                autoStatusLbl.Text       = string.format("Status: STOPPED  |  Total cycles: %d", cycleCount)
                autoStatusLbl.TextColor3 = C.TextDim
            end)
        else
            autoWorkRunning = false
        end
    end, 14)


    if Player.Character then
        Player.Character.ChildAdded:Connect(function(c)
            if c:IsA("Tool") then
                task.wait(0.1)
                tlbApplyDamage(c)
                tlbApplyHitbox(c)
            end
        end)
    end
    Player.CharacterAdded:Connect(function(char)
        char.ChildAdded:Connect(function(c)
            if c:IsA("Tool") then
                task.wait(0.1)
                tlbApplyDamage(c)
                tlbApplyHitbox(c)
            end
        end)
    end)
end)

