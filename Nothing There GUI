                accumMed = 0

                -- Speed HUD
                if GR_speedHUDOn and hum then
                    speedLbl.Text = string.format("🏃 Speed: %.0f", hum.WalkSpeed)
                    speedLbl.TextColor3 = hum.WalkSpeed > 40
                        and Color3.fromRGB(80,255,120)
                        or  Color3.fromRGB(150,200,255)
                end

                -- Closest entity HUD
                if GR_State.ceHUDOn then
                    local cName, cDist = nil, math.huge
                    for name, e in pairs(GR_State.entityCache) do
                        if e.dist < cDist then cDist = e.dist; cName = name end
                    end
                    if cName then
                        ceLbl.Text = string.format("⚠ %s — %.0f studs", cName, cDist)
                        ceLbl.TextColor3 = cDist < 20 and Color3.fromRGB(255,30,30)
                            or cDist < 50 and Color3.fromRGB(255,180,0)
                            or Color3.fromRGB(200,200,200)
                    else
                        ceLbl.Text = "Entity: none nearby"
                        ceLbl.TextColor3 = Color3.fromRGB(60,220,80)
                    end
                end
            end

            -- ── SLOW LANE (every 0.5 s — entity scan + heavy ops) ──
            if accumSlow >= 0.5 then
                accumSlow = 0
                pcall(GR_UpdateCache)

                -- Goatman warning
                if GR_State.goatWarnOn then
