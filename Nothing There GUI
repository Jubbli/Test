        TabBtns[t.name] = btn

        local frame = New("Frame", {
            Size                   = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Visible                = false,
            ClipsDescendants       = true,
        }, ContentArea)
        TabFrames[t.name] = frame

        local tname = t.name
        btn.MouseButton1Click:Connect(function()
            for n, f in pairs(TabFrames) do f.Visible = (n == tname) end
            for n, b in pairs(TabBtns) do
                b.BackgroundColor3 = (n == tname) and C.TabActive   or C.TabInactive
                b.TextColor3       = (n == tname) and C.AccentBrt   or C.TextDim
            end
            if tname == "Dev" and isDevTab then
                btn.BackgroundColor3 = Color3.fromRGB(60,0,100)
                btn.TextColor3       = Color3.fromRGB(220,160,255)
            end
            S.ActiveTab = tname
        end)
    end
end

local function showTab(name)
    for n, f in pairs(TabFrames) do f.Visible = (n == name) end
    for n, b in pairs(TabBtns) do
        b.BackgroundColor3 = (n == name) and C.TabActive or C.TabInactive
        b.TextColor3       = (n == name) and C.AccentBrt or C.TextDim
    end
    S.ActiveTab = name
end

