        showToast("FNF Detect", (FNF.side or "No side").."  "..scrollDir,
            FNF.side and Color3.fromRGB(60,220,80) or Color3.fromRGB(255,80,80))
    end, 7)

    -- Manual side + scroll dir row
    local manualRow = New("Frame", {
        Size=UDim2.new(1,0,0,36), BackgroundColor3=C.Secondary,
        BorderSizePixel=0, LayoutOrder=8,
    }, scroll)
