    }, scroll)
    Corner(6, kbCard); Stroke(C.Border,0.5,kbCard)

    New("TextLabel", {
        Text="Toggle Bot Key:", Size=UDim2.new(0.48,0,1,0),
        Position=UDim2.new(0,10,0,0), BackgroundTransparency=1,
