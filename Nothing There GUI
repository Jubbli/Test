safeTab("Abnormality", function()
    local scroll = makeScrollFrame(TabFrames["Abnormality"])

    makeSectionLabel(scroll, "ALEPH-CLASS ABILITIES", 1)

    do
        local maskOn          = false
        local ceilingPlatform = nil
        local hologram        = nil
        local holoConns       = {}
        local FLOAT_Y         = 1200
        local savedCFrame     = nil
        local holoHRP         = nil

        local function destroyMask()
            for _, c in ipairs(holoConns) do pcall(function() c:Disconnect() end) end
            holoConns = {}
            if hologram        then pcall(function() hologram:Destroy()        end); hologram        = nil end
            if ceilingPlatform then pcall(function() ceilingPlatform:Destroy() end); ceilingPlatform = nil end
            holoHRP = nil
        end

        local function buildMask()
            local char = getChar()
            local hrp  = getHRP(char)
            if not char or not hrp then return end

            savedCFrame = hrp.CFrame

            hologram      = char:Clone()
            hologram.Name = "NT_Hologram"

            for _, obj in ipairs(hologram:GetDescendants()) do
                if obj:IsA("Script") or obj:IsA("LocalScript") then obj:Destroy() end
            end

            local holoHum = hologram:FindFirstChildOfClass("Humanoid")
            if holoHum then
                holoHum.PlatformStand       = true
                holoHum.AutoRotate          = false
                holoHum.JumpPower           = 0
                holoHum.WalkSpeed           = 0
                holoHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                holoHum.HealthDisplayType   = Enum.HumanoidHealthDisplayType.AlwaysOff
            end

            for _, v in ipairs(hologram:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.Transparency  = 0.0
                    v.CastShadow    = true
                    v.CanCollide    = (v.Name ~= "HumanoidRootPart")
                    v.Anchored      = (v.Name == "HumanoidRootPart")
                end
            end

            holoHRP = hologram:FindFirstChild("HumanoidRootPart")
            hologram.Parent = workspace

            hrp.CFrame = savedCFrame + Vector3.new(0, FLOAT_Y, 0)

            ceilingPlatform = Instance.new("Part")
            ceilingPlatform.Size         = Vector3.new(10, 1, 10)
            ceilingPlatform.Anchored     = true
            ceilingPlatform.CanCollide   = true
            ceilingPlatform.Transparency = 1
            ceilingPlatform.CastShadow   = false
            ceilingPlatform.CFrame       = hrp.CFrame + Vector3.new(0, -2, 0)
            ceilingPlatform.Parent       = workspace

            for _, v in ipairs(char:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.LocalTransparencyModifier = 1
                    v.CanCollide  = false
                    v.CastShadow  = false
                end
            end
            local realHum = getHum(char)
            if realHum then
                realHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                realHum.HealthDisplayType   = Enum.HumanoidHealthDisplayType.AlwaysOff
            end

            local mirrorConn = RunService.RenderStepped:Connect(function()
                if not maskOn or not holoHRP then return end
                pcall(function()
                    local realHRP = getHRP(getChar())
                    if realHRP and holoHRP.Parent then
                        holoHRP.CFrame = realHRP.CFrame - Vector3.new(0, FLOAT_Y, 0)
                    end
                end)
            end)
            table.insert(holoConns, mirrorConn)

            workspace.CurrentCamera.CameraType    = Enum.CameraType.Custom
            workspace.CurrentCamera.CameraSubject = holoHRP
        end

        makeToggle(scroll, "[1] INVISIBILITY",
            "Floats real body sky-high, spawns full avatar hologram at your spot. Camera follows hologram.", function(on)
            maskOn = on
            S.Invisible = on
            if on then
                buildMask()
                showToast("Invisibility", "Hologram active — you are invisible.", C.Accent)
            else
                destroyMask()
                local char = getChar()
                local hrp  = getHRP(char)
                if char and hrp then
                    if savedCFrame then
                        hrp.CFrame = savedCFrame
                    else
                        hrp.CFrame = hrp.CFrame - Vector3.new(0, FLOAT_Y, 0)
                    end
                    for _, v in ipairs(char:GetDescendants()) do
                        if v:IsA("BasePart") then
                            v.LocalTransparencyModifier = 0
                            v.CanCollide = true
                            v.CastShadow = true
                        end
                    end
                    local realHum = getHum(char)
                    if realHum then
                        realHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Automatic
                        realHum.HealthDisplayType   = Enum.HumanoidHealthDisplayType.DisplayWhenDamaged
                    end
                end
                workspace.CurrentCamera.CameraType    = Enum.CameraType.Custom
                workspace.CurrentCamera.CameraSubject = getHum(getChar()) or getHRP(getChar())
                showToast("Invisibility", "Hologram removed. Body restored.", C.TextDim)
            end
        end, 2)

        makeSlider(scroll, "Hologram Opacity (0=solid, 10=ghost)", 0, 10, 1, 0, function(v)
            if hologram then
                local t = (v / 10) * 0.95
                for _, p in ipairs(hologram:GetDescendants()) do
                    if p:IsA("BasePart") then p.Transparency = t end
                end
            end
        end, 3)
    end

    do
        local fbGui = New("ScreenGui",{
            Name="NT_Flashbang", ResetOnSpawn=false,
            IgnoreGuiInset=true, ZIndexBehavior=Enum.ZIndexBehavior.Sibling,
