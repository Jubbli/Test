            TextColor3=C.Accent, Font=Enum.Font.Code, TextSize=9,
            TextXAlignment=Enum.TextXAlignment.Center,}, anomalyFrame)
        local anomalyLbl = New("TextLabel",{Text="No anomalies detected.",
            Size=UDim2.new(1,-10,1,-22), Position=UDim2.new(0,5,0,20),
            BackgroundTransparency=1, TextColor3=C.TextDim,
            Font=Enum.Font.Code, TextSize=9,
            TextXAlignment=Enum.TextXAlignment.Left,
            TextYAlignment=Enum.TextYAlignment.Top, TextWrapped=true,}, anomalyFrame)

        local prevPositions = {}
        RunService.Heartbeat:Connect(function()
            if not _G.NT_AnomalyDetect then
                anomalyGui.Enabled = false; return
            end
            anomalyGui.Enabled = true
            local now = tick()
            if now - lastScan < 1 then return end
            lastScan = now
            anomalyLog = {}
            local myHRP = getHRP(getChar())
            pcall(function()
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr == Player then continue end
                    local c   = plr.Character
                    local hrp = getHRP(c)
                    local hum = getHum(c)
                    if not hrp or not hum then continue end
                    local dist = myHRP and (hrp.Position - myHRP.Position).Magnitude or 9999
                    if dist > 500 then continue end
                    local prev = prevPositions[plr.Name]
                    local speed = prev and (hrp.Position - prev).Magnitude or 0
                    prevPositions[plr.Name] = hrp.Position
                    -- Anomalies: flying (Y > 8 above ground), speed > 80, AFK (no move)
                    local flying  = hrp.Position.Y > (workspace:FindFirstChild("Terrain") and 8 or 30)
                    local speeding = speed > 80
                    local afk     = hum.MoveDirection.Magnitude == 0 and dist < 50
                    if flying  then table.insert(anomalyLog, plr.Name..": FLYING")       end
                    if speeding then table.insert(anomalyLog, plr.Name..": SPEED x"..math.floor(speed)) end
                    if afk      then table.insert(anomalyLog, plr.Name..": AFK/STATIC")   end
                end
            end)
            anomalyLbl.Text = #anomalyLog > 0 and table.concat(anomalyLog,"\n") or "No anomalies detected."
        end)
    end

