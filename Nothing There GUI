                    BorderSizePixel = 0, LayoutOrder = count,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                }, fireButtonsFrame)
                Corner(5, btn)
                hoverBtn(btn, Color3.fromRGB(50,10,10), Color3.fromRGB(80,20,20))
                btn.MouseButton1Click:Connect(function()
                    local ok, err2 = pcall(function()
