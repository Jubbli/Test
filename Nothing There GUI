        Text                   = labelText .. ": " .. tostring(val),
        Size                   = UDim2.new(1, -10, 0, 20),
        Position               = UDim2.new(0, 10, 0, 5),
        BackgroundTransparency = 1,
        TextColor3             = C.Text,
        Font                   = Enum.Font.GothamBold,
        TextSize               = 11,
        TextXAlignment         = Enum.TextXAlignment.Left,
    }, card)

    local track = New("Frame", {
        Size             = UDim2.new(1, -20, 0, 6),
        Position         = UDim2.new(0, 10, 0, 36),
        BackgroundColor3 = Color3.fromRGB(40, 15, 15),
        BorderSizePixel  = 0,
    }, card)
    Corner(3, track)

    local initRel = (val - minV) / (maxV - minV)
    local fill = New("Frame", {
        Size             = UDim2.new(initRel, 0, 1, 0),
        BackgroundColor3 = C.Accent,
        BorderSizePixel  = 0,
    }, track)
    Corner(3, fill)

    local thumb = New("TextButton", {
        Text             = "",
        Size             = UDim2.new(0, 14, 0, 14),
        Position         = UDim2.new(initRel, -7, 0.5, -7),
        BackgroundColor3 = C.AccentBrt,
        BorderSizePixel  = 0,
    }, track)
    Corner(7, thumb)

    local sliding = false
    thumb.MouseButton1Down:Connect(function() sliding = true end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = false
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if sliding and inp.UserInputType == Enum.UserInputType.MouseMovement then
            local abs = track.AbsolutePosition
            local sz  = track.AbsoluteSize
            local rel = math.clamp((inp.Position.X - abs.X) / sz.X, 0, 1)
            val = math.round((minV + rel * (maxV - minV)) / stepV) * stepV
            fill.Size      = UDim2.new(rel, 0, 1, 0)
            thumb.Position = UDim2.new(rel, -7, 0.5, -7)
            lbl.Text       = labelText .. ": " .. tostring(val)
            callback(val)
        end
    end)

    return card
end

local function safeTab(name, fn)
    local ok, err = pcall(fn)
    if not ok then
        local frame = TabFrames[name]
        if frame then
            local errLbl = Instance.new("TextLabel")
            errLbl.Text              = "⚠ Tab load error:\n"..tostring(err):sub(1,160)
            errLbl.Size              = UDim2.new(1,-16,0,80)
            errLbl.Position          = UDim2.new(0,8,0,8)
            errLbl.BackgroundColor3  = Color3.fromRGB(20,5,5)
            errLbl.BackgroundTransparency = 0.3
            errLbl.TextColor3        = Color3.fromRGB(255,80,80)
            errLbl.Font              = Enum.Font.Code
            errLbl.TextSize          = 9
            errLbl.TextWrapped       = true
            errLbl.TextXAlignment    = Enum.TextXAlignment.Left
            errLbl.TextYAlignment    = Enum.TextYAlignment.Top
            errLbl.Parent            = frame
        end
        warn("[NTG] Tab '"..name.."' failed to load: "..tostring(err))
    end
end

