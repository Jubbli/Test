safeTab("Doors", function()
    local scroll = makeScrollFrame(TabFrames["Doors"])

    -- ── Shared state ─────────────────────────────────────────────
    local D = {
        doorsVisual     = false,
        seeEnemies      = false,
        entityHUD       = false,
        notifiedEnemies = {},
        alertedSideroom = false,
    }

    -- ════════════════════════════════════════════════════════════
    -- FEATURE 1: DOORS VISUAL
    -- Highlights doors, keys, chests, levers, gold piles and
    -- sideroom dupes with fixed color Highlights + distance billboards.
    -- Scans on a timer to avoid lag (not every RenderStepped frame).
    -- ════════════════════════════════════════════════════════════
    makeSectionLabel(scroll, "DOORS VISUAL", 1)

    -- Fixed colors per object type (no rainbow = no per-frame color changes = no lag)
    local DOOR_COLORS = {
        Door     = Color3.fromRGB(255, 200,  50),  -- gold
        KeyObtain= Color3.fromRGB( 80, 220, 255),  -- cyan
        ChestBox = Color3.fromRGB(255, 165,   0),  -- orange
        LeverForGate=Color3.fromRGB(100, 255, 100),-- green
        GoldPile = Color3.fromRGB(255, 215,   0),  -- yellow
        SideroomDupe=Color3.fromRGB(255,  0,   0), -- red (danger)
    }

    local function getObjColor(name)
        for k, v in pairs(DOOR_COLORS) do
            if name:find(k) then return v end
        end
        return Color3.fromRGB(200, 200, 200)
    end

    -- Track known objects to avoid repeated GetDescendants
    local knownDoorObjs = {}
    local lastDoorScan  = 0

    makeToggle(scroll, "Doors Visual",
        "Fixed-color highlights + distance labels on all interactables (no lag, no rainbow)",
        function(on)
            D.doorsVisual = on
            D.alertedSideroom = false
            if not on then
                -- Strip all highlights and billboards
                for _, obj in pairs(knownDoorObjs) do
                    pcall(function()
                        if obj and obj.Parent then
                            local h = obj:FindFirstChild("HighlightVisual")
                            local b = obj:FindFirstChild("InfoBillboard")
                            if h then h:Destroy() end
                            if b then b:Destroy() end
                        end
                    end)
                end
                knownDoorObjs = {}
            end
        end, 2)

    RunService.Heartbeat:Connect(function()
        if not D.doorsVisual then return end
        local now = tick()
        local myHRP = getHRP(getChar())

        -- Rescan workspace every 0.5 seconds (not every frame)
        if now - lastDoorScan >= 0.5 then
            lastDoorScan = now
            local newObjs = {}
            for _, obj in ipairs(workspace:GetDescendants()) do
                local n = obj.Name
                if n:find("Door") or n == "KeyObtain" or n == "ChestBox"
                    or n == "LeverForGate" or n == "GoldPile" or n == "SideroomDupe" then
                    local bp = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                    if bp then
                        table.insert(newObjs, bp)
                        -- Add highlight and billboard if not already present
                        if not bp:FindFirstChild("HighlightVisual") then
                            local col = getObjColor(n)
                            local h = Instance.new("Highlight")
                            h.Name             = "HighlightVisual"
                            h.Adornee          = bp
                            h.FillColor        = col
                            h.FillTransparency = 0.55
                            h.OutlineColor     = col
                            h.OutlineTransparency = 0.3
                            h.Parent           = bp
                        end
                        if not bp:FindFirstChild("InfoBillboard") then
                            local bill = Instance.new("BillboardGui")
                            bill.Name        = "InfoBillboard"
                            bill.Size        = UDim2.new(0,130,0,32)
                            bill.StudsOffset = Vector3.new(0,4,0)
                            bill.AlwaysOnTop = true
                            bill.Parent      = bp
                            local lbl = Instance.new("TextLabel", bill)
                            lbl.Name               = "TextLabel"
                            lbl.Size               = UDim2.new(1,0,1,0)
                            lbl.BackgroundTransparency = 1
                            lbl.TextColor3         = getObjColor(n)
                            lbl.Font               = Enum.Font.GothamBold
                            lbl.TextScaled         = true
                            lbl.Text               = n == "SideroomDupe" and "⚠ SIDEROOM" or n
                        end
                    end
                end
            end
            knownDoorObjs = newObjs
        end

        -- Update distance labels (every heartbeat on KNOWN objects only)
        if myHRP then
            for _, bp in ipairs(knownDoorObjs) do
                pcall(function()
                    if not bp or not bp.Parent then return end
                    local bill = bp:FindFirstChild("InfoBillboard")
                    local lbl  = bill and bill:FindFirstChild("TextLabel")
                    if lbl then
                        local dist = math.floor((bp.Position - myHRP.Position).Magnitude)
                        if bp.Name == "SideroomDupe" then
                            lbl.Text = "⚠ SIDEROOM ("..dist.."m)"
                            if dist <= 20 and not D.alertedSideroom then
                                D.alertedSideroom = true
                                pcall(function()
                                    local snd = Instance.new("Sound")
                                    snd.SoundId = "rbxassetid://3165700530"
                                    snd.Volume  = 1; snd.Parent = bp; snd:Play()
                                    Debris:AddItem(snd, 4)
                                end)
                                showToast("DOORS", "⚠ Sideroom Dupe nearby!", Color3.fromRGB(255,80,80))
                            end
                        else
                            lbl.Text = bp.Name.." ("..dist.."m)"
                        end
                    end
                end)
            end
        end
    end)

    -- ════════════════════════════════════════════════════════════
    -- FEATURE 2: SEE ENEMIES
    -- Highlights Rush, Ambush, Eyes, Screech, Halt, Seek
    -- with a bright red Highlight and a warning billboard.
    -- ════════════════════════════════════════════════════════════
    makeSectionLabel(scroll, "SEE ENEMIES", 3)

    local ENEMIES = {
        "RushMoving", "Rush", "AmbushMoving", "Ambush",
        "Eyes", "Screech", "Halt", "Seek", "Figure",
    }

    makeToggle(scroll, "See Enemies",
        "Red highlight + billboard on Rush, Ambush, Eyes, Screech…",
        function(on)
            D.seeEnemies = on
            if not on then
                for _, name in ipairs(ENEMIES) do
                    pcall(function()
                        local e = workspace:FindFirstChild(name, true)
                        if e then
                            local h = e:FindFirstChild("EnemyHighlight")
                            local b = e:FindFirstChild("EnemyBillboard")
                            if h then h:Destroy() end
                            if b then b:Destroy() end
                        end
                    end)
                end
            end
        end, 4)

    -- SeeEnemies heartbeat
    RunService.Heartbeat:Connect(function()
        if not D.seeEnemies then return end
        for _, enemyName in ipairs(ENEMIES) do
            pcall(function()
                local enemy = workspace:FindFirstChild(enemyName, true)
                if not enemy then return end

                local root = enemy:IsA("BasePart") and enemy
                    or enemy:FindFirstChildWhichIsA("BasePart")
                if not root then return end

                -- Red highlight
                if not root:FindFirstChild("EnemyHighlight") then
                    local h = Instance.new("Highlight")
                    h.Name                = "EnemyHighlight"
                    h.Adornee             = enemy
                    h.FillColor           = Color3.fromRGB(255, 30, 30)
                    h.FillTransparency    = 0.25
                    h.OutlineColor        = Color3.fromRGB(255, 100, 100)
                    h.OutlineTransparency = 0
                    h.Parent              = root
                end

                -- Billboard
                if not root:FindFirstChild("EnemyBillboard") then
                    local bill = Instance.new("BillboardGui")
                    bill.Name        = "EnemyBillboard"
                    bill.Size        = UDim2.new(0, 120, 0, 40)
                    bill.StudsOffset = Vector3.new(0, 6, 0)
                    bill.AlwaysOnTop = true
                    bill.Parent      = root

                    local lbl = Instance.new("TextLabel")
                    lbl.Size                   = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.TextColor3             = Color3.fromRGB(255, 80, 80)
                    lbl.Font                   = Enum.Font.GothamBold
                    lbl.TextScaled             = true
                    lbl.Text                   = "⚠ " .. enemyName
                    lbl.Parent                 = bill
                end
            end)
        end
    end)

    -- ════════════════════════════════════════════════════════════
    -- FEATURE 3: ENTITY WARNING HUD  (custom feature)
    -- A persistent screen overlay that flashes a full-screen red
    -- vignette and displays the entity name the moment Rush,
    -- Ambush, Screech, Eyes or Seek appears in the workspace.
    -- Clears automatically after 3 seconds. Completely separate
    -- from SeeEnemies — works even without it enabled.
    -- ════════════════════════════════════════════════════════════
