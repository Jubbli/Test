            if tick() - lastAlertTime < 2 then return end
            pcall(function()
                local hrp = getHRP(getChar()); if not hrp then return end
                for _, v in ipairs(workspace:GetDescendants()) do
                    if v:IsA("BasePart") and v.Velocity.Magnitude > 60
                       and (v.Position - hrp.Position).Magnitude < bladeAlertRange then
                        lastAlertTime = tick()
                        showToast("⚠ BLADE CLOSE!", "Parry it!", Color3.fromRGB(255,60,60))
                        break
