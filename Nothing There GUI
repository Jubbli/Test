                local sorrowNow = GR_State.entityCache["Sorrow"] ~= nil
                if sorrowNow and not GR_State.prevSorrowEx then
                    showToast("⚠ SORROW!", "HIDE UNDER AN ARCHWAY NOW!", Color3.fromRGB(30,0,180))
                end
                GR_State.prevSorrowEx = sorrowNow
            end

            -- ── MEDIUM LANE (every 0.15 s — HUD text updates) ─
