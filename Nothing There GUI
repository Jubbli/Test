        showToast("Evade", on and "Speed Boost ON" or "Speed Boost OFF",
            on and Color3.fromRGB(60,200,60) or C.AccentBrt)
    end, 2)

    makeSlider(scroll, "Speed Value", 16, 80, 2, 32, function(v)
        EV.speedValue = v
    end, 3)

    local EV_speedValue = 32
    RunService.Heartbeat:Connect(function()
