                keybindBtn.Text = kname
                showToast("FNF Keybind", "Bot toggle set to: "..kname, C.AccentBrt)
            else
                keybindBtn.Text = tostring(FNF.keybind):match("KeyCode%.(.+)") or "Insert"
            end
