safeTab("BladeBall", function()
    local scroll = makeScrollFrame(TabFrames["BladeBall"])
    local VIM = game:GetService("VirtualInputManager")

    local function getBall()
        local f = workspace:FindFirstChild("Balls")
        if not f then return nil end
        for _, b in ipairs(f:GetChildren()) do
            if b:GetAttribute("realBall") then return b end
        end
        return nil
    end

    makeSectionLabel(scroll, "AUTO PARRY", 1)

    local parryOn     = false
    local parried     = false
    local parryCount  = 0

    local cCard = New("Frame",{
        Size=UDim2.new(1,0,0,28), BackgroundColor3=C.Secondary,
        BorderSizePixel=0, LayoutOrder=3,
    }, scroll); Corner(4, cCard)
    local cLbl = New("TextLabel",{
        Text="Parries: 0", Size=UDim2.new(1,-10,1,0), Position=UDim2.new(0,5,0,0),
        BackgroundTransparency=1, TextColor3=C.Text,
        Font=Enum.Font.Code, TextSize=10, TextXAlignment=Enum.TextXAlignment.Left,
    }, cCard)

    makeToggle(scroll, "Auto Parry",
        "PreSimulation loop — fires click when ball hits 0.55 distance/speed ratio", function(on)
        parryOn = on
        parried = false
        showToast("Blade Ball", on and "Auto Parry ON" or "Auto Parry OFF",
            on and Color3.fromRGB(60,220,80) or C.AccentBrt)
    end, 2)

    RunService.PreSimulation:Connect(function()
        if not parryOn then return end
        pcall(function()
            local ball = getBall()
            local hrp  = getHRP(getChar())
            if not ball or not hrp then return end
            local speed = (ball:FindFirstChild("zoomies")
                and ball.zoomies:FindFirstChild("VectorVelocity")
                and ball.zoomies.VectorVelocity.Magnitude) or 0
            local dist = (hrp.Position - ball.Position).Magnitude
            if ball:GetAttribute("target") == Player.Name
                and not parried and speed > 0 and (dist/speed) <= 0.55 then
                VIM:SendMouseButtonEvent(0,0,0,true,  game, 0)
                VIM:SendMouseButtonEvent(0,0,0,false, game, 0)
                parried = true
                parryCount = parryCount + 1
                cLbl.Text = "Parries: "..parryCount
            end
