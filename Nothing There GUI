          run=function() S.NoClip=false; ciyLog("NoClip OFF") end },
        { cat="VISIBILITY", name="Invisible",    desc="Make char transparent",
          run=function()
            pcall(function()
                for _,p in ipairs(getChar():GetDescendants()) do
