    }, pingCard)

    local lastPingUpdate = 0
    local frameCount = 0
    local lastFPSTime = tick()
    local currentFPS = 0

    RunService.Heartbeat:Connect(function(dt)
        frameCount = frameCount + 1
        local now = tick()
        if now - lastFPSTime >= 0.5 then
            currentFPS = math.floor(frameCount / (now - lastFPSTime))
            frameCount = 0
            lastFPSTime = now
        end
        if now - lastPingUpdate < 1 then return end
        lastPingUpdate = now
        pcall(function()
            local stats = game:GetService("Stats")
            local ping  = stats.Network.ServerStatsItem["Data Ping"]:GetValue()
            table.insert(NW.LastPings, ping)
            if #NW.LastPings > NW.PingMax then table.remove(NW.LastPings, 1) end
            local sum = 0
            for _, v in ipairs(NW.LastPings) do sum = sum + v end
            local avg = sum / #NW.LastPings
            local jitter = 0
            if #NW.LastPings >= 2 then
                local last5 = {}
                for i = math.max(1, #NW.LastPings-4), #NW.LastPings do
                    table.insert(last5, NW.LastPings[i])
                end
                local avg5 = 0
                for _, v in ipairs(last5) do avg5 = avg5 + v end
                avg5 = avg5 / #last5
                local variance = 0
                for _, v in ipairs(last5) do variance = variance + (v-avg5)^2 end
                jitter = math.sqrt(variance / #last5)
            end
            local pColor = ping < 80 and Color3.fromRGB(50,255,50)
                or ping < 150 and Color3.fromRGB(255,220,50)
                or Color3.fromRGB(255,60,60)
            pingLbl.TextColor3 = pColor
            pingLbl.Text    = string.format("Ping: %d ms", math.floor(ping))
