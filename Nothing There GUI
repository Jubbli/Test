        botToggleBtn.TextColor3       = on and Color3.fromRGB(255,200,200) or C.TextDim
    end

    local function startBot()
        FNF.notesHit = 0; FNF.combo = 0
        FNF.auto     = true
        detectSide()
        detectScrollDir()
        refreshKeys()

        -- Validate we have at least one key
        local hasKey = false
        for i = 1,9 do
            if laneKeys[i] ~= Enum.KeyCode.Unknown then hasKey = true; break end
        end

        local scrollDir = FNF.downscroll and "Down▼" or "Up▲"
        setStatus(("ACTIVE  Side:%s  Scroll:%s  Keys:%s"):format(
            FNF.side or "?", scrollDir, hasKey and "OK" or "NONE — refresh!"),
            hasKey and C.AccentBrt or Color3.fromRGB(255,160,0))

        showToast("FNF Bot", ("ACTIVE — Side:%s  %s"):format(
            FNF.side or "?", scrollDir), C.AccentBrt)

        syncToggleBtn(true)
        coroutine.wrap(autoplay)()
    end

    local function stopBot()
        FNF.auto = false
        for i = 1, 9 do releaseLane(i) end
        if randThread then task.cancel(randThread); randThread = nil end
        setStatus(("STOPPED  Hits:%d  Best combo:%d"):format(
            FNF.notesHit, FNF.maxCombo), C.TextDim)
        showToast("FNF Bot", ("Stopped — Hits:%d  Best:%d"):format(
            FNF.notesHit, FNF.maxCombo), C.Accent)
        syncToggleBtn(false)
    end

    local function toggleBot()
        if FNF.auto then stopBot() else startBot() end
    end

    -- ══════════════════════════════════════════════════════════
    -- UI
    -- ══════════════════════════════════════════════════════════
