    local DAMAGE_KEYWORDS = {
        "damage","hurt","hit","attack","kill","strike","wound","harm",
        "dmg","atk","hitplayer","dealDamage","doDamage","inflict","injure",
        "knockback","knockBack","takeDamage","TakeDamage","ApplyDamage",
        "DealDamage","HitDetect","HitHandler","ServerHit","CombatHit",
        "playerHit","onHit","registerHit","syncDamage","applyDmg",
        "onDeath","playerDied","charDied","entityHit","hitEvent",
    }

    local function nameMatchesDamage(name)
        local low = name:lower()
        for _, kw in ipairs(DAMAGE_KEYWORDS) do
            if low:find(kw:lower(), 1, true) then return true end
        end
        return false
    end

    local function addResultLine(text, col, order)
        local lbl = New("TextLabel", {
