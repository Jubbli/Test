    local function doLoadImage()
        local id = assetBox.Text:match("%d+") or ""
        if id=="" then NT_toast("DrawMe","Enter an asset ID first",Color3.fromRGB(255,80,80)); return end

        setS("⏳ Loading pixels for ID "..id.."…",Color3.fromRGB(255,200,50))
        prevImg.Image = "rbxassetid://"..id
        prevInfo.Text = "Loading…"; prevInfo.TextColor3 = Color3.fromRGB(255,200,50)

        task.spawn(function()
            local ok,res = pcall(function()
                local AS  = game:GetService("AssetService")
                local ei  = AS:CreateEditableImageAsync("rbxassetid://"..id)
                local W,H = ei.Size.X, ei.Size.Y
                local scale = math.min(1, 64/math.max(W,H))
                local sw = math.max(1,math.floor(W*scale))
                local sh = math.max(1,math.floor(H*scale))
                local small = Instance.new("EditableImage")
                small.Size = Vector2.new(sw,sh)
                small:DrawImage(Vector2.new(0,0), ei,
                    Enum.ImageCombineType.Overwrite)
                local buf = small:ReadPixelsBuffer(Vector2.new(0,0),Vector2.new(sw,sh))
                local px = {}
                for i=0,sw*sh-1 do
                    local b=i*4
                    px[#px+1]=buffer.readu8(buf,b)
                    px[#px+1]=buffer.readu8(buf,b+1)
                    px[#px+1]=buffer.readu8(buf,b+2)
                end
                small:Destroy(); ei:Destroy()
                return {w=sw,h=sh,pixels=px}
            end)

            if ok and res then
                DM.Image = res
                prevInfo.Text=("✅ %d×%d loaded\n%d pixels"):format(res.w,res.h,res.w*res.h)
                prevInfo.TextColor3=Color3.fromRGB(100,220,100)
                setS("✅ Ready — set canvas then Start!",Color3.fromRGB(100,220,100))
                NT_toast("DrawMe",res.w.."×"..res.h.." image loaded",C.AccentBrt)
            else
                DM.Image={stamp=true,id=id}
                prevInfo.Text="⚠ EditableImage unavailable\n(executor limitation)\nStamp drag-fill mode active"
                prevInfo.TextColor3=Color3.fromRGB(255,160,50)
                setS("Stamp mode (no pixel data — drag fill)",Color3.fromRGB(255,160,50))
                NT_toast("DrawMe","Pixel load failed — stamp mode",Color3.fromRGB(255,160,50))
            end
        end)
    end

