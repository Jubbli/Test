-- RUNTIME HEARTBEAT LOOP
-- ════════════════════════════════════════════════════════════════
RunService.Heartbeat:Connect(function()
    local char = getChar()
    if not char then return end
    local hum = getHum(char)
    local hrp = getHRP(char)

    -- FLY
    if S.Fly then
        if hrp and not S.FlyBV then
            S.FlyBV = New("BodyVelocity", {
                Velocity = Vector3.zero,
                MaxForce = Vector3.new(1e5, 1e5, 1e5),
            }, hrp)
            S.FlyBG = New("BodyGyro", {
                MaxTorque = Vector3.new(1e5, 1e5, 1e5),
                D         = 100,
            }, hrp)
        end
        if S.FlyBV and hrp then
            local cam = workspace.CurrentCamera
            local sp  = S.FlySpeed
            local v   = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W)           then v = v + cam.CFrame.LookVector  * sp end
            if UserInputService:IsKeyDown(Enum.KeyCode.S)           then v = v - cam.CFrame.LookVector  * sp end
            if UserInputService:IsKeyDown(Enum.KeyCode.A)           then v = v - cam.CFrame.RightVector * sp end
            if UserInputService:IsKeyDown(Enum.KeyCode.D)           then v = v + cam.CFrame.RightVector * sp end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space)       then v = v + Vector3.new(0, sp, 0)       end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then v = v - Vector3.new(0, sp, 0)       end
            S.FlyBV.Velocity = v
            S.FlyBG.CFrame   = cam.CFrame
            if hum then hum.PlatformStand = true end
        end
    end

    -- NO CLIP
    if S.NoClip then
        if hum then hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false) end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end

    -- RAINBOW
    if S.Rainbow then
        local t  = tick()
        local rc = Color3.new(
            math.sin(t)       * 0.5 + 0.5,
            math.sin(t + 2.1) * 0.5 + 0.5,
            math.sin(t + 4.2) * 0.5 + 0.5
        )
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.Color = rc end
        end
    end

    -- SPIN
    if S.Spin and hrp then
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(4), 0)
    end

    -- ANTI-VOID
    if S.AntiVoid and hrp and hrp.Position.Y < -80 then
        hrp.CFrame = CFrame.new(hrp.Position.X, 60, hrp.Position.Z)
    end

    -- GOD MODE
    if S.GodMode and hum then
        hum.Health = hum.MaxHealth
    end

    -- ESP (refreshed each frame so boxes auto-expire via Debris)
    if S.ESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= Player and plr.Character then
                local plrChar = plr.Character
                local root = plrChar:FindFirstChild("HumanoidRootPart")
                if root and not root:FindFirstChild("ESP_Box") then
                    local sb = New("SelectionBox", {
                        Name               = "ESP_Box",
                        Adornee            = plrChar,
                        Color3             = C.AccentBrt,
                        LineThickness      = 0.05,
                        SurfaceTransparency = 0.88,
                        SurfaceColor3      = C.Accent,
                    }, workspace)
                    Debris:AddItem(sb, 0.2)
                end
            end
        end
    end
end)

