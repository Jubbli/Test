                            TweenService:Create(gwFlash, TweenInfo.new(0.5), {ImageTransparency=1}):Play()
                        end)
                        task.delay(5, function() gwGui.Enabled = false end)
                    end
                    if not goatNow then GR_State.goatWarned = false end
                end

                -- Timer HUD
                if GR_State.timerHUDOn then
                    local timeVal = nil
                    local RS = game:GetService("ReplicatedStorage")
                    for _, n in ipairs({"Timer","TimeLeft","RoundTime","GameTimer"}) do
                        local v = workspace:FindFirstChild(n) or RS:FindFirstChild(n)
                        if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
                            timeVal = v.Value; break
                        end
                    end
                    if timeVal then
                        timerLbl.Text = string.format("⏱ %d:%02d",
                            math.floor(timeVal/60), math.floor(timeVal%60))
                        timerLbl.TextColor3 = timeVal < 30 and Color3.fromRGB(255,60,60)
                            or timeVal < 60 and Color3.fromRGB(255,200,0)
                            or Color3.fromRGB(255,220,120)
                    else
