    -- ── Toggle Logic ──────────────────────────────────────────
    local function toggleConsole(open)
        consoleOpen = open
        ciyWin.Visible = open
        miniLbl.TextColor3 = open and Color3.fromRGB(255,220,80) or C.Accent
        miniBar.BackgroundColor3 = open
            and Color3.fromRGB(30,20,5)
            or  Color3.fromRGB(14,7,7)
    end

    miniBar.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            toggleConsole(not consoleOpen)
        end
    end)
    ciyCloseBtn.MouseButton1Click:Connect(function()
        toggleConsole(false)
    end)

    -- Make window draggable
    local ciyDrag, ciyDS, ciyStartPos = false, nil, nil
    ciyTitle.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            ciyDrag=true; ciyDS=inp.Position; ciyStartPos=ciyWin.Position
        end
    end)
    ciyTitle.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then ciyDrag=false end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if not ciyDrag then return end
        if inp.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local d = inp.Position - ciyDS
        ciyWin.Position = UDim2.new(
            ciyStartPos.X.Scale, ciyStartPos.X.Offset + d.X,
            ciyStartPos.Y.Scale, ciyStartPos.Y.Offset + d.Y)
    end)
