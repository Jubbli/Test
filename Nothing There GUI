-- TAB: LIMBUS GAME  (Limbus Company on Roblox)
-- Ported + expanded from Nexer Hub.
-- The game stores Characters under workspace.Char, uses
-- ReplicatedStorage.Net.Character.Combat:FireServer({...})
-- for all combat actions. Identity modules live under
-- ReplicatedStorage.src.Identities[CharName][IdentityName]
-- ════════════════════════════════════════════════════════════════
safeTab("LimbusGame", function()
    local scroll = makeScrollFrame(TabFrames["LimbusGame"])

    -- ─── HELPERS ──────────────────────────────────────────────
    -- Limbus Company game-specific helpers
    local function LG_Combat(args)
        pcall(function()
            game:GetService("ReplicatedStorage")
                :WaitForChild("Net")
                :WaitForChild("Character")
                :WaitForChild("Combat")
                :FireServer(args)
        end)
    end

    local function LG_GetFolderID(char)
        local ok, result = pcall(function()
            return game:GetService("ReplicatedStorage").src.Identities
                [tostring(char:GetAttribute("Character"))]
                [tostring(char:GetAttribute("Identity"))]
        end)
        return ok and result or nil
    end

    local function LG_GetChar()
        return Player.Character
    end

    local function LG_GetHRP()
        local c = LG_GetChar()
        return c and c:FindFirstChild("HumanoidRootPart")
    end

    local function LG_GetHum()
        local c = LG_GetChar()
        return c and c:FindFirstChildOfClass("Humanoid")
    end

    local function LG_GetClosestEnemy()
        local myHRP = LG_GetHRP(); if not myHRP then return nil end
        local closest, closestDist = nil, math.huge
        -- Limbus stores player characters under workspace.Char
        local charFolder = workspace:FindFirstChild("Char")
        if charFolder then
            for _, v in ipairs(charFolder:GetChildren()) do
                if v.Name ~= Player.Name
                    and v:FindFirstChild("HumanoidRootPart")
                    and v:FindFirstChildOfClass("Humanoid") then
                    local dist = (v.HumanoidRootPart.Position - myHRP.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closest = v
                    end
                end
            end
        end
        return closest, closestDist
    end

    -- ─── INVISIBILITY ──────────────────────────────────────────
    makeSectionLabel(scroll, "INVISIBILITY", 1)

    do
        local invOn = false
        local invAnim = nil
        local invConn = nil
        local camConn = nil

        makeToggle(scroll, "Invisibility (Limbus Animation Method)",
            "Uses an LC animation (ID 71695001979420) that hides your character model", function(on)
            invOn = on
            local char = LG_GetChar()
            local hum  = LG_GetHum()
            local hrp  = LG_GetHRP()
            if not char or not hum or not hrp then
                showToast("Invis", "Character not found!", C.AccentBrt); return
            end
            if on then
                -- Noclip for other parts
                invConn = RunService.Stepped:Connect(function()
                    if not invOn then return end
                    for _, v in ipairs(char:GetDescendants()) do
                        if v:IsA("BasePart") and v.CanCollide and v.Name ~= "HumanoidRootPart" then
                            v.CanCollide = false
                        end
                    end
                end)
                -- Lock camera to HRP
                workspace.CurrentCamera.CameraSubject = hrp
                camConn = workspace.CurrentCamera:GetPropertyChangedSignal("CameraSubject"):Connect(function()
                    if invOn then workspace.CurrentCamera.CameraSubject = hrp end
                end)
                -- Load the invisibility animation
                local Anim = Instance.new("Animation")
                Anim.AnimationId = "rbxassetid://71695001979420"
                local loaded = hum:LoadAnimation(Anim)
                loaded.Priority = Enum.AnimationPriority.Action4
                repeat task.wait() until loaded.Length > 0
                loaded:Play()
                repeat task.wait() until loaded.IsPlaying
                loaded:AdjustSpeed(0)
                loaded.TimePosition = 0.65
                invAnim = loaded
                showToast("Invis", "Invisibility ON", C.Accent)
            else
                if invAnim then
                    pcall(function() invAnim:AdjustSpeed(0); invAnim:Stop(0) end)
                    invAnim = nil
                end
                if invConn then invConn:Disconnect(); invConn = nil end
                if camConn then
                    camConn:Disconnect(); camConn = nil
                    pcall(function()
                        workspace.CurrentCamera.CameraSubject = hum
                    end)
                end
