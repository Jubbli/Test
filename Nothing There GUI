    -- ── KEYBIND ───────────────────────────────────────────────
    makeSectionLabel(scroll, "ACTIVATION KEYBIND", 4)

    local kbCard = New("Frame", {
        Size=UDim2.new(1,0,0,36), BackgroundColor3=C.Secondary,
