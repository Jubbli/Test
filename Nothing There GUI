    -- ── ESP TASK (separate task.spawn — reloads periodically) ─
    local espBillboards = {}
    local function buildESP()
        for _, bb in ipairs(espBillboards) do pcall(function() bb:Destroy() end) end
        espBillboards = {}
        if not GR_State.espOn then return end
        for name, e in pairs(GR_State.entityCache) do
            local anchor = e.anchor
            if anchor then
                local bb = Instance.new("BillboardGui")
                bb.Name = "NT_GraceESP"
                bb.Size = UDim2.new(0,120,0,24)
                bb.StudsOffset = Vector3.new(0,4,0)
                bb.AlwaysOnTop = true
                bb.Parent = anchor
                local lbl = Instance.new("TextLabel", bb)
                lbl.Size = UDim2.new(1,0,1,0)
                lbl.BackgroundTransparency = 1
                lbl.TextColor3 = Color3.fromRGB(255,60,60)
                lbl.TextStrokeTransparency = 0.4
                lbl.Font = Enum.Font.GothamBold
                lbl.TextSize = 11
                lbl.Name = "GR_ESPLbl"
                lbl.Text = "⚠ "..name.." | "..math.floor(e.dist).."m"
                table.insert(espBillboards, bb)
            end
        end
    end
    -- Refresh ESP text from cache every 0.25 s (no FindFirstChild in loop)
    task.spawn(function()
        while true do
            task.wait(0.25)
            if GR_State.espOn then
                for _, bb in ipairs(espBillboards) do
                    if bb and bb.Parent then
                        local anchor = bb.Parent
                        local myHRP  = GR_GetHRP()
                        if myHRP then
                            local dist = (anchor.Position - myHRP.Position).Magnitude
                            local lbl = bb:FindFirstChild("GR_ESPLbl")
                            local name = bb.Parent.Parent and bb.Parent.Parent.Name or "?"
                            if lbl then
                                lbl.Text = "⚠ "..name.." | "..math.floor(dist).."m"
                                lbl.TextColor3 = dist < 30 and Color3.fromRGB(255,30,30)
                                    or dist < 70 and Color3.fromRGB(255,150,0)
                                    or Color3.fromRGB(200,200,200)
                            end
                        end
                    end
                end
            end
        end
    end)

