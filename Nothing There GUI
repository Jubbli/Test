local function makeToggle(parent, title, desc, callback, order)
    local h = desc and 52 or 38
    local card = New("Frame", {
        Size             = UDim2.new(1, 0, 0, h),
        BackgroundColor3 = C.Secondary,
        BorderSizePixel  = 0,
        LayoutOrder      = order or 0,
    }, parent)
    Corner(6, card)
    Stroke(C.Border, 0.5, card)

    New("TextLabel", {
        Text                   = title,
        Size                   = UDim2.new(1, -60, 0, 20),
        Position               = UDim2.new(0, 10, 0, desc and 6 or 9),
        BackgroundTransparency = 1,
        TextColor3             = C.Text,
        Font                   = Enum.Font.GothamBold,
        TextSize               = 11,
        TextXAlignment         = Enum.TextXAlignment.Left,
    }, card)

    if desc then
        New("TextLabel", {
            Text                   = desc,
            Size                   = UDim2.new(1, -60, 0, 16),
            Position               = UDim2.new(0, 10, 0, 28),
            BackgroundTransparency = 1,
            TextColor3             = C.TextDim,
            Font                   = Enum.Font.Gotham,
            TextSize               = 9,
            TextXAlignment         = Enum.TextXAlignment.Left,
        }, card)
    end

    local toggled = false
    local tb = New("TextButton", {
        Text             = "OFF",
        Size             = UDim2.new(0, 42, 0, 20),
        Position         = UDim2.new(1, -52, 0, h / 2 - 10),
        BackgroundColor3 = Color3.fromRGB(50, 50, 50),
        TextColor3       = C.TextDim,
        Font             = Enum.Font.GothamBold,
        TextSize         = 9,
        BorderSizePixel  = 0,
    }, card)
    Corner(4, tb)

    tb.MouseButton1Click:Connect(function()
        toggled = not toggled
        tb.Text             = toggled and "ON"  or "OFF"
        tb.BackgroundColor3 = toggled and C.Accent or Color3.fromRGB(50, 50, 50)
        tb.TextColor3       = toggled and Color3.fromRGB(255, 200, 200) or C.TextDim
        callback(toggled)
    end)
    return card, tb
end

