    local function ciyLog(msg)
        if ciyEcho then
            ciyOutput.Text = ">> "..msg
        end
        showToast("Custom IY", msg, C.Accent)
    end

    -- ── Command Definitions ────────────────────────────────────
    local CIY_COMMANDS = {
        -- Movement
        { cat="MOVEMENT", name="Speed x2",       desc="WalkSpeed = 32",
          run=function() local h=getHum(getChar()); if h then h.WalkSpeed=32 end ciyLog("Speed x2 set") end },
