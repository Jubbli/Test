    local trackerRows = {} -- playerName -> Frame

    local function updateTracker()
        if not trackerGui.Enabled then return end

        local myHRP = getHRP(getChar())

        for _, plr in ipairs(Players:GetPlayers()) do
            local pname = plr.Name
            if not trackerRows[pname] then
                local row = New("Frame", {
                    Name             = pname,
                    Size             = UDim2.new(1, -6, 0, 44),
                    BackgroundColor3 = C.Secondary,
