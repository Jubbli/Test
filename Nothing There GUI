    makeSectionLabel(scroll, "KILL SWITCH", 1)

    local killInfoCard = New("Frame",{
        Size=UDim2.new(1,0,0,52), BackgroundColor3=C.Secondary,
        BorderSizePixel=0, LayoutOrder=2,
    }, scroll); Corner(6, killInfoCard); Stroke(C.AccentBrt, 1, killInfoCard)
    New("TextLabel",{
        Text="Sets _G.NTG_KILL = true. All GUI instances running this\nscript will detect the flag within 2 seconds and self-destruct.\nAttempts MessagingService broadcast for cross-session kills.",
        Size=UDim2.new(1,-12,1,0), Position=UDim2.new(0,6,0,0),
        BackgroundTransparency=1, TextColor3=C.TextDim,
        Font=Enum.Font.Code, TextSize=8,
        TextXAlignment=Enum.TextXAlignment.Left, TextWrapped=true,
    }, killInfoCard)

    makeButton(scroll, "☠  KILL ALL GUI INSTANCES", function()
        _G.NTG_KILL = true
        pcall(function()
            game:GetService("MessagingService"):PublishAsync(_G.NTG_KILL_KEY, "kill")
        end)
        showToast("DEV", "Kill switch sent — other instances will self-destruct. You are immune.", Color3.fromRGB(255,140,0))
    end, 3)

    makeButton(scroll, "↺  RESET KILL SWITCH (re-enable GUIs)", function()
        _G.NTG_KILL = false
        showToast("DEV", "Kill switch reset — GUIs will load normally on next run", Color3.fromRGB(60,220,80))
    end, 3)

    makeSectionLabel(scroll, "LIVE SCRIPT EDITOR", 4)

    local editorWarning = New("TextLabel",{
        Text="⚠ Direct loadstring execution. Errors will appear in output.\nPaste or type any Lua code and hit Execute.",
        Size=UDim2.new(1,0,0,28), BackgroundTransparency=1,
        TextColor3=Color3.fromRGB(255,180,0), Font=Enum.Font.Code,
        TextSize=8, TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left,
        LayoutOrder=5,
    }, scroll)

    local editorBg = New("Frame",{
        Size=UDim2.new(1,0,0,160), BackgroundColor3=Color3.fromRGB(5,3,3),
        BorderSizePixel=0, LayoutOrder=6,
    }, scroll); Corner(4, editorBg); Stroke(C.Accent,1,editorBg)
    local codeBox = Instance.new("TextBox")
    codeBox.Name               = "LiveCodeBox"
    codeBox.MultiLine          = true
    codeBox.ClearTextOnFocus   = false
    codeBox.Text               = "-- Type your Lua code here\nprint(\"Hello from NTG Dev Panel\")"
    codeBox.Size               = UDim2.new(1,-10,1,-10)
    codeBox.Position           = UDim2.new(0,5,0,5)
    codeBox.BackgroundTransparency = 1
    codeBox.TextColor3         = Color3.fromRGB(180,240,180)
    codeBox.Font               = Enum.Font.Code
    codeBox.TextSize           = 10
    codeBox.TextXAlignment     = Enum.TextXAlignment.Left
    codeBox.TextYAlignment     = Enum.TextYAlignment.Top
    codeBox.TextWrapped        = true
    codeBox.Parent             = editorBg

    local outputBg = New("Frame",{
        Size=UDim2.new(1,0,0,60), BackgroundColor3=Color3.fromRGB(3,3,8),
        BorderSizePixel=0, LayoutOrder=7,
    }, scroll); Corner(4, outputBg); Stroke(Color3.fromRGB(30,30,80),1,outputBg)
    local outputLbl = New("TextLabel",{
        Text="[Output will appear here]",
        Size=UDim2.new(1,-10,1,-6), Position=UDim2.new(0,5,0,3),
        BackgroundTransparency=1,
        TextColor3=Color3.fromRGB(160,200,255), Font=Enum.Font.Code,
        TextSize=9, TextWrapped=true,
        TextXAlignment=Enum.TextXAlignment.Left,
        TextYAlignment=Enum.TextYAlignment.Top,
    }, outputBg)

    makeButton(scroll, "▶  Execute Code", function()
        local src = codeBox.Text
        if src == "" then return end
        local fn, compileErr = loadstring(src)
        if not fn then
            outputLbl.Text    = "COMPILE ERROR:\n"..tostring(compileErr)
            outputLbl.TextColor3 = Color3.fromRGB(255,80,80)
            showToast("DEV Editor", "Compile error", C.AccentBrt)
            return
        end
        local ok, runErr = pcall(fn)
        if ok then
            outputLbl.Text       = "[Executed successfully at "..os.date("%H:%M:%S").."]"
            outputLbl.TextColor3 = Color3.fromRGB(60,220,80)
            showToast("DEV Editor", "Executed OK", Color3.fromRGB(60,220,80))
        else
            outputLbl.Text       = "RUNTIME ERROR:\n"..tostring(runErr)
            outputLbl.TextColor3 = Color3.fromRGB(255,80,80)
            showToast("DEV Editor", "Runtime error", C.AccentBrt)
        end
    end, 8)

    makeButton(scroll, "Clear Editor", function()
        codeBox.Text     = ""
        outputLbl.Text   = "[Cleared]"
        outputLbl.TextColor3 = C.TextDim
    end, 8)

    makeSectionLabel(scroll, "PLAYER MANAGEMENT", 9)

    local devTargetIdx = 1
    local function getDevTargetList()
        local t = {}
        for _, p in ipairs(Players:GetPlayers()) do table.insert(t, p) end
        return t
    end

    local devTargetLbl = New("TextLabel",{
        Text="Target: (all players)", Size=UDim2.new(1,0,0,20),
        BackgroundTransparency=1, TextColor3=C.TextDim,
        Font=Enum.Font.Code, TextSize=10, LayoutOrder=10,
        TextXAlignment=Enum.TextXAlignment.Left,
    }, scroll)

    local devNavRow = New("Frame",{
        Size=UDim2.new(1,0,0,28), BackgroundTransparency=1,
        BorderSizePixel=0, LayoutOrder=10,
    }, scroll)
    New("UIListLayout",{FillDirection=Enum.FillDirection.Horizontal,Padding=UDim.new(0,4)},devNavRow)
    local devPrev = New("TextButton",{
        Text="◀ Prev", Size=UDim2.new(0.48,0,1,0),
        BackgroundColor3=C.Btn, TextColor3=C.Text,
        Font=Enum.Font.GothamBold, TextSize=10, BorderSizePixel=0, LayoutOrder=1,
    }, devNavRow); Corner(4, devPrev)
    local devNext = New("TextButton",{
        Text="Next ▶", Size=UDim2.new(0.48,0,1,0),
        BackgroundColor3=C.Btn, TextColor3=C.Text,
        Font=Enum.Font.GothamBold, TextSize=10, BorderSizePixel=0, LayoutOrder=2,
    }, devNavRow); Corner(4, devNext)

    local function updateDevTarget(off)
        local list = getDevTargetList()
        if #list == 0 then return end
        devTargetIdx = ((devTargetIdx - 1 + off) % #list) + 1
        devTargetLbl.Text = "Target: "..list[devTargetIdx].Name
    end
    devPrev.MouseButton1Click:Connect(function() updateDevTarget(-1) end)
    devNext.MouseButton1Click:Connect(function() updateDevTarget(1) end)

    makeButton(scroll, "Teleport Target Off Map", function()
        local list = getDevTargetList()
        if #list == 0 then return end
        local tgt = list[math.min(devTargetIdx, #list)]
        if tgt == Player then showToast("DEV", "Can't target yourself!", C.AccentBrt); return end
        pcall(function()
            local hrp = getHRP(tgt.Character)
            if hrp then hrp.CFrame = CFrame.new(0, -9999, 0) end
        end)
        showToast("DEV", "Sent "..tgt.Name.." off-map", C.AccentBrt)
    end, 11)

    makeButton(scroll, "Freeze / Unfreeze Target", function()
        local list = getDevTargetList()
        if #list == 0 then return end
        local tgt = list[math.min(devTargetIdx, #list)]
        if tgt == Player then return end
        pcall(function()
            local hrp = getHRP(tgt.Character)
            if hrp then
                hrp.Anchored = not hrp.Anchored
                showToast("DEV", tgt.Name.." Anchored: "..tostring(hrp.Anchored), C.Accent)
            end
        end)
    end, 11)

    makeSectionLabel(scroll, "DEV INFO", 12)
    local devInfoCard = New("Frame",{
        Size=UDim2.new(1,0,0,60), BackgroundColor3=C.Secondary,
        BorderSizePixel=0, LayoutOrder=13,
    }, scroll); Corner(6, devInfoCard); Stroke(C.Accent,1,devInfoCard)
    New("TextLabel",{
        Text="DEV: "..Player.Name.."\nGame: "..game.Name.."\nJobID: "..game.JobId:sub(1,18).."...\nPlayers: "..#Players:GetPlayers(),
        Size=UDim2.new(1,-12,1,0), Position=UDim2.new(0,6,0,0),
        BackgroundTransparency=1, TextColor3=C.TextDim,
        Font=Enum.Font.Code, TextSize=9,
        TextXAlignment=Enum.TextXAlignment.Left, TextWrapped=true,
    }, devInfoCard)

    makeSectionLabel(scroll, "TROLL LIST EDITOR", 14)

    New("TextLabel",{
        Text='Troll list: these users always say the bum message\nwhen chatSay() is called. Add/remove usernames at runtime.',
        Size=UDim2.new(1,0,0,28), BackgroundTransparency=1,
        TextColor3=C.TextDim, Font=Enum.Font.Code, TextSize=8,
        TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left,
        LayoutOrder=14,
    }, scroll)

    local LIVE_TROLL = { MissingSelzure=true, mister7262628alt=true }
    _G.NTG_TrollList = LIVE_TROLL

    local trollBg = New("Frame",{
        Size=UDim2.new(1,0,0,80), BackgroundColor3=Color3.fromRGB(5,3,3),
        BorderSizePixel=0, LayoutOrder=15,
    }, scroll); Corner(4, trollBg); Stroke(C.Accent,0.8,trollBg)
    local trollLbl = New("TextLabel",{
        Text="Loading...",
        Size=UDim2.new(1,-10,1,-8), Position=UDim2.new(0,5,0,4),
        BackgroundTransparency=1, TextColor3=Color3.fromRGB(255,120,120),
        Font=Enum.Font.Code, TextSize=9,
        TextXAlignment=Enum.TextXAlignment.Left,
        TextYAlignment=Enum.TextYAlignment.Top, TextWrapped=true,
    }, trollBg)

    local function refreshTrollDisplay()
        local names = {}
        for n in pairs(LIVE_TROLL) do table.insert(names, n) end
        table.sort(names)
        trollLbl.Text = #names == 0 and "(empty)" or table.concat(names, "\n")
    end
    refreshTrollDisplay()

    local _, addTrollBox = makeInput(scroll, "Add Username to Troll List", "Username to add...", 16)
    makeButton(scroll, "Add to Troll List", function()
        local name = (addTrollBox.Text or ""):match("^%s*(.-)%s*$")
        if name == "" then return end
        LIVE_TROLL[name] = true
        _G.NTG_TrollList = LIVE_TROLL
        addTrollBox.Text = ""
        refreshTrollDisplay()
        showToast("Troll List", "Added: "..name, C.AccentBrt)
    end, 16)

    local _, remTrollBox = makeInput(scroll, "Remove from Troll List", "Username to remove...", 17)
    makeButton(scroll, "Remove from Troll List", function()
        local name = (remTrollBox.Text or ""):match("^%s*(.-)%s*$")
        if name == "" then return end
        LIVE_TROLL[name] = nil
        _G.NTG_TrollList = LIVE_TROLL
        remTrollBox.Text = ""
        refreshTrollDisplay()
        showToast("Troll List", "Removed: "..name, C.TextDim)
    end, 17)

    makeButton(scroll, "Clear Entire Troll List", function()
        for k in pairs(LIVE_TROLL) do LIVE_TROLL[k] = nil end
        _G.NTG_TrollList = LIVE_TROLL
        refreshTrollDisplay()
        showToast("Troll List", "Cleared", C.TextDim)
    end, 17)

    makeSectionLabel(scroll, "SERVER TOOLS", 18)

    makeButton(scroll, "Copy JobId to Clipboard", function()
        setclipboard(game.JobId)
        showToast("DEV", "JobId copied", C.Accent)
    end, 19)

    makeButton(scroll, "Copy Player List (Name+UserId)", function()
        local lines = {}
        for _, p in ipairs(Players:GetPlayers()) do
            table.insert(lines, p.Name.." ("..p.UserId..")")
        end
        setclipboard(table.concat(lines, "\n"))
        showToast("DEV", "Copied "..#lines.." players", C.Accent)
    end, 19)

    do
        local _, sysBox = makeInput(scroll, "Broadcast Chat Message", "Message to send...", 20)
        makeButton(scroll, "Broadcast Chat", function()
            local msg = sysBox.Text or ""
            if msg == "" then return end
            chatSay(msg)
            showToast("DEV Broadcast", msg:sub(1,40), C.Accent)
        end, 20)
    end

    makeButton(scroll, "Force Respawn Self", function()
        pcall(function() Player:LoadCharacter() end)
        showToast("DEV", "Respawning...", C.Accent)
    end, 20)

    makeButton(scroll, "Dump Workspace Tree (Output)", function()
        pcall(function()
            local function dump(obj, d)
                if d > 3 then return end
                print(string.rep("  ",d)..obj.ClassName..": "..obj.Name)
                for _, c in ipairs(obj:GetChildren()) do dump(c, d+1) end
            end
            dump(workspace, 0)
        end)
        showToast("DEV", "Workspace tree in Output", C.Accent)
    end, 21)

    makeSectionLabel(scroll, "PLAYER INSPECTOR", 22)

    do
        local inspectIdx = 1
        local inspBg = New("Frame",{
            Size=UDim2.new(1,0,0,90), BackgroundColor3=Color3.fromRGB(5,3,3),
            BorderSizePixel=0, LayoutOrder=23,
        }, scroll); Corner(4, inspBg); Stroke(C.Accent,0.8,inspBg)
        local inspectLbl = New("TextLabel",{
            Text="Select a player to inspect",
            Size=UDim2.new(1,-10,1,-8), Position=UDim2.new(0,5,0,4),
            BackgroundTransparency=1, TextColor3=C.TextDim,
            Font=Enum.Font.Code, TextSize=9,
            TextXAlignment=Enum.TextXAlignment.Left,
            TextYAlignment=Enum.TextYAlignment.Top, TextWrapped=true,
        }, inspBg)

        local inspNavRow = New("Frame",{
            Size=UDim2.new(1,0,0,26), BackgroundTransparency=1,
            BorderSizePixel=0, LayoutOrder=23,
        }, scroll)
        New("UIListLayout",{FillDirection=Enum.FillDirection.Horizontal,Padding=UDim.new(0,4)},inspNavRow)
        local function mkIBtn(txt, lo)
            local b = New("TextButton",{Text=txt,Size=UDim2.new(0.32,0,1,0),
                BackgroundColor3=C.Btn,TextColor3=C.Text,Font=Enum.Font.GothamBold,TextSize=9,
                BorderSizePixel=0,LayoutOrder=lo},inspNavRow); Corner(4,b); return b
        end
        local inspPrev    = mkIBtn("Prev",1)
        local inspNext    = mkIBtn("Next",2)
        local inspRefresh = mkIBtn("Refresh",3)

        local function refreshInspect()
            local list = Players:GetPlayers()
            if #list == 0 then inspectLbl.Text = "(no players)"; return end
            inspectIdx = math.clamp(inspectIdx, 1, #list)
            local p   = list[inspectIdx]
            local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            local pos = hrp and hrp.Position or Vector3.new(0,0,0)
            inspectLbl.Text = string.format(
                "%s (uid:%d)\nHP: %d/%d\nPos: %.0f,%.0f,%.0f\nAccount: %s",
                p.Name, p.UserId,
                hum and math.floor(hum.Health) or 0,
                hum and math.floor(hum.MaxHealth) or 100,
                pos.X, pos.Y, pos.Z,
                p.AccountAge.."d old"
            )
        end
        inspPrev.MouseButton1Click:Connect(function()
            local n = #Players:GetPlayers()
            inspectIdx = ((inspectIdx-2) % math.max(n,1)) + 1; refreshInspect()
        end)
        inspNext.MouseButton1Click:Connect(function()
            local n = #Players:GetPlayers()
            inspectIdx = (inspectIdx % math.max(n,1)) + 1; refreshInspect()
        end)
        inspRefresh.MouseButton1Click:Connect(refreshInspect)

        makeButton(scroll, "Copy Inspected Player Position", function()
            local list = Players:GetPlayers()
            if #list == 0 then return end
            local p = list[math.clamp(inspectIdx,1,#list)]
            local hrp = getHRP(p.Character)
            if hrp then
                setclipboard(string.format("Vector3.new(%.2f,%.2f,%.2f)",
                    hrp.Position.X, hrp.Position.Y, hrp.Position.Z))
                showToast("DEV", "Pos of "..p.Name.." copied", C.Accent)
            end
        end, 24)
    end

    makeSectionLabel(scroll, "GAME MANIPULATION", 25)

    do
        local deleteOn = false
        makeToggle(scroll, "Delete Part on Click",
            "Click any workspace part to locally destroy it", function(on)
            deleteOn = on
            showToast("DEV", on and "Click parts to delete" or "Delete OFF", C.Accent)
        end, 26)
        UserInputService.InputBegan:Connect(function(inp, gp)
            if gp or not deleteOn then return end
            if inp.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            pcall(function()
                local mouse = Player:GetMouse()
                local inst = mouse.Target
                if inst and not Players:GetPlayerFromCharacter(inst.Parent) then
                    inst:Destroy()
                    showToast("DEV", "Deleted: "..inst.Name, C.Accent)
                end
            end)
        end)
    end

    makeButton(scroll, "Load Infinite Yield (Quick)", function()
        task.spawn(function()
            pcall(function()
                loadstring(game:HttpGet("https://rawscripts.net/raw/Universal-Script-Infinite-Yield-43437"))()
            end)
        end)
        showToast("DEV", "Loading IY...", C.Accent)
    end, 26)

    do
        local fbDOn = false; local origBrightD = Lighting.Brightness
        makeToggle(scroll, "Fullbright",
            "Lighting.Brightness = 10 everywhere", function(on)
            fbDOn = on
            Lighting.Brightness = on and 10 or origBrightD
            showToast("DEV", on and "Fullbright ON" or "Fullbright OFF", C.Accent)
        end, 27)
    end

    do
        local noFogOn = false
        makeToggle(scroll, "Remove All Fog",
            "Sets FogEnd to 100,000 — removes fog entirely", function(on)
            noFogOn = on
            Lighting.FogEnd   = on and 100000 or 1000
            Lighting.FogStart = 0
            showToast("DEV", on and "Fog removed" or "Fog restored to 1000", C.Accent)
        end, 27)
    end

    makeButton(scroll, "Screenshot Overlay (3s burn-in)", function()
        local ovGui = New("ScreenGui",{
            Name="NT_SSOvr", ResetOnSpawn=false, IgnoreGuiInset=true, ZIndex=9998,
        }, PlayerGui)
        New("TextLabel",{
            Text=Player.Name.." | NothingThereGUI | "..os.date("%Y-%m-%d %H:%M"),
            Size=UDim2.new(1,0,0,22), Position=UDim2.new(0,0,1,-24),
            BackgroundColor3=Color3.fromRGB(0,0,0), BackgroundTransparency=0.4,
            TextColor3=Color3.new(1,1,1), Font=Enum.Font.Code, TextSize=11,
            ZIndex=9999,
        }, ovGui)
        task.delay(3, function() ovGui:Destroy() end)
        showToast("DEV", "Overlay shown for 3s", C.Accent)
    end, 28)

    makeSectionLabel(scroll, "ADVANCED DEV TOOLS", 30)

    makeButton(scroll, "List All Remotes (Output)", function()
        pcall(function()
            local count = 0
            local function scan(obj, path)
                for _, c in ipairs(obj:GetChildren()) do
                    local p = path.."."..c.Name
                    if c:IsA("RemoteEvent") or c:IsA("RemoteFunction") or c:IsA("BindableEvent") then
                        print("[REMOTE] "..c.ClassName.." | "..p)
                        count = count + 1
                    end
                    scan(c, p)
                end
            end
            scan(game:GetService("ReplicatedStorage"), "RS")
            pcall(function() scan(workspace, "WS") end)
            showToast("DEV", count.." remotes found — check output", C.Accent)
        end)
    end, 31)

    do
        local devSpeedOn = false
        makeToggle(scroll, "Speed Hack (Dev precision)",
            "Precise WalkSpeed control — bypasses S.SpeedValue", function(on)
            devSpeedOn = on
            showToast("DEV Speed", on and "Active" or "OFF", C.Accent)
        end, 31)
        makeSlider(scroll, "WalkSpeed (1–500)", 1, 500, 1, 16, function(v)
            if devSpeedOn then
                pcall(function()
                    local hum = getHum(getChar())
                    if hum then hum.WalkSpeed = v end
                end)
            end
        end, 31)
    end

    do
        local devJumpOn = false
        makeToggle(scroll, "Jump Power Hack", "Precise JumpPower control", function(on)
            devJumpOn = on
            showToast("DEV Jump", on and "Active" or "OFF", C.Accent)
        end, 32)
        makeSlider(scroll, "JumpPower (0–500)", 0, 500, 5, 50, function(v)
            if devJumpOn then
                pcall(function()
                    local hum = getHum(getChar())
                    if hum then hum.JumpPower = v end
                end)
            end
        end, 32)
    end

    makeButton(scroll, "Scale Character to 0.1x (tiny)", function()
        pcall(function()
            local hum = getHum(getChar())
            if hum then
                hum.BodyDepthScale.Value  = 0.1
                hum.BodyHeightScale.Value = 0.1
                hum.BodyWidthScale.Value  = 0.1
                hum.HeadScale.Value       = 0.1
            end
        end)
        showToast("DEV", "Tiny mode ON", C.Accent)
    end, 32)
    makeButton(scroll, "Scale Character to 3x (giant)", function()
        pcall(function()
            local hum = getHum(getChar())
            if hum then
                hum.BodyDepthScale.Value  = 3
                hum.BodyHeightScale.Value = 3
                hum.BodyWidthScale.Value  = 3
                hum.HeadScale.Value       = 3
            end
        end)
        showToast("DEV", "Giant mode ON", C.Accent)
    end, 32)
    makeButton(scroll, "Reset Character Scale", function()
        pcall(function()
            local hum = getHum(getChar())
            if hum then
                hum.BodyDepthScale.Value  = 1
                hum.BodyHeightScale.Value = 1
                hum.BodyWidthScale.Value  = 1
                hum.HeadScale.Value       = 1
            end
        end)
        showToast("DEV", "Scale reset", C.TextDim)
    end, 32)

    do
        local ffOn = false; local ffPart = nil
        makeToggle(scroll, "ForceField Self",
            "Applies a ForceField to your character — blocks damage in supported games", function(on)
            ffOn = on
            pcall(function()
                local char = getChar(); if not char then return end
                if on then
                    if not char:FindFirstChildOfClass("ForceField") then
                        Instance.new("ForceField", char)
                    end
                else
                    local ff = char:FindFirstChildOfClass("ForceField")
                    if ff then ff:Destroy() end
                end
            end)
            showToast("DEV ForceField", on and "FF ON" or "FF OFF", C.Accent)
        end, 33)
    end

    do
        local antiAfkOn = false
        makeToggle(scroll, "Anti-AFK (prevent kick)",
            "Simulates input every 15s to prevent the AFK kick", function(on)
            antiAfkOn = on
            showToast("DEV", on and "Anti-AFK ON" or "Anti-AFK OFF", C.Accent)
            if on then
                task.spawn(function()
                    while antiAfkOn do
                        pcall(function()
                            local VIM = game:GetService("VirtualInputManager")
                            VIM:SendKeyEvent(true,  Enum.KeyCode.ButtonR3, false, game)
                            VIM:SendKeyEvent(false, Enum.KeyCode.ButtonR3, false, game)
                        end)
                        task.wait(15)
                    end
                end)
            end
        end, 33)
    end

    do
        local _, safeChatBox = makeInput(scroll, "Test Chat Filter", "Type text to test...", 34)
        makeButton(scroll, "Check Text Filter", function()
            local txt = safeChatBox.Text or ""
            if txt == "" then return end
            pcall(function()
                local TFS = game:GetService("TextService")
                local result = TFS:FilterStringAsync(txt, Player.UserId,
                    Enum.TextFilterContext.PublicChat)
                local filtered = result:GetNonChatStringForBroadcastAsync()
                showToast("Filter Result", filtered, C.Accent)
                outputLbl = nil -- just use toast
            end)
        end, 34)
    end

    makeButton(scroll, "Print Game Time Info", function()
        local info = string.format(
            "Lighting Time: %s\nBrightness: %.1f\nFogEnd: %.0f\nClockTime: %.2f\nGeographicLat: %.1f",
            Lighting.TimeOfDay, Lighting.Brightness,
            Lighting.FogEnd, Lighting.ClockTime,
            Lighting.GeographicLatitude
        )
        setclipboard(info)
        showToast("DEV", "Time info copied to clipboard", C.Accent)
        print("[NTG DEV] "..info)
    end, 35)

    do
        local remoteSpyOn = false
        local remoteLog = {}
        makeToggle(scroll, "Remote Spy (log FireServer calls)",
            "Hooks RemoteEvent:FireServer and logs calls to output", function(on)
            remoteSpyOn = on
            if on then
                pcall(function()
                    local oldFire = game.ReplicatedStorage.FireServer
                    local function hookRemote(re)
