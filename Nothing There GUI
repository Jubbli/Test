            BackgroundColor3=Color3.fromRGB(60,220,255), BorderSizePixel=0, ZIndex=92,
        }, radarFr); Corner(4, playerDot)
        -- Entity dots pool
        local radarDots = {}
        for i = 1, 15 do
            local dot = New("Frame", {
                Size=UDim2.new(0,5,0,5), Position=UDim2.new(0.5,0,0.5,0),
                BackgroundColor3=Color3.fromRGB(255,60,60), BorderSizePixel=0,
                ZIndex=91, Visible=false,
            }, radarFr); Corner(4, dot)
            table.insert(radarDots, dot)
        end
        makeToggle(scroll, "2D Entity Radar (corner minimap)",
            "Bottom-right mini-map showing entity positions relative to you — 0.25 s updates", function(on)
            radarOn = on; radarGui.Enabled = on
        end, 17)
        local radarRange = 100
        makeSlider(scroll, "Radar Range (studs)", 20, 300, 10, 100, function(v) radarRange = v end, 17)
        task.spawn(function()
            while true do
                task.wait(0.25)
                if not radarOn then continue end
                pcall(function()
                    local hrp = GR_GetHRP(); if not hrp then return end
                    local myPos = hrp.Position
                    local myCF  = hrp.CFrame
                    local idx   = 0
                    for name, e in pairs(GR_State.entityCache) do
                        if e.anchor and e.dist <= radarRange then
                            idx = idx + 1
                            if idx > #radarDots then break end
                            local dot = radarDots[idx]
                            dot.Visible = true
                            -- Radar space: project world offset onto local XZ plane
                            local offset = e.anchor.Position - myPos
                            local localX = myCF.RightVector:Dot(offset)
                            local localZ = myCF.LookVector:Dot(offset)
                            local nx = 0.5 + (localX / radarRange) * 0.45
                            local ny = 0.5 - (localZ / radarRange) * 0.45
                            dot.Position = UDim2.new(
                                math.clamp(nx,0.05,0.95), -2,
                                math.clamp(ny,0.05,0.95), -2
                            )
                            dot.BackgroundColor3 = e.dist < 30
                                and Color3.fromRGB(255,30,30)
                                or  Color3.fromRGB(255,150,0)
                        end
                    end
                    -- Hide unused dots
                    for i = idx+1, #radarDots do radarDots[i].Visible = false end
                end)
            end
        end)
    end

