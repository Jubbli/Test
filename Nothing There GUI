local NTG_KeyBinds = {}   -- { label, key, callback, btnRef }

local function NT_RegisterKeybind(label, callback)
    local entry = { label = label, key = nil, callback = callback, btnRef = nil }
    table.insert(NTG_KeyBinds, entry)
    local function setKey(kc)
        for _, e in ipairs(NTG_KeyBinds) do
            if e ~= entry and e.key == kc then
                showToast("⚠ Keybind Conflict",
                    kc.Name.." already bound to: "..e.label,
                    Color3.fromRGB(255,100,0))
                return false
            end
        end
        entry.key = kc
        if entry.btnRef then
            entry.btnRef.Text = kc.Name
        end
        return true
    end
    return entry, setKey
end

UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    for _, e in ipairs(NTG_KeyBinds) do
        if e.key and inp.KeyCode == e.key then
            pcall(e.callback)
        end
    end
end)

