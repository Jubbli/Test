for _, t in ipairs(TABS) do
    local isDevTab = (t.name == "Dev")
    if isDevTab and not IS_DEV then
        local frame = New("Frame", {
            Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
            Visible=false, ClipsDescendants=true,
        }, ContentArea)
        TabFrames[t.name] = frame
    else
        local btn = New("TextButton", {
            Text             = t.icon .. "  " .. t.name,
            Size             = UDim2.new(1, 0, 0, 40),
            BackgroundColor3 = isDevTab and Color3.fromRGB(30,0,50) or C.TabInactive,
            TextColor3       = isDevTab and Color3.fromRGB(200,100,255) or C.TextDim,
            Font             = Enum.Font.Gotham,
