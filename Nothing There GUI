    do
        local accumSlow = 0
        local accumMed  = 0
        RunService.Heartbeat:Connect(function(dt)
            accumSlow = accumSlow + dt
            accumMed  = accumMed  + dt

            -- ── FAST LANE (every frame, light ops only) ───────
            local hrp = GR_GetHRP()
            local hum = GR_GetHum()

            -- Sprint lock
            if GR_State.sprintOn and hum and hum.WalkSpeed < GR_State.sprintSpeed then
                hum.WalkSpeed = GR_State.sprintSpeed
            end

            -- God mode
            if GR_State.godOn and hum and hum.Health < hum.MaxHealth then
                hum.Health = hum.MaxHealth
            end

            -- Noclip (character parts)
            if GR_State.noclipOn and hrp then
                pcall(function()
                    for _, v in ipairs(hrp.Parent:GetChildren()) do
                        if v:IsA("BasePart") and v.CanCollide then
                            v.CanCollide = false
                        end
                    end
                end)
            end

            -- Anti-void
            if GR_State.antiVoidOn and hrp and hrp.Position.Y < GR_State.voidThreshold then
                hrp.CFrame = hrp.CFrame * CFrame.new(0, math.abs(GR_State.voidThreshold)+20, 0)
                showToast("Anti-Void", "Teleported up!", C.AccentBrt)
            end

            -- Dozer freeze (uses cache — no FindFirstChild here)
            if GR_State.dozerFreezeOn and hum then
                local dozerEntry = GR_State.entityCache["Dozer"]
                local dozerNow   = dozerEntry ~= nil
                if dozerNow and not GR_State.prevDozerEx then
                    GR_State.savedDozerSpeed = hum.WalkSpeed
                    GR_State.frozenByDozer   = true
                    showToast("DOZER!", "🟡 FREEZE — don't move!", Color3.fromRGB(255,220,0))
                end
                if not dozerNow and GR_State.prevDozerEx and GR_State.frozenByDozer then
                    GR_State.frozenByDozer = false
                    hum.WalkSpeed = GR_State.savedDozerSpeed
                    showToast("Dozer gone", "Safe to move again", C.TextDim)
                end
                if GR_State.frozenByDozer then hum.WalkSpeed = 0 end
                GR_State.prevDozerEx = dozerNow
            end

            -- Carnation crouch
            if GR_State.carnOn and hum then
                local carnNow = GR_State.entityCache["Carnation"] ~= nil
                if carnNow and not GR_State.prevCarnEx then
                    GR_State.savedCarnHip = hum.HipHeight
                    showToast("CARNATION!", "🌸 Keep moving!", Color3.fromRGB(255,130,200))
                end
                if not carnNow and GR_State.prevCarnEx then
                    hum.HipHeight = GR_State.savedCarnHip
                    showToast("Carnation gone", "Standing up", C.TextDim)
                end
                if carnNow then hum.HipHeight = 0 end
                GR_State.prevCarnEx = carnNow
            end

            -- Sorrow alert
