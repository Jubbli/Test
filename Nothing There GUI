local function makeSlider(parent, labelText, minV, maxV, stepV, initV, callback, order)
    local val = initV
    local card = New("Frame", {
        Size             = UDim2.new(1, 0, 0, 54),
        BackgroundColor3 = C.Secondary,
        BorderSizePixel  = 0,
        LayoutOrder      = order or 0,
    }, parent)
    Corner(6, card)
    Stroke(C.Border, 0.5, card)

    local lbl = New("TextLabel", {
        Text                   = labelText .. ": " .. tostring(val),
        Size                   = UDim2.new(1, -10, 0, 20),
        Position               = UDim2.new(0, 10, 0, 5),
        BackgroundTransparency = 1,
        TextColor3             = C.Text,
        Font                   = Enum.Font.GothamBold,
        TextSize               = 11,
        TextXAlignment         = Enum.TextXAlignment.Left,
    }, card)

    local track = New("Frame", {
        Size             = UDim2.new(1, -20, 0, 6),
        Position         = UDim2.new(0, 10, 0, 36),
        BackgroundColor3 = Color3.fromRGB(40, 15, 15),
        BorderSizePixel  = 0,
    }, card)
    Corner(3, track)

    local initRel = (val - minV) / (maxV - minV)
    local fill = New("Frame", {
        Size             = UDim2.new(initRel, 0, 1, 0),
        BackgroundColor3 = C.Accent,
        BorderSizePixel  = 0,
    }, track)
    Corner(3, fill)

    local thumb = New("TextButton", {
        Text             = "",
        Size             = UDim2.new(0, 14, 0, 14),
        Position         = UDim2.new(initRel, -7, 0.5, -7),
        BackgroundColor3 = C.AccentBrt,
        BorderSizePixel  = 0,
    }, track)
    Corner(7, thumb)

    local sliding = false
    thumb.MouseButton1Down:Connect(function() sliding = true end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = false
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if sliding and inp.UserInputType == Enum.UserInputType.MouseMovement then
            local abs = track.AbsolutePosition
            local sz  = track.AbsoluteSize
            local rel = math.clamp((inp.Position.X - abs.X) / sz.X, 0, 1)
            val = math.round((minV + rel * (maxV - minV)) / stepV) * stepV
            fill.Size      = UDim2.new(rel, 0, 1, 0)
            thumb.Position = UDim2.new(rel, -7, 0.5, -7)
            lbl.Text       = labelText .. ": " .. tostring(val)
            callback(val)
        end
    end)

    return card
end

