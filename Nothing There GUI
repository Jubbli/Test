        sorrowOn      = false, prevSorrowEx = false,
        timerHUDOn    = false,
        ceHUDOn       = false,
        roomHUDOn     = false, roomCount = 0, lastRoomVal = nil,
        espOn         = false,
    }

    local function GR_GetHRP() return getHRP(getChar()) end
    local function GR_GetHum() return getHum(getChar()) end

    -- Lightweight entity presence check (no recursion — top-level only)
    local function GR_FindEntityFast(name)
        local direct = workspace:FindFirstChild(name)
        if direct then return direct end
        -- Check one level deeper in common folders
        for _, folder in ipairs({"Entities","NPCs","Mobs","Characters"}) do
            local f = workspace:FindFirstChild(folder)
            if f then
                local e = f:FindFirstChild(name)
                if e then return e end
            end
        end
        return nil
    end

    local function GR_GetAnchor(obj)
        if obj:IsA("Model") then
            return obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
        elseif obj:IsA("BasePart") then
            return obj
        end
        return nil
    end

    -- Update entity cache (runs every 0.5 s from master loop)
    local function GR_UpdateCache()
        local myHRP = GR_GetHRP()
        GR_State.entityCache = {}
        for _, name in ipairs(GRACE_ENTITIES) do
            local obj = GR_FindEntityFast(name)
            if obj then
                local anchor = GR_GetAnchor(obj)
                local dist = (myHRP and anchor)
                    and (anchor.Position - myHRP.Position).Magnitude
                    or math.huge
                GR_State.entityCache[name] = {obj=obj, anchor=anchor, dist=dist}
            end
        end
