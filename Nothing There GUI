        pcall(function()
            local hum = getHum(getChar())
            if hum then hum.WalkSpeed = EV_speedValue or 32 end
        end)
    end)

    makeToggle(scroll, "Infinite Stamina",
        "Prevents the stamina bar from depleting (resets it each frame)", function(on)
        EV.infStamina = on
        showToast("Evade", on and "Infinite Stamina ON" or "OFF", C.Accent)
    end, 4)

    RunService.Heartbeat:Connect(function()
        if not EV.infStamina then return end
        pcall(function()
            -- Evade stores stamina in a LocalScript value or attribute
            local char = getChar()
            if not char then return end
            local stam = char:FindFirstChild("Stamina")
