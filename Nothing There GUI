        end, 21)
        makeSlider(scroll, "Dodge Range (studs)", 5, 30, 5, 15, function(v) dodgeRange = v end, 21)
        RunService.Heartbeat:Connect(function()
            if not autoDodgeOn then return end
            pcall(function()
                local hrp = getHRP(getChar()); if not hrp then return end
                for _, v in ipairs(workspace:GetDescendants()) do
                    if v:IsA("BasePart") and v.Velocity.Magnitude > 60 then
                        local dist = (v.Position - hrp.Position).Magnitude
                        if dist < dodgeRange then
                            local side = hrp.CFrame.RightVector
                            local dir  = (hrp.Position - v.Position)
                            local dot  = dir:Dot(side)
                            hrp.AssemblyLinearVelocity = side * (dot >= 0 and 1 or -1) * 80
                            break
