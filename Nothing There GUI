-- ════════════════════════════════════════════════════════════════
-- TAB 8: FNF  (Funky Friday — correct fixed port)
-- ════════════════════════════════════════════════════════════════
--  Root bug in all previous versions: the reference script's
--  background loop does `keymap = Inner` which OVERWRITES the
--  keymap table with a Roblox Instance. Then keymap[1] through
--  keymap[9] return nil (numeric indexing on an Instance = nil),
--  so VIM:SendKeyEvent gets nil and nothing is pressed.
--
--  Fix: separate laneKeys[1..9] table for KeyCodes, never
--  overwritten. Inner frame stored in a dedicated variable.
--
--  ALSO fixed: downscroll vs upscroll threshold direction.
--  Downscroll → notes fall, Y.Scale increases → fire when > 0.4
--  Upscroll   → notes rise, Y.Scale decreases → fire when < 0.6
-- ════════════════════════════════════════════════════════════════
safeTab("FNF", function()
    local VIM        = game:GetService("VirtualInputManager")
    local RunService = game:GetService("RunService")
    local scroll     = makeScrollFrame(TabFrames["FNF"])

    -- ── State ─────────────────────────────────────────────────
    local FNF = {
        auto          = false,
        side          = nil,         -- "Left" | "Right"
        downscroll    = true,        -- true = downscroll (default)
        delay         = 0,           -- signed delay in seconds
        delayMode     = "Static",
        notesHit      = 0,
        combo         = 0,
        maxCombo      = 0,
        keybind       = Enum.KeyCode.Insert,
        humanizerOn   = false,
        missRate      = 0.03,
        jitterMax     = 0.02,
        laneLastHit   = {0,0,0,0,0,0,0,0,0},
        laneColors    = {
            Color3.fromRGB(200,60,60),  Color3.fromRGB(60,180,60),
            Color3.fromRGB(60,120,220), Color3.fromRGB(220,180,0),
            Color3.fromRGB(200,60,200), Color3.fromRGB(60,200,200),
            Color3.fromRGB(220,120,60), Color3.fromRGB(140,200,60),
            Color3.fromRGB(160,160,255),
        },
    }

    -- THE FIX: laneKeys is ONLY ever a table of KeyCodes.
    -- It is NEVER reassigned to anything else.
    -- The Inner frame lives in a completely separate variable.
    local laneKeys = {}
    for i = 1, 9 do laneKeys[i] = Enum.KeyCode.Unknown end

    -- Forward-declared UI refs
    local statusLbl, keybindBtn, botToggleBtn, downscrollBtn, upscrollBtn

    -- ── Key refresh ───────────────────────────────────────────
    -- innerFrame is the path used for reading, laneKeys stores results.
    -- These two variables are kept completely separate.
    local function refreshKeys()
        pcall(function()
            local innerFrame = Player.PlayerGui.Window.Game.Fields[FNF.side or "Left"].Inner
            for i = 1, 9 do
                pcall(function()
                    local lane  = innerFrame["Lane"..i]
                    local label = lane.Labels.Label.Text
                    local kc    = Enum.KeyCode[label.text]
                    if kc then laneKeys[i] = kc end
                end)
            end
        end)
    end

    -- ── Side detection ────────────────────────────────────────
    local function detectSide()
        pcall(function()
            local char = Player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then return end
            local minL, minR = math.huge, math.huge
            local stages = workspace:FindFirstChild("Map")
                and workspace.Map:FindFirstChild("Stages")
            if not stages then return end
            for _, stage in pairs(stages:GetChildren()) do
                pcall(function()
                    if not stage:FindFirstChild("Teams") then return end
                    local pL = stage.Teams:FindFirstChild("Left")
                    local pR = stage.Teams:FindFirstChild("Right")
                    if pL then
                        local d = (root.Position - pL.Position).Magnitude
                        if d <= 5 and d < minL then minL = d end
                    end
                    if pR then
                        local d = (root.Position - pR.Position).Magnitude
                        if d <= 5 and d < minR then minR = d end
                    end
                end)
            end
            if     minL < minR then FNF.side = "Left"
            elseif minR < minL then FNF.side = "Right" end
        end)
    end

    -- ── Try to auto-detect scroll direction from game settings ─
    local function detectScrollDir()
        pcall(function()
            -- Funky Friday stores downscroll toggle in settings
            local paths = {
                "GameGui/Windows/Configuration/Frame/Body/Content/Settings/Entries/ScrollingFrame/DownScroll/Toggle/Inner",
                "GameGui/Windows/Settings/Frame/Body/Settings/Settings/ScrollingFrame/DownScroll/Toggle/Outer/Inner",
            }
            local pg = Player.PlayerGui
            for _, p in ipairs(paths) do
                local node = pg
                for part in p:gmatch("[^/]+") do
                    node = node and node:FindFirstChild(part)
                end
                if node then
                    -- Green = enabled
                    local col = node.BackgroundColor3 or node.ImageColor3
                    if col then
                        local r,g,b = col.R*255, col.G*255, col.B*255
                        FNF.downscroll = (g > 200 and r < 150)
                        return
                    end
                end
            end
        end)
    end

    -- ── Columns setup ─────────────────────────────────────────
    local function setupColumns()
        local columns = {}
        pcall(function()
            local innerFrame = Player.PlayerGui.Window.Game.Fields[FNF.side or "Left"].Inner
            for i = 1, 9 do
                pcall(function()
                    local lane = innerFrame["Lane"..i]
                    if lane then
                        local notes = lane:FindFirstChild("Notes")
                        if notes then columns[i] = notes end
                    end
                end)
            end
        end)
        return columns
    end

    -- ── VIM send ──────────────────────────────────────────────
    local function pressLane(i)
        local kc = laneKeys[i]
        if not kc or kc == Enum.KeyCode.Unknown then return end
        if FNF.humanizerOn and math.random() < FNF.missRate then return end
        local jitter = FNF.humanizerOn and (math.random() * FNF.jitterMax) or 0
        local function fire()
            pcall(function() VIM:SendKeyEvent(true, kc, false, game) end)
            FNF.laneLastHit[i] = tick()
            FNF.notesHit += 1
            FNF.combo    += 1
            if FNF.combo > FNF.maxCombo then FNF.maxCombo = FNF.combo end
        end
        if jitter > 0 then task.delay(jitter, fire) else fire() end
    end

    local function releaseLane(i)
        local kc = laneKeys[i]
        if not kc or kc == Enum.KeyCode.Unknown then return end
        pcall(function() VIM:SendKeyEvent(false, kc, false, game) end)
        FNF.combo = 0
    end

    -- ── Main autoplay loop ────────────────────────────────────
    -- Exact reference script logic, with the keymap bug fixed.
    -- Threshold direction flips based on FNF.downscroll.
    local function getThreshold()
        -- downscroll: notes fall, receptor at bottom, fire when Y.Scale HIGH
        -- upscroll:   notes rise, receptor at top,    fire when Y.Scale LOW
        if FNF.downscroll then
            return 0.4 + 1e-9 + FNF.delay
        else
            return 0.6 - 1e-9 - FNF.delay
        end
    end

    local function noteTriggered(child, threshold)
        if not child:IsA("GuiObject") then return false end
        if FNF.downscroll then
            return child.Position.Y.Scale > threshold
        else
            return child.Position.Y.Scale < threshold
        end
    end

    local function autoplay()
        while FNF.auto do
            pcall(function()
                local columns         = setupColumns()
                local trackedChildren = {}
                local threshold       = getThreshold()

                -- Initial pass: catch notes already past threshold
                for colNum, column in pairs(columns) do
                    pcall(function()
                        trackedChildren[colNum] = {}
                        for _, child in ipairs(column:GetChildren()) do
                            pcall(function()
                                if noteTriggered(child, threshold) then
                                    trackedChildren[colNum][child] = true
                                    pressLane(colNum)
                                end
                            end)
                        end
                    end)
                end

                -- Inner heartbeat loop
                while FNF.auto do
                    pcall(function()
                        threshold = getThreshold()

                        for colNum, column in pairs(columns) do
                            pcall(function()
                                -- New notes crossing threshold
                                for _, child in ipairs(column:GetChildren()) do
                                    pcall(function()
                                        if not trackedChildren[colNum][child]
                                            and noteTriggered(child, threshold) then
                                            trackedChildren[colNum][child] = true
                                            pressLane(colNum)
                                            -- Hold-note: 2 children = tail indicator
                                            if #child:GetChildren() == 2 then
                                                coroutine.wrap(function()
                                                    pcall(function()
                                                        while child.Parent
                                                            and noteTriggered(child, threshold)
                                                            and FNF.auto do
                                                            RunService.Heartbeat:Wait()
                                                        end
                                                        releaseLane(colNum)
                                                        trackedChildren[colNum][child] = nil
                                                    end)
                                                end)()
                                            end
                                        end
                                    end)
                                end
                                -- Notes that left or passed threshold
                                for child in pairs(trackedChildren[colNum]) do
                                    pcall(function()
                                        if not child:IsDescendantOf(column)
                                            or not noteTriggered(child, threshold) then
                                            if trackedChildren[colNum][child] then
                                                releaseLane(colNum)
                                            end
                                            trackedChildren[colNum][child] = nil
                                        end
                                    end)
                                end
                            end)
                        end
                        RunService.Heartbeat:Wait()
                    end)
                end
            end)
        end
    end

