local function New(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        inst[k] = v
    end
    if parent then inst.Parent = parent end
    return inst
end

local function Corner(r, p)
    New("UICorner", {CornerRadius = UDim.new(0, r)}, p)
end

local function Stroke(col, thickness, p)
    New("UIStroke", {Color = col, Thickness = thickness}, p)
end

local function Pad(t, l, r, b, p)
    New("UIPadding", {
        PaddingTop    = UDim.new(0, t),
        PaddingLeft   = UDim.new(0, l),
        PaddingRight  = UDim.new(0, r),
        PaddingBottom = UDim.new(0, b),
    }, p)
end

local function ListLayout(spacing, p)
    New("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding   = UDim.new(0, spacing),
    }, p)
end

local function hoverBtn(btn, normal, hover)
    btn.MouseEnter:Connect(function() btn.BackgroundColor3 = hover end)
    btn.MouseLeave:Connect(function() btn.BackgroundColor3 = normal end)
end

local function getChar()
    return Player.Character
end

local function getHum(char)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getHRP(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end

