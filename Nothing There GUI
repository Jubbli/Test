    }, scroll)

    local function updateWPLabel()
        wpListLabel.Text = "Waypoints: " .. #wpList .. " saved"
    end

    makeButton(scroll, "📍  Save Current Position as Waypoint", function()
        local Player = game:GetService("Players").LocalPlayer
        local char   = Player.Character; if not char then return end
        local hrp    = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        table.insert(wpList, hrp.CFrame)
        updateWPLabel()
        NT_toast("AutoFarm", "Waypoint " .. #wpList .. " saved", C.AccentBrt)
    end, 32)

    makeButton(scroll, "🗑  Clear All Waypoints", function()
        wpList = {}
        AF.CycleOn = false
        updateWPLabel()
        NT_toast("AutoFarm", "All waypoints cleared", C.TextDim)
    end, 33)

    makeSlider(scroll, "Waypoint Travel Delay (x0.1s)", 1, 100, 1, 10, function(v)
        AF.CycleDelay = v / 10
    end, 34)

    makeToggle(scroll, "Start Waypoint Cycle",
        "Teleports through your saved waypoints on a loop",
        function(on)
        AF.CycleOn = on
        if on and #wpList > 0 then
            task.spawn(function()
                local idx = 1
                while AF.CycleOn do
                    if #wpList == 0 then task.wait(0.5); continue end
                    pcall(function()
                        local Player = game:GetService("Players").LocalPlayer
                        local char   = Player.Character; if not char then return end
                        local hrp    = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
                        hrp.CFrame   = wpList[idx]
                    end)
                    idx = (idx % #wpList) + 1
                    task.wait(AF.CycleDelay)
                end
            end)
            NT_toast("AutoFarm", "Cycling " .. #wpList .. " waypoints", C.AccentBrt)
        elseif on then
            AF.CycleOn = false
            NT_toast("AutoFarm", "No waypoints saved!", C.TextDim)
        end
    end, 35)

    makeSectionLabel(scroll, "💀 AUTO RESPAWN", 40)

    makeToggle(scroll, "Auto Respawn on Death",
        "Instantly respawns you when your Humanoid.Health reaches 0",
        function(on)
        AF.AutoRespawn = on
        if on then
            local Player = game:GetService("Players").LocalPlayer
            local function hookDeath(char)
                local hum = char:WaitForChild("Humanoid", 5)
                if not hum then return end
                hum.Died:Connect(function()
                    if AF.AutoRespawn then
                        task.wait(0.2)
                        pcall(function() Player:LoadCharacter() end)
                    end
                end)
            end
            local char = Player.Character
            if char then pcall(function() hookDeath(char) end) end
            Player.CharacterAdded:Connect(function(c)
                if AF.AutoRespawn then pcall(function() hookDeath(c) end) end
            end)
        end
        NT_toast("AutoFarm", on and "Will respawn on death" or "Off", C.AccentBrt)
    end, 41)

    makeButton(scroll, "🔄  Reset Stats Counter", function()
        AF.ClickCount   = 0
        AF.CollectCount = 0
        AF.SessionStart = os.time()
        afStartTime     = tick()
        NT_toast("AutoFarm", "Stats reset", C.TextDim)
    end, 45)

end) -- end safeTab AutoFarm

