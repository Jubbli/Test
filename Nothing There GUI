-- ════════════════════════════════════════════════════════════════
-- GUI FEATURE C: RESIZABLE MAIN FRAME
-- Eight invisible drag-strips (N S E W NE NW SE SW) sit on top of
-- the main frame's edges. Dragging any edge or corner resizes the
-- frame live. Minimum size: 500 × 380 px.
-- The handles are parented to ScreenGui (not MainFrame) so they
-- always sit above all frame content at ZIndex 999.
-- ════════════════════════════════════════════════════════════════
do
    local H         = 8      -- handle thickness in px
    local MIN_W     = 500
    local MIN_H     = 380
    local ZH        = 999    -- always on top

    -- We re-position the handles every frame to follow MainFrame
    local handleFrames = {}

    local function makeStrip()
        local f = New("Frame", {
            BackgroundColor3       = Color3.fromRGB(200, 30, 30),
            BackgroundTransparency = 0.92,
            BorderSizePixel        = 0,
            ZIndex                 = ZH,
            Size                   = UDim2.new(0, 10, 0, 10),  -- overwritten per update
        }, ScreenGui)
        return f
    end

    -- One handle per edge / corner
    -- n/s/e/w flags indicate which edges this handle adjusts
    local defs = {
        { id="N",  n=true,  s=false, e=false, w=false },
        { id="S",  n=false, s=true,  e=false, w=false },
        { id="E",  n=false, s=false, e=true,  w=false },
        { id="W",  n=false, s=false, e=false, w=true  },
        { id="NE", n=true,  s=false, e=true,  w=false },
        { id="NW", n=true,  s=false, e=false, w=true  },
        { id="SE", n=false, s=true,  e=true,  w=false },
        { id="SW", n=false, s=true,  e=false, w=true  },
    }

    for _, def in ipairs(defs) do
        local strip     = makeStrip()
        local dragging  = false
        local dragStart = nil
        local fsz, fpos = nil, nil   -- MainFrame state at drag start

        strip.InputBegan:Connect(function(inp)
            if inp.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            dragging  = true
            dragStart = inp.Position
            fsz  = MainFrame.AbsoluteSize
            fpos = MainFrame.AbsolutePosition
        end)

        strip.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)

        UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            if inp.UserInputType ~= Enum.UserInputType.MouseMovement then return end

            local dx = inp.Position.X - dragStart.X
            local dy = inp.Position.Y - dragStart.Y

            local nw = fsz.X
            local nh = fsz.Y
            local nx = fpos.X
            local ny = fpos.Y

            if def.e then
                nw = math.max(MIN_W, fsz.X + dx)
            end
            if def.s then
                nh = math.max(MIN_H, fsz.Y + dy)
            end
            if def.w then
                local ddx = math.min(dx, fsz.X - MIN_W)
                nw = fsz.X - ddx
                nx = fpos.X + ddx
            end
            if def.n then
                local ddy = math.min(dy, fsz.Y - MIN_H)
                nh = fsz.Y - ddy
                ny = fpos.Y + ddy
            end

            MainFrame.Size     = UDim2.new(0, nw, 0, nh)
            MainFrame.Position = UDim2.new(0, nx, 0, ny)
        end)

        handleFrames[def.id] = strip
    end

    -- Every frame: reposition all 8 strips to match MainFrame
    RunService.RenderStepped:Connect(function()
        if not MainFrame.Visible then return end
        local ap  = MainFrame.AbsolutePosition
        local sz  = MainFrame.AbsoluteSize
        local x, y, w, h = ap.X, ap.Y, sz.X, sz.Y

        -- N  (top edge strip, full width)
        handleFrames["N"].Size     = UDim2.new(0, w-H*2, 0, H)
        handleFrames["N"].Position = UDim2.new(0, x+H,   0, y)
        -- S  (bottom edge strip)
        handleFrames["S"].Size     = UDim2.new(0, w-H*2, 0, H)
        handleFrames["S"].Position = UDim2.new(0, x+H,   0, y+h-H)
        -- E  (right edge strip)
        handleFrames["E"].Size     = UDim2.new(0, H, 0, h-H*2)
        handleFrames["E"].Position = UDim2.new(0, x+w-H, 0, y+H)
        -- W  (left edge strip)
        handleFrames["W"].Size     = UDim2.new(0, H, 0, h-H*2)
        handleFrames["W"].Position = UDim2.new(0, x,     0, y+H)
        -- corners (H×H squares)
        handleFrames["NE"].Size     = UDim2.new(0, H, 0, H)
        handleFrames["NE"].Position = UDim2.new(0, x+w-H, 0, y)
        handleFrames["NW"].Size     = UDim2.new(0, H, 0, H)
        handleFrames["NW"].Position = UDim2.new(0, x,     0, y)
        handleFrames["SE"].Size     = UDim2.new(0, H, 0, H)
        handleFrames["SE"].Position = UDim2.new(0, x+w-H, 0, y+h-H)
        handleFrames["SW"].Size     = UDim2.new(0, H, 0, H)
        handleFrames["SW"].Position = UDim2.new(0, x,     0, y+h-H)
    end)
end

-- ════════════════════════════════════════════════════════════════
-- KEY SYSTEM
-- Horizontal window gating access to the main GUI.
-- Answers: TSO  |  TheSilentOrchestra  (case-insensitive)
-- Wrong  : shake + "Invalid Code" + red border flash
-- Correct: smooth grow resize → fade → main GUI appears
-- Feature: Hint button after 3 wrong guesses
-- ════════════════════════════════════════════════════════════════
do
    -- 2-hour session memory using _G so it survives re-execution within the same session
    local SESSION_DURATION = 7200  -- 2 hours in seconds
    if _G.NTG_KeyUnlocked and _G.NTG_KeyTime and (os.time() - _G.NTG_KeyTime) < SESSION_DURATION then
        -- Already unlocked this session — skip the key GUI entirely
        MainFrame.Visible = true
        task.defer(function()
            local ciy = PlayerGui:FindFirstChild("CustomIY_Gui")
            if ciy then ciy.Enabled = true end
        end)
    else
        -- Hide main GUI until key entered
        MainFrame.Visible = false
        _G.NTG_KeyUnlocked = false

    local VALID = { tso=true, thesilentorchestra=true }
    local wrongCount = 0

    -- Constants
    local KW, KH       = 560, 210
    local KW_MINI       = 200
    local KH_MINI       = 32
    local KW_FULL, KH_FULL = 680, 260

    local keyGui = New("ScreenGui", {
        Name="KeySystem", ResetOnSpawn=false,
        ZIndexBehavior=Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset=true, DisplayOrder=9999,
    }, PlayerGui)

    local origPos  = UDim2.new(0.5, -KW/2, 0.5, -KH/2)

    local keyFrame = New("Frame", {
        Size             = UDim2.new(0, KW, 0, KH),
        Position         = origPos,
        BackgroundColor3 = Color3.fromRGB(12, 6, 6),
        BackgroundTransparency = 0,
        BorderSizePixel  = 0,
        ClipsDescendants = true,
        ZIndex           = 200,
    }, keyGui)
    Corner(10, keyFrame)
    local keyStroke = Instance.new("UIStroke", keyFrame)
    keyStroke.Thickness = 1.5
    keyStroke.Color     = C.Accent

    -- ── Top bar ─────────────────────────────────────────────
    local topBar = New("Frame", {
        Size=UDim2.new(1,0,0,30), Position=UDim2.new(0,0,0,0),
        BackgroundTransparency=1, BorderSizePixel=0, ZIndex=205,
    }, keyFrame)

    New("TextLabel", {
        Text="NOTHING THERE  //  ACCESS REQUIRED  —  session lasts 2 hrs",
        Size=UDim2.new(1,-96,1,0), Position=UDim2.new(0,10,0,0),
        BackgroundTransparency=1, TextColor3=C.TextDim,
        Font=Enum.Font.Code, TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=206,
    }, topBar)

    -- Window control buttons
    local function makeTinyBtn(lbl, xOff, col)
        local b = New("TextButton",{
            Text=lbl, Size=UDim2.new(0,22,0,22),
            Position=UDim2.new(1,xOff,0,4),
            BackgroundColor3=col, TextColor3=Color3.new(1,1,1),
            Font=Enum.Font.GothamBold, TextSize=11,
            BorderSizePixel=0, ZIndex=210,
        }, topBar); Corner(4,b); return b
    end

    local closeBtn = makeTinyBtn("×", -28,  Color3.fromRGB(180,50,50))
    local fsBtn    = makeTinyBtn("□", -54,  Color3.fromRGB(50,120,50))
    local minBtn   = makeTinyBtn("─", -80,  Color3.fromRGB(120,90,30))

    -- ── Body (hidden when minimized) ─────────────────────────
    local bodyFrame = New("Frame", {
        Size=UDim2.new(1,0,1,-32), Position=UDim2.new(0,0,0,32),
        BackgroundTransparency=1, BorderSizePixel=0, ZIndex=201,
    }, keyFrame)

    -- LEFT: dark input panel ────────────────────────────────
    local inputBg = New("Frame", {
        Size=UDim2.new(0.44,-10,1,-12), Position=UDim2.new(0,8,0,6),
        BackgroundColor3=Color3.fromRGB(18,10,10),
        BorderSizePixel=0, ZIndex=202,
    }, bodyFrame); Corner(6,inputBg); Stroke(C.Accent,0.8,inputBg)

    New("TextLabel",{
        Text="ENTER KEY", Size=UDim2.new(1,-12,0,16),
        Position=UDim2.new(0,6,0,6),
        BackgroundTransparency=1, TextColor3=C.TextDim,
        Font=Enum.Font.Code, TextSize=9,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=203,
    }, inputBg)

    local keyInput = New("TextBox",{
        Text="", PlaceholderText="Type answer here...",
        Size=UDim2.new(1,-12,0,32), Position=UDim2.new(0,6,0,26),
        BackgroundColor3=Color3.fromRGB(8,4,4),
        TextColor3=Color3.fromRGB(255,255,255),
        PlaceholderColor3=Color3.fromRGB(80,50,50),
        Font=Enum.Font.Code, TextSize=13,
        TextXAlignment=Enum.TextXAlignment.Left,
        ClearTextOnFocus=false, BorderSizePixel=0, ZIndex=203,
    }, inputBg); Corner(4,keyInput)

    local feedbackLbl = New("TextLabel",{
        Text="", Size=UDim2.new(1,-12,0,20),
        Position=UDim2.new(0,6,0,62),
        BackgroundTransparency=1,
        TextColor3=Color3.fromRGB(255,80,80),
        Font=Enum.Font.GothamBold, TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=203,
    }, inputBg)

    local submitBtn = New("TextButton",{
        Text="Submit", Size=UDim2.new(1,-12,0,30),
        Position=UDim2.new(0,6,1,-38),
        BackgroundColor3=C.Accent, TextColor3=Color3.new(1,1,1),
        Font=Enum.Font.GothamBold, TextSize=12,
        BorderSizePixel=0, ZIndex=203,
    }, inputBg); Corner(5,submitBtn)

    -- RIGHT: info panel ─────────────────────────────────────
    local infoBg = New("Frame",{
        Size=UDim2.new(0.56,-10,1,-12), Position=UDim2.new(0.44,4,0,6),
        BackgroundTransparency=1, BorderSizePixel=0, ZIndex=202,
    }, bodyFrame)

    New("TextLabel",{
        Text="NOTHING THERE GUI  ·  KEY SYSTEM",
        Size=UDim2.new(1,0,0,16), Position=UDim2.new(0,6,0,0),
        BackgroundTransparency=1, TextColor3=C.Accent,
        Font=Enum.Font.Code, TextSize=9,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=203,
    }, infoBg)

    New("TextLabel",{
        Text="Session valid for 2 hours.\nAfter that, re-entry is required.",
        Size=UDim2.new(1,-4,0,22), Position=UDim2.new(0,6,0,18),
        BackgroundTransparency=1, TextColor3=Color3.fromRGB(140,100,100),
        Font=Enum.Font.Code, TextSize=8, TextWrapped=true,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=203,
    }, infoBg)

    New("TextLabel",{
        Text="What is the Second Best\nAbnormality in Lobotomy\nCorporation?",
        Size=UDim2.new(1,-8,0,58), Position=UDim2.new(0,6,0,20),
        BackgroundTransparency=1,
        TextColor3=Color3.fromRGB(200,170,170),
        Font=Enum.Font.GothamBold, TextSize=13,
        TextXAlignment=Enum.TextXAlignment.Left,
        TextWrapped=true, ZIndex=203,
    }, infoBg)

    New("TextLabel",{
        Text="There are 4 possible answers.",
        Size=UDim2.new(1,-8,0,14), Position=UDim2.new(0,6,0,82),
        BackgroundTransparency=1, TextColor3=C.TextDim,
        Font=Enum.Font.Code, TextSize=9,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=203,
    }, infoBg)

    -- Hint button (unlocks after 3 wrong)
    local hintBtn = New("TextButton",{
        Text="Need a hint?", Size=UDim2.new(0,100,0,22),
        Position=UDim2.new(0,6,0,100),
        BackgroundColor3=Color3.fromRGB(40,25,25),
        TextColor3=C.TextDim, Font=Enum.Font.Gotham,
        TextSize=9, BorderSizePixel=0, Visible=false, ZIndex=203,
    }, infoBg); Corner(4,hintBtn)

    local hintUsed = false
    hintBtn.MouseButton1Click:Connect(function()
        if hintUsed then return end
        hintUsed = true
        feedbackLbl.Text = "Hint: think Orchestral..."
        feedbackLbl.TextColor3 = Color3.fromRGB(200,160,60)
        hintBtn.Text = "♪ Think Orchestra"
    end)

    -- ── State ────────────────────────────────────────────────
    local minimized    = false
    local fullscreened = false

    -- ── Shake ────────────────────────────────────────────────
    local function shakeKey()
        local base = keyFrame.Position
        local ox   = base.X.Offset
        local oy   = base.Y.Offset
        for _, dx in ipairs({9,-9,7,-7,5,-5,3,-3,0}) do
            keyFrame.Position = UDim2.new(base.X.Scale, ox+dx, base.Y.Scale, oy)
            task.wait(0.03)
        end
        keyFrame.Position = base
    end

    -- ── Key check ────────────────────────────────────────────
    local function checkKey()
        local raw     = keyInput.Text:lower():gsub("%s+","")
        if VALID[raw] then
            -- Correct
            feedbackLbl.Text       = "✓  Access Granted"
            feedbackLbl.TextColor3 = Color3.fromRGB(60,220,80)
            keyInput.Text          = ""
            -- Expand toward main GUI size then fade
            TweenService:Create(keyFrame,
                TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                {Size     = UDim2.new(0,680,0,470),
                 Position = UDim2.new(0.5,-340,0.5,-235)}
            ):Play()
            task.wait(0.5)
            TweenService:Create(keyFrame,
                TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                {BackgroundTransparency=1}
            ):Play()
            task.wait(0.28)
            _G.NTG_KeyUnlocked = true
            _G.NTG_KeyTime     = os.time()
            keyGui.Enabled     = false
            MainFrame.Visible  = true
            -- Reveal the Custom IY mini bar now that access is granted
            local ciy = PlayerGui:FindFirstChild("CustomIY_Gui")
            if ciy then ciy.Enabled = true end
        else
            -- Wrong
            wrongCount = wrongCount + 1
            feedbackLbl.Text       = "Invalid Code"
            feedbackLbl.TextColor3 = Color3.fromRGB(255,60,60)
            keyInput.Text          = ""
            -- Flash border red
            keyStroke.Color = Color3.fromRGB(255,40,40)
            TweenService:Create(keyStroke,
                TweenInfo.new(0.6), {Color=C.Accent}):Play()
            task.spawn(shakeKey)
            if wrongCount >= 3 then
                hintBtn.Visible = true
            end
        end
    end

    submitBtn.MouseButton1Click:Connect(checkKey)
    keyInput.FocusLost:Connect(function(enter) if enter then checkKey() end end)

    -- ── Window controls ──────────────────────────────────────
    closeBtn.MouseButton1Click:Connect(function()
        keyGui.Enabled    = false
        -- If they close the key GUI, just show the main frame anyway
        -- (soft bypass — remove this line to enforce the key system strictly)
        -- MainFrame.Visible = true
    end)

    minBtn.MouseButton1Click:Connect(function()
        minimized    = not minimized
        fullscreened = false
        bodyFrame.Visible = not minimized
        TweenService:Create(keyFrame, TweenInfo.new(0.22, Enum.EasingStyle.Quad),
            {Size = minimized
                and UDim2.new(0,KW_MINI,0,KH_MINI)
                or  UDim2.new(0,KW,0,KH)}
        ):Play()
    end)

    fsBtn.MouseButton1Click:Connect(function()
        fullscreened = not fullscreened
        minimized    = false
        bodyFrame.Visible = true
        TweenService:Create(keyFrame,
            TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            {Size     = fullscreened and UDim2.new(0,KW_FULL,0,KH_FULL)
                                     or  UDim2.new(0,KW,0,KH),
             Position = fullscreened and UDim2.new(0.5,-KW_FULL/2,0.5,-KH_FULL/2)
                                     or  origPos}
        ):Play()
    end)

    -- ── Draggable ────────────────────────────────────────────
    local kDragging, kDragStart, kStartPos = false, nil, nil
    keyFrame.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            kDragging  = true
            kDragStart = inp.Position
            kStartPos  = keyFrame.Position
        end
    end)
    keyFrame.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            kDragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if not kDragging then return end
        if inp.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local d = inp.Position - kDragStart
        keyFrame.Position = UDim2.new(
            kStartPos.X.Scale, kStartPos.X.Offset + d.X,
            kStartPos.Y.Scale, kStartPos.Y.Offset + d.Y
        )
    end)

    -- Entrance animation
    keyFrame.Position = UDim2.new(0.5, -KW/2, -0.15, 0)
    TweenService:Create(keyFrame,
        TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Position = origPos}
    ):Play()
    end -- closes else block
end -- closes key system do block

-- ════════════════════════════════════════════════════════════════
-- WIRE OVERLAY TOGGLES INTO SETTINGS (deferred so tab exists)
-- ════════════════════════════════════════════════════════════════
task.defer(function()
    local crossGui   = _G.NTG_CrosshairGui
    local crossParts = _G.NTG_CrosshairParts
    local fpsGui     = _G.NTG_FPSGui
    if not crossGui or not fpsGui then return end

    local settingsFrame  = TabFrames and TabFrames["Settings"]
    if not settingsFrame then return end
    local settingsScroll = settingsFrame:FindFirstChildOfClass("ScrollingFrame")
    if not settingsScroll then return end

    makeSectionLabel(settingsScroll, "OVERLAY FEATURES", 90)

    makeToggle(settingsScroll, "Show Crosshair Overlay",
        "Renders a small white crosshair at screen centre",
        function(on) crossGui.Enabled = on end, 91)

    makeSlider(settingsScroll, "Crosshair Size", 4, 30, 1, 14, function(v)
        if crossParts then
            crossParts.h.Size = UDim2.new(0,v,0,2)
            crossParts.v.Size = UDim2.new(0,2,0,v)
        end
    end, 92)

    makeToggle(settingsScroll, "Show FPS Counter",
        "Bottom-right FPS — green≥55, yellow≥30, red<30",
        function(on) fpsGui.Enabled = on end, 93)
end)

