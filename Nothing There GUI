    -- Build command rows
    local cmdButtons = {}

    local function buildCmdList(filter)
        -- Clear existing
        for _, c in ipairs(ciyScroll:GetChildren()) do
            if c:IsA("Frame") or c:IsA("TextButton") then c:Destroy() end
        end
        local lastCat = ""
        for _, cmd in ipairs(CIY_COMMANDS) do
            local show = filter == "" or
                cmd.name:lower():find(filter:lower()) or
                cmd.cat:lower():find(filter:lower())
            if not show then continue end

            -- Category separator
            if cmd.cat ~= lastCat then
                lastCat = cmd.cat
                local catLbl = New("TextLabel",{
                    Text="  -- "..cmd.cat.." --",
                    Size=UDim2.new(1,0,0,18),
                    BackgroundColor3=Color3.fromRGB(28,10,10),
                    TextColor3=C.Accent, Font=Enum.Font.GothamBold,
                    TextSize=9, TextXAlignment=Enum.TextXAlignment.Left,
                    BorderSizePixel=0,
                }, ciyScroll)
            end

            local row = New("Frame",{
                Size=UDim2.new(1,0,0,34), BackgroundColor3=C.Secondary, BorderSizePixel=0,
            }, ciyScroll); Corner(4, row)

            New("TextLabel",{
                Text=cmd.name, Size=UDim2.new(1,-70,0,18),
                Position=UDim2.new(0,8,0,2), BackgroundTransparency=1,
                TextColor3=C.Text, Font=Enum.Font.GothamBold,
                TextSize=11, TextXAlignment=Enum.TextXAlignment.Left,
            }, row)
            New("TextLabel",{
                Text=cmd.desc, Size=UDim2.new(1,-70,0,13),
                Position=UDim2.new(0,8,0,20), BackgroundTransparency=1,
                TextColor3=C.TextDim, Font=Enum.Font.Code,
                TextSize=8, TextXAlignment=Enum.TextXAlignment.Left,
            }, row)

            local execBtn = New("TextButton",{
                Text="RUN", Size=UDim2.new(0,52,0,22),
                Position=UDim2.new(1,-58,0,6),
                BackgroundColor3=C.Accent, TextColor3=Color3.new(1,1,1),
                Font=Enum.Font.GothamBold, TextSize=10, BorderSizePixel=0,
            }, row); Corner(4, execBtn)

            local capturedCmd = cmd
            execBtn.MouseButton1Click:Connect(function()
                local ok, err = pcall(capturedCmd.run)
                if not ok then ciyLog("Error: "..tostring(err):sub(1,50)) end
            end)
        end
    end

    buildCmdList("")

