safeTab("DrawMe", function()
    local scroll = makeScrollFrame(TabFrames["DrawMe"])

    local DM = {
        Drawing    = false,
        Speed      = 0.03,
        PixelSkip  = 3,
        ColorQuant = 32,
        CanvasX    = 0, CanvasY = 0,
        CanvasW    = 500, CanvasH = 400,
        Image      = nil,   -- {w,h,pixels={r,g,b,...}} or {stamp=true}
        AntiAFK    = false,
        CountDown  = 3,
    }

    local function _move(x,y)
        if mousemoveto   then pcall(mousemoveto,x,y)
        elseif mouse_move then pcall(mouse_move,x,y) end
    end
    local function _press()
        if mouse1press   then pcall(mouse1press)
        elseif mouse_down then pcall(mouse_down,1) end
    end
    local function _release()
        if mouse1release  then pcall(mouse1release)
        elseif mouse_up   then pcall(mouse_up,1) end
    end
    local function _click(x,y,delay)
        _move(x,y); task.wait(delay or DM.Speed)
        _press(); task.wait(0.01); _release()
    end
    local function _drag(x1,y1,x2,y2,steps)
        steps = steps or 30
        _move(x1,y1); task.wait(0.02); _press()
        for i=0,steps do
            _move(x1+(x2-x1)*(i/steps), y1+(y2-y1)*(i/steps))
