local function New(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        inst[k] = v
    end
    if parent then inst.Parent = parent end
    return inst
end

local function Corner(r, p)
    New("UICorner", {CornerRadius = UDim.new(0, r)}, p)
end

local function Stroke(col, thickness, p)
    New("UIStroke", {Color = col, Thickness = thickness}, p)
end

local function Pad(t, l, r, b, p)
    New("UIPadding", {
        PaddingTop    = UDim.new(0, t),
        PaddingLeft   = UDim.new(0, l),
        PaddingRight  = UDim.new(0, r),
        PaddingBottom = UDim.new(0, b),
    }, p)
end

local function ListLayout(spacing, p)
    New("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding   = UDim.new(0, spacing),
    }, p)
end

local function hoverBtn(btn, normal, hover)
    btn.MouseEnter:Connect(function() btn.BackgroundColor3 = hover end)
    btn.MouseLeave:Connect(function() btn.BackgroundColor3 = normal end)
end

-- ════════════════════════════════════════════════════════════════
-- TOAST NOTIFICATION SYSTEM  (v2 — always visible)
-- Each toast is a standalone Frame directly inside a dedicated
-- ScreenGui.  NO UIListLayout (that was overriding Position tweens).
-- Toasts pop in from the right edge, stack upward, auto-dismiss
-- after 3 seconds with a draining progress bar.
-- ════════════════════════════════════════════════════════════════
local TOAST_W   = 250
local TOAST_H   = 52
local TOAST_GAP = 6
local TOAST_MAX = 5

-- Dedicated ScreenGui so toasts always render above everything
local toastScreenGui = Instance.new("ScreenGui")
toastScreenGui.Name           = "NTG_Toasts"
toastScreenGui.ResetOnSpawn   = false
toastScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
toastScreenGui.DisplayOrder   = 99999
toastScreenGui.IgnoreGuiInset = true
toastScreenGui.Parent         = PlayerGui

local activeToasts = {}   -- list of live toast frames (bottom to top)

local function repositionToasts()
    -- Stack from bottom-right corner upward
    local bottomY = -10
    for idx, t in ipairs(activeToasts) do
        local targetY = bottomY - (TOAST_H * idx) - (TOAST_GAP * (idx - 1))
        TweenService:Create(t,
            TweenInfo.new(0.15, Enum.EasingStyle.Quad),
            {Position = UDim2.new(1, -(TOAST_W + 10), 1, targetY)}
        ):Play()
    end
end

local function showToast(title, body, accentColor)
    accentColor = accentColor or C.Accent

    -- Cap active toasts
    if #activeToasts >= TOAST_MAX then
        local oldest = activeToasts[1]
        table.remove(activeToasts, 1)
        oldest:Destroy()
        repositionToasts()
    end

    -- Calculate initial Y for this toast (below screen)
    local slotIdx = #activeToasts + 1
    local targetY  = -10 - (TOAST_H * slotIdx) - (TOAST_GAP * (slotIdx - 1))

    local toast = Instance.new("Frame")
    toast.Name                   = "Toast_"..tostring(tick())
    toast.Size                   = UDim2.new(0, TOAST_W, 0, TOAST_H)
    toast.Position               = UDim2.new(1, 10, 1, targetY) -- start OFF-SCREEN RIGHT
    toast.BackgroundColor3       = Color3.fromRGB(14, 7, 7)
    toast.BackgroundTransparency = 0
    toast.BorderSizePixel        = 0
    toast.ZIndex                 = 100
    toast.Parent                 = toastScreenGui

    local corner = Instance.new("UICorner", toast)
    corner.CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke", toast)
    stroke.Thickness = 1
    stroke.Color     = accentColor

    -- Left accent bar
    local bar = Instance.new("Frame", toast)
    bar.Size             = UDim2.new(0, 3, 1, -10)
    bar.Position         = UDim2.new(0, 5, 0, 5)
    bar.BackgroundColor3 = accentColor
    bar.BorderSizePixel  = 0
    local bc = Instance.new("UICorner", bar); bc.CornerRadius = UDim.new(0, 2)

    -- Title label
    local titleLbl = Instance.new("TextLabel", toast)
    titleLbl.Text                   = title
    titleLbl.Size                   = UDim2.new(1, -20, 0, 20)
    titleLbl.Position               = UDim2.new(0, 15, 0, 4)
    titleLbl.BackgroundTransparency = 1
    titleLbl.TextColor3             = accentColor
    titleLbl.Font                   = Enum.Font.GothamBold
    titleLbl.TextSize               = 12
    titleLbl.TextXAlignment         = Enum.TextXAlignment.Left
    titleLbl.ZIndex                 = 101

    -- Body label
    local bodyLbl = Instance.new("TextLabel", toast)
    bodyLbl.Text                   = body
    bodyLbl.Size                   = UDim2.new(1, -20, 0, 16)
    bodyLbl.Position               = UDim2.new(0, 15, 0, 25)
    bodyLbl.BackgroundTransparency = 1
    bodyLbl.TextColor3             = Color3.fromRGB(160, 130, 130)
    bodyLbl.Font                   = Enum.Font.Code
    bodyLbl.TextSize               = 10
    bodyLbl.TextXAlignment         = Enum.TextXAlignment.Left
    bodyLbl.ZIndex                 = 101

    -- Progress bar bg
    local progBg = Instance.new("Frame", toast)
    progBg.Size             = UDim2.new(1, -10, 0, 2)
    progBg.Position         = UDim2.new(0, 5, 1, -4)
    progBg.BackgroundColor3 = Color3.fromRGB(35, 15, 15)
    progBg.BorderSizePixel  = 0
    local pc = Instance.new("UICorner", progBg); pc.CornerRadius = UDim.new(0, 1)

    local progFill = Instance.new("Frame", progBg)
    progFill.Size             = UDim2.new(1, 0, 1, 0)
    progFill.BackgroundColor3 = accentColor
    progFill.BorderSizePixel  = 0
    local pfc = Instance.new("UICorner", progFill); pfc.CornerRadius = UDim.new(0, 1)

    table.insert(activeToasts, toast)

    -- Slide IN from right to target position
    TweenService:Create(toast,
        TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Position = UDim2.new(1, -(TOAST_W + 10), 1, targetY)}
    ):Play()

    -- Drain progress bar over 3s
    TweenService:Create(progFill,
        TweenInfo.new(3, Enum.EasingStyle.Linear),
        {Size = UDim2.new(0, 0, 1, 0)}
    ):Play()

    -- Auto-dismiss after 3s
    task.delay(3, function()
        -- Remove from active list
        for i, t in ipairs(activeToasts) do
            if t == toast then table.remove(activeToasts, i); break end
        end
        -- Slide OUT to the right
        TweenService:Create(toast,
            TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {Position = UDim2.new(1, 10, 1, targetY)}
        ):Play()
        task.wait(0.25)
        toast:Destroy()
        repositionToasts()
    end)
end

