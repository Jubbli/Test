            b.BackgroundColor3 = (n == tname) and C.TabActive   or C.TabInactive
            b.TextColor3       = (n == tname) and C.AccentBrt   or C.TextDim
        end
        S.ActiveTab = tname
    end)
end

local function showTab(name)
    for n, f in pairs(TabFrames) do f.Visible = (n == name) end
    for n, b in pairs(TabBtns) do
        b.BackgroundColor3 = (n == name) and C.TabActive or C.TabInactive
        b.TextColor3       = (n == name) and C.AccentBrt or C.TextDim
    end
    S.ActiveTab = name
end

